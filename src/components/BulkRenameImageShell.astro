---
import type { ImageToolDefinition } from '../platform/image-tools/types';
import ImageBatchShell from '../image-tools/components/ImageBatchShell.astro';
import ImageBatchDropzone from '../image-tools/components/ImageBatchDropzone.astro';
import ImageEditScopeSwitch from '../image-tools/components/ImageEditScopeSwitch.astro';
import ImageBatchProgress from '../image-tools/components/ImageBatchProgress.astro';
import ImageBatchActionBar from '../image-tools/components/ImageBatchActionBar.astro';
import ImageToolBatchHeader from '../image-tools/components/ImageToolBatchHeader.astro';
interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const accept = tool.acceptedExtensions.map((extension) => `.${extension}`).join(',');
const maxFiles = tool.maxFiles ?? 50;
const maxFileMb = Math.max(1, Math.round(tool.maxFileBytes / (1024 * 1024)));
---
<div class="image-editor-card gemini-batch-card rename-tool" data-image-tool-app data-tool-id={tool.id} data-max-file-bytes={tool.maxFileBytes} data-max-files={maxFiles} data-has-items="false">
  <div class="image-editor-topbar"><div><span>Local image tool</span><strong>{tool.displayName}</strong></div><div class="image-editor-local-state"><span aria-hidden="true"></span>Bytes unchanged</div></div>
  <div class="image-editor-notice" data-role="notice" role="status" aria-live="polite" hidden></div>
  <ImageBatchShell>
    <Fragment slot="header"><ImageToolBatchHeader countSuffix="images" statusText="One filename pattern applies to the batch." statusRole="mode-summary" /></Fragment>
    <div slot="upload"><ImageBatchDropzone accept={accept} maxFiles={maxFiles} maxFileMb={maxFileMb} /></div>
    <ImageEditScopeSwitch slot="scope" mode="shared" label="Naming behavior" title="Choose how filenames apply" sharedLabel="Apply to all" sharedHint="One pattern for the batch" individualLabel="Edit individually" individualHint="Per-image names" />
    <div slot="queue" class="rename-queue" data-role="batch-list" aria-label="Batch images"></div>
    <div slot="workspace" class="rename-workspace">
      <section class="rename-settings">
        <div><span>Shared pattern</span><strong>Build the batch filenames</strong></div>
        <div class="rename-grid">
          <label><span>Pattern</span><input data-role="pattern" value="image-{number}" maxlength="120" /><small>Tokens: {`{name}`} {`{number}`} {`{ext}`}</small></label>
          <label><span>Start number</span><input data-role="start-number" type="number" min="0" max="999999" value="1" /></label>
          <label><span>Number padding</span><input data-role="padding" type="number" min="1" max="8" value="3" /></label>
        </div>
        <label class="rename-custom" data-role="custom-name-wrap" hidden><span>Custom filename for selected image</span><input data-role="custom-name" maxlength="180" placeholder="Leave blank to use the shared pattern" /><small>The original extension is kept unless you include a supported extension.</small></label>
      </section>
      <section class="rename-preview"><div><span>Rename preview</span><strong data-role="selected-original">Select an image</strong></div><div class="rename-arrow">→</div><strong data-role="selected-result">New filename appears here</strong></section>
    </div>
    <ImageBatchProgress slot="progress" total={0} cancellable={false} />
    <ImageBatchActionBar slot="actions" processLabel="Prepare renamed files" downloadLabel="Download renamed files" />
  </ImageBatchShell>
  <p class="image-tool-policy-note">{tool.policyNote}</p>
</div>
<script src="../client/image-tool-app.ts"></script>
<style is:global>
.rename-tool>.image-batch-shell{padding:0 14px 14px}.rename-workspace{display:grid;gap:10px}.rename-settings{display:grid;gap:12px}.rename-settings>div:first-child{display:grid;gap:2px}.rename-grid{display:grid;grid-template-columns:minmax(220px,2fr) repeat(2,minmax(120px,1fr));gap:10px}.rename-grid label,.rename-custom{display:grid;gap:6px}.rename-grid input,.rename-custom input{width:100%;box-sizing:border-box;min-height:38px;padding:7px 9px}.rename-grid small,.rename-custom small{font-size:10px;color:#858fa0}.rename-preview{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:12px;align-items:center;padding:11px 12px;border:1px solid #2b3240;border-radius:13px;background:#10151e}.rename-preview>div:first-child{display:grid;gap:3px}.rename-preview span{color:#8e95a5;font-size:10.5px;font-weight:650;letter-spacing:.035em;text-transform:uppercase}.rename-preview strong{overflow-wrap:anywhere}.rename-arrow{font-size:22px;color:#7c73ff}.rename-tool[data-has-items="false"] .image-batch-shell__scope,.rename-tool[data-has-items="false"] .image-batch-shell__workspace,.rename-tool[data-has-items="false"] .image-batch-shell__progress,.rename-tool[data-has-items="false"] .image-batch-shell__actions,.rename-tool[data-has-items="false"] .image-batch-shell__header{display:none}.rename-tool[data-has-items="true"] .image-batch-shell__upload{display:none}@media(max-width:760px){.rename-grid{grid-template-columns:1fr}.rename-preview{grid-template-columns:1fr}.rename-arrow{transform:rotate(90deg);justify-self:start}}
</style>
