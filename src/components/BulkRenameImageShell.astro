---
import type { ImageToolDefinition } from '../platform/image-tools/types';
import ImageBatchShell from '../image-tools/components/ImageBatchShell.astro';
import ImageBatchDropzone from '../image-tools/components/ImageBatchDropzone.astro';
import ImageEditScopeSwitch from '../image-tools/components/ImageEditScopeSwitch.astro';
import ImageBatchProgress from '../image-tools/components/ImageBatchProgress.astro';
import ImageBatchActionBar from '../image-tools/components/ImageBatchActionBar.astro';
import ImageToolHeaderActions from '../image-tools/components/ImageToolHeaderActions.astro';
interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const accept = tool.acceptedExtensions.map((extension) => `.${extension}`).join(',');
const maxFiles = tool.maxFiles ?? 50;
---
<div class="image-editor-card rename-tool" data-image-tool-app data-tool-id={tool.id} data-max-file-bytes={tool.maxFileBytes} data-max-files={maxFiles} data-has-items="false">
  <div class="image-editor-topbar"><div><span>Local image tool</span><strong>{tool.displayName}</strong></div><div class="image-editor-local-state"><span aria-hidden="true"></span>Bytes unchanged</div></div>
  <div class="image-editor-notice" data-role="notice" role="status" aria-live="polite" hidden></div>
  <ImageBatchShell>
    <div slot="header" class="rename-header"><div><span>Images</span><strong><span data-role="batch-count">0</span> images</strong><small data-role="mode-summary">One filename pattern applies to the batch.</small></div><ImageToolHeaderActions /></div>
    <div slot="upload"><ImageBatchDropzone accept={accept} maxFiles={maxFiles} /></div>
    <ImageEditScopeSwitch slot="scope" mode="shared" />
    <div slot="queue" class="rename-queue" data-role="batch-list"></div>
    <div slot="workspace" class="rename-workspace">
      <section class="rename-settings">
        <div><span>Shared pattern</span><strong>Build the batch filenames</strong></div>
        <div class="rename-grid">
          <label><span>Pattern</span><input data-role="pattern" value="image-{number}" maxlength="120" /><small>Tokens: {`{name}`} {`{number}`} {`{ext}`}</small></label>
          <label><span>Start number</span><input data-role="start-number" type="number" min="0" max="999999" value="1" /></label>
          <label><span>Number padding</span><input data-role="padding" type="number" min="1" max="8" value="3" /></label>
        </div>
        <label class="rename-custom" data-role="custom-name-wrap" hidden><span>Custom filename for selected image</span><input data-role="custom-name" maxlength="180" placeholder="Leave blank to use the shared pattern" /><small>The original extension is always preserved. Renaming never converts image bytes.</small></label>
      </section>
      <section class="rename-preview"><div><span>Rename preview</span><strong data-role="selected-original">Select an image</strong></div><div class="rename-arrow">→</div><strong data-role="selected-result">New filename appears here</strong></section>
    </div>
    <ImageBatchProgress slot="progress" total={0} cancellable={false} />
    <ImageBatchActionBar slot="actions" processLabel="Prepare renamed files" downloadLabel="Download renamed files" />
  </ImageBatchShell>
  <p class="image-tool-policy-note">{tool.policyNote}</p>
</div>
<script src="../client/image-tool-app.ts"></script>
<style is:global>
.rename-tool{padding:18px}.rename-header{display:flex;justify-content:space-between;gap:14px;align-items:center}.rename-header>div:first-child{display:grid;gap:2px}.rename-header span,.rename-settings span,.rename-preview span{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#929bad}.rename-queue{display:grid;gap:8px}.rename-card{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:9px;align-items:center;padding:8px;border:1px solid #303744;border-radius:10px;background:#11161f;cursor:pointer}.rename-card.is-active{border-color:#7c73ff}.rename-card img{width:48px;height:48px;object-fit:cover;border-radius:7px}.rename-card__copy{display:grid;gap:2px;min-width:0}.rename-card__copy strong,.rename-card__copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rename-card__copy small{color:#8e97a7}.rename-badge{font-size:9px;border:1px solid #4a5364;border-radius:99px;padding:2px 5px;color:#aeb6c4}.rename-badge.custom{border-color:#766ef0;color:#c5c0ff}.rename-remove{border:0;background:transparent;color:#8992a3;font-size:18px}.rename-workspace{display:grid;gap:14px}.rename-settings{display:grid;gap:12px;padding:14px;border:1px solid #303744;border-radius:12px;background:#10151e}.rename-settings>div:first-child{display:grid;gap:2px}.rename-grid{display:grid;grid-template-columns:minmax(220px,2fr) repeat(2,minmax(120px,1fr));gap:10px}.rename-grid label,.rename-custom{display:grid;gap:6px}.rename-grid input,.rename-custom input{width:100%;box-sizing:border-box;min-height:38px;border:1px solid #363f50;border-radius:8px;background:#0c1118;color:#eef1f6;padding:7px 9px}.rename-grid small,.rename-custom small{font-size:10px;color:#858fa0}.rename-preview{display:grid;grid-template-columns:minmax(0,1fr) 28px minmax(0,1fr);gap:12px;align-items:center;padding:14px;border:1px solid #303744;border-radius:12px}.rename-preview>div:first-child{display:grid;gap:3px;min-width:0}.rename-preview strong{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rename-arrow{display:grid;place-items:center;font-size:22px;color:#7c73ff}.rename-tool[data-has-items="false"] .image-batch-shell__scope,.rename-tool[data-has-items="false"] .image-batch-shell__workspace,.rename-tool[data-has-items="false"] .image-batch-shell__progress,.rename-tool[data-has-items="false"] .image-batch-shell__actions,.rename-tool[data-has-items="false"] .rename-header{display:none}.rename-tool[data-has-items="true"] .image-batch-shell__upload{display:none}@media(max-width:760px){.rename-header{align-items:stretch;flex-direction:column}.rename-grid{grid-template-columns:1fr}.rename-preview{grid-template-columns:1fr}.rename-preview strong{white-space:normal;overflow-wrap:anywhere}.rename-arrow{transform:rotate(90deg);justify-self:start}}
</style>
