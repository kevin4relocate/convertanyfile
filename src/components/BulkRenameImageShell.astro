---
import type { ImageToolDefinition } from '../platform/image-tools/types';
import ImageBatchShell from '../image-tools/components/ImageBatchShell.astro';
import ImageBatchDropzone from '../image-tools/components/ImageBatchDropzone.astro';
import ImageEditScopeSwitch from '../image-tools/components/ImageEditScopeSwitch.astro';
import ImageBatchProgress from '../image-tools/components/ImageBatchProgress.astro';
import ImageBatchActionBar from '../image-tools/components/ImageBatchActionBar.astro';
import ImageToolHeaderActions from '../image-tools/components/ImageToolHeaderActions.astro';
interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const accept = tool.acceptedExtensions.map((extension) => `.${extension}`).join(',');
const maxFiles = tool.maxFiles ?? 50;
const maxFileMb = Math.max(1, Math.round(tool.maxFileBytes / (1024 * 1024)));
---
<div class="image-editor-card rename-tool" data-image-tool-app data-tool-id={tool.id} data-max-file-bytes={tool.maxFileBytes} data-max-files={maxFiles} data-has-items="false">
  <div class="image-editor-topbar"><div><span>Local image tool</span><strong>{tool.displayName}</strong></div><div class="image-editor-local-state"><span aria-hidden="true"></span>Bytes unchanged</div></div>
  <div class="image-editor-notice" data-role="notice" role="status" aria-live="polite" hidden></div>
  <section class="rename-standard-workspace">
    <ImageBatchShell variant="linear">
      <div slot="header" class="rename-header"><div><span>Images</span><strong><span data-role="batch-count">0</span> images ready</strong><small data-role="mode-summary">One naming setup applies to the batch.</small></div><ImageToolHeaderActions /></div>
      <div slot="upload"><ImageBatchDropzone variant="standard" accept={accept} maxFiles={maxFiles} maxFileMb={maxFileMb} /></div>
      <ImageEditScopeSwitch slot="scope" variant="standard" mode="shared" />
      <div slot="queue" class="rename-queue" data-role="batch-list" aria-label="Batch images"></div>

      <div slot="workspace" class="rename-workspace">
        <section class="rename-settings">
          <div class="rename-settings__heading"><span>Rename setup</span><strong>Choose how the filenames should change</strong></div>

          <div class="rename-style-switch" role="group" aria-label="Rename style">
            <button type="button" class="is-active" data-rename-style="new" aria-pressed="true"><strong>Create new names</strong><small>Replace the current filename</small></button>
            <button type="button" data-rename-style="keep" aria-pressed="false"><strong>Keep original names</strong><small>Add text before or after</small></button>
          </div>

          <div class="rename-friendly-fields" data-role="friendly-fields">
            <div data-rename-group="new" class="rename-field-group">
              <label><span>New filename</span><input data-role="new-name" value="image" maxlength="120" placeholder="Example: Holiday Photo" /><small>The original file extension stays unchanged.</small></label>
            </div>

            <div data-rename-group="keep" class="rename-field-group rename-grid-2" hidden>
              <label><span>Add before filename <em>Optional</em></span><input data-role="prefix" maxlength="80" placeholder="Example: edited-" /></label>
              <label><span>Add after filename <em>Optional</em></span><input data-role="suffix" maxlength="80" placeholder="Example: -final" /></label>
            </div>

            <div class="rename-numbering-card">
              <label class="rename-check"><input data-role="numbering" type="checkbox" checked /><span><strong>Add numbering</strong><small>Give each file a unique sequence number.</small></span></label>
              <div class="rename-numbering-options" data-role="numbering-options">
                <label><span>Start at</span><input data-role="start-number" type="number" min="0" max="999999" value="1" /></label>
                <div class="rename-format-choice"><span>Number format</span><div class="rename-mini-switch" role="group" aria-label="Number format"><button type="button" data-padding="1">1</button><button type="button" data-padding="2">01</button><button type="button" class="is-active" data-padding="3">001</button><button type="button" data-padding="4">0001</button></div></div>
                <div class="rename-format-choice"><span>Number position</span><div class="rename-mini-switch" role="group" aria-label="Number position"><button type="button" data-number-position="before">Before</button><button type="button" class="is-active" data-number-position="after">After</button></div></div>
              </div>
            </div>
          </div>

          <details class="rename-advanced">
            <summary>Advanced naming pattern</summary>
            <div class="rename-advanced__body">
              <label class="rename-check"><input data-role="advanced-enabled" type="checkbox" /><span><strong>Use a custom pattern</strong><small>For advanced batch naming only.</small></span></label>
              <label><span>Custom pattern</span><input data-role="pattern" value="{name}-{number}" maxlength="120" disabled /><small>Available tokens: {`{name}`} = original name, {`{number}`} = sequence, {`{ext}`} = extension.</small></label>
            </div>
          </details>

          <label class="rename-custom" data-role="custom-name-wrap" hidden><span>Custom filename for selected image</span><input data-role="custom-name" maxlength="180" placeholder="Leave blank to use the batch setup" /><small>The original extension is always preserved. Renaming never converts image bytes.</small></label>
        </section>

        <section class="rename-preview">
          <div class="rename-preview__heading"><div><span>Live examples</span><strong>Preview the first filenames before processing</strong></div><small data-role="preview-note">Showing up to 4 files</small></div>
          <div class="rename-preview-list" data-role="preview-list"></div>
        </section>
      </div>

      <ImageBatchProgress slot="progress" total={0} cancellable={false} />
      <ImageBatchActionBar slot="actions" processLabel="Rename files" downloadLabel="Download ZIP" />
    </ImageBatchShell>
    <p class="image-tool-policy-note">{tool.policyNote}</p>
  </section>
</div>
<script src="../client/image-tool-app.ts"></script>
<style is:global>
