t-size:16px;line-height:1;cursor:pointer}.rename-remove:hover:not(:disabled){border-color:#68413f;background:#291918;color:#ff9f98}.rename-workspace{display:grid;gap:10px}.rename-settings{display:grid;gap:13px;padding:13px 14px;border:1px solid #2b3240;border-radius:13px;background:#10151e}.rename-settings__heading{display:grid;gap:2px}.rename-settings__heading strong{font-size:13px;font-weight:740}.rename-style-switch{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;padding:5px;border:1px solid #303747;border-radius:12px;background:#0c1118}.rename-style-switch button{display:grid;gap:2px;min-height:58px;padding:9px 11px;border:1px solid transparent;border-radius:9px;background:transparent;color:#a9b0be;text-align:left;cursor:pointer}.rename-style-switch button strong{font-size:11.5px}.rename-style-switch button small{font-size:9.5px;color:#7f8798}.rename-style-switch button.is-active{border-color:#655ed0;background:#282442;color:#f3f1ff;box-shadow:0 0 0 2px rgba(124,115,255,.08)}.rename-style-switch button.is-active small{color:#b9b4dd}.rename-friendly-fields{display:grid;gap:10px}.rename-field-group{display:grid;gap:10px}.rename-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.rename-settings label{display:grid;gap:6px}.rename-settings label>span{font-size:10px;font-weight:700;color:#969dad}.rename-settings label em{margin-left:5px;color:#697182;font-size:8px;font-style:normal;font-weight:600}.rename-settings input:not([type="checkbox"]){width:100%;box-sizing:border-box;min-height:40px;border:1px solid #363f50;border-radius:9px;background:#0c1118;color:#eef1f6;padding:8px 10px;font:inherit;font-size:11px}.rename-settings input:focus{outline:none;border-color:#7169db;box-shadow:0 0 0 3px rgba(124,115,255,.1)}.rename-settings small{font-size:9.5px;color:#858fa0;line-height:1.4}.rename-numbering-card{display:grid;gap:10px;padding:11px;border:1px solid #29313f;border-radius:11px;background:#0d121a}.rename-check{display:flex!important;grid-template-columns:none!important;align-items:flex-start;gap:9px;cursor:pointer}.rename-check input{margin-top:2px;accent-color:#736bff}.rename-check>span{display:grid;gap:2px;text-transform:none!important;letter-spacing:0!important}.rename-check strong{font-size:11px;color:#edf0f6;text-transform:none}.rename-check small{font-weight:500}.rename-numbering-options{display:grid;grid-template-columns:minmax(120px,.55fr) minmax(220px,1fr) minmax(220px,1fr);gap:10px;align-items:end}.rename-numbering-options[hidden]{display:none}.rename-format-choice{display:grid;gap:6px}.rename-mini-switch{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}.rename-format-choice:last-child .rename-mini-switch{grid-template-columns:repeat(2,minmax(0,1fr))}.rename-mini-switch button{min-height:40px;border:1px solid #363f50;border-radius:8px;background:#10151e;color:#aeb5c2;font:inherit;font-size:10px;font-weight:700;cursor:pointer}.rename-mini-switch button.is-active{border-color:#655ed0;background:#282442;color:#f3f1ff}.rename-advanced{border-top:1px solid #262e3b;padding-top:2px}.rename-advanced summary{padding:9px 2px;color:#aab1bf;font-size:10.5px;font-weight:700;cursor:pointer;user-select:none}.rename-advanced__body{display:grid;gap:10px;padding:10px 11px;border:1px solid #29313f;border-radius:10px;background:#0d121a}.rename-custom{padding-top:2px}.rename-preview{display:grid;gap:9px;padding:12px 13px;border:1px solid #2b3240;border-radius:13px;background:#10151e}.rename-preview__heading{display:flex;justify-content:space-between;gap:12px;align-items:end}.rename-preview__heading>div{display:grid;gap:2px}.rename-preview__heading strong{font-size:11.5px}.rename-preview__heading>small{color:#777f90;font-size:9px}.rename-preview-list{display:grid;gap:6px}.rename-preview-row{display:grid;grid-template-columns:minmax(0,1fr) 28px minmax(0,1fr);gap:10px;align-items:center;padding:8px 9px;border:1px solid #262e3b;border-radius:9px;background:#0d121a}.rename-preview-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10.5px;color:#adb4c1}.rename-preview-result{color:#eef0f5;font-weight:700}.rename-preview-arrow{display:grid;place-items:center;color:#7c73ff;font-size:17px}.rename-preview-empty{padding:10px;color:#818999;font-size:10px}.rename-tool[data-has-items="false"] .image-batch-shell__scope,.rename-tool[data-has-items="false"] .image-batch-shell__workspace,.rename-tool[data-has-items="false"] .image-batch-shell__progress,.rename-tool[data-has-items="false"] .image-batch-shell__actions,.rename-tool[data-has-items="false"] .rename-header{display:none}.rename-tool[data-has-items="true"] .image-batch-shell__upload{display:none}@media(max-width:900px){.rename-numbering-options{grid-template-columns:1fr 1fr}.rename-numbering-options>label:first-child{grid-column:1/-1}}@media(max-width:760px){.rename-standard-workspace{padding:8px 10px 10px}.rename-header{align-items:stretch;flex-direction:column}.rename-style-switch,.rename-grid-2,.rename-numbering-options{grid-template-columns:1fr}.rename-numbering-options>label:first-child{grid-column:auto}.rename-card{min-width:210px;flex-basis:210px}.rename-preview__heading{align-items:flex-start;flex-direction:column}.rename-preview-row{grid-template-columns:1fr}.rename-preview-arrow{transform:rotate(90deg);justify-self:start}}
</style>
