---
import type { ImageToolDefinition } from '../platform/image-tools/types';
import ImageBatchShell from '../image-tools/components/ImageBatchShell.astro';
import ImageBatchDropzone from '../image-tools/components/ImageBatchDropzone.astro';
import ImageEditScopeSwitch from '../image-tools/components/ImageEditScopeSwitch.astro';
import ImageBatchProgress from '../image-tools/components/ImageBatchProgress.astro';
import ImageBatchActionBar from '../image-tools/components/ImageBatchActionBar.astro';
import ImageToolHeaderActions from '../image-tools/components/ImageToolHeaderActions.astro';
interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const accept = tool.acceptedExtensions.map((extension) => `.${extension}`).join(',');
const maxFiles = tool.maxFiles ?? 50;
const maxFileMb = Math.max(1, Math.round(tool.maxFileBytes / (1024 * 1024)));
---
<div class="image-editor-card rename-tool" data-image-tool-app data-tool-id={tool.id} data-max-file-bytes={tool.maxFileBytes} data-max-files={maxFiles} data-has-items="false">
  <div class="image-editor-topbar"><div><span>Local image tool</span><strong>{tool.displayName}</strong></div><div class="image-editor-local-state"><span aria-hidden="true"></span>Bytes unchanged</div></div>
  <div class="image-editor-notice" data-role="notice" role="status" aria-live="polite" hidden></div>
  <section class="rename-standard-workspace">
    <ImageBatchShell variant="linear">
      <div slot="header" class="rename-header"><div><strong><span data-role="batch-count">0</span> images ready</strong><small data-role="mode-summary">One rename method applies to the batch.</small></div><ImageToolHeaderActions /></div>
      <div slot="upload"><ImageBatchDropzone variant="standard" accept={accept} maxFiles={maxFiles} maxFileMb={maxFileMb} /></div>
      <ImageEditScopeSwitch slot="scope" variant="standard" mode="shared" />
      <div slot="queue" class="rename-queue" data-role="batch-list" aria-label="Batch images"></div>
      <div slot="workspace" class="rename-workspace">
        <section class="rename-settings">
          <div class="rename-settings-heading"><span>Rename method</span><strong>Choose how the filenames should change</strong><small>Extensions are always preserved. No image bytes are converted.</small></div>
          <div class="rename-method-tabs" role="group" aria-label="Rename method">
            <button type="button" class="rename-method is-active" data-rename-method="number" aria-pressed="true"><strong>Numbering</strong><small>image-001</small></button>
            <button type="button" class="rename-method" data-rename-method="prefix" aria-pressed="false"><strong>Prefix</strong><small>new-photo</small></button>
            <button type="button" class="rename-method" data-rename-method="suffix" aria-pressed="false"><strong>Suffix</strong><small>photo-final</small></button>
            <button type="button" class="rename-method" data-rename-method="replace" aria-pressed="false"><strong>Replace text</strong><small>old → new</small></button>
            <button type="button" class="rename-method" data-rename-method="pattern" aria-pressed="false"><strong>Custom pattern</strong><small>Advanced</small></button>
          </div>

          <div class="rename-method-panel" data-rename-method-panel="number">
            <label><span>Base name</span><input data-role="number-base" value="image" maxlength="100" placeholder="image" /></label>
            <label><span>Start number</span><input data-role="start-number" type="number" min="0" max="999999" value="1" /></label>
            <label><span>Number padding</span><select data-role="padding"><option value="1">1 → 1</option><option value="2">2 → 01</option><option value="3" selected>3 → 001</option><option value="4">4 → 0001</option><option value="5">5 → 00001</option><option value="6">6 → 000001</option></select></label>
          </div>

          <div class="rename-method-panel" data-rename-method-panel="prefix" hidden>
            <label class="rename-method-wide"><span>Prefix to add before each original filename</span><input data-role="prefix" value="" maxlength="100" placeholder="Example: 2026-  →  2026-original-name.jpg" /></label>
          </div>

          <div class="rename-method-panel" data-rename-method-panel="suffix" hidden>
            <label class="rename-method-wide"><span>Suffix to add after each original filename</span><input data-role="suffix" value="" maxlength="100" placeholder="Example: -final  →  original-name-final.jpg" /></label>
          </div>

          <div class="rename-method-panel" data-rename-method-panel="replace" hidden>
            <label><span>Find text</span><input data-role="find-text" value="" maxlength="100" placeholder="Text to replace" /></label>
            <label><span>Replace with</span><input data-role="replace-text" value="" maxlength="100" placeholder="New text (can be blank)" /></label>
          </div>

          <div class="rename-method-panel" data-rename-method-panel="pattern" hidden>
            <label class="rename-method-wide"><span>Custom pattern</span><input data-role="pattern" value="{name}-{number}" maxlength="120" /><small>Tokens: {`{name}`} original name · {`{number}`} sequence · {`{ext}`} extension</small></label>
            <label><span>Start number</span><input data-role="pattern-start-number" type="number" min="0" max="999999" value="1" /></label>
            <label><span>Number padding</span><select data-role="pattern-padding"><option value="1">1</option><option value="2">01</option><option value="3" selected>001</option><option value="4">0001</option><option value="5">00001</option><option value="6">000001</option></select></label>
          </div>

          <label class="rename-custom" data-role="custom-name-wrap" hidden><span>Custom filename for selected image</span><input data-role="custom-name" maxlength="180" placeholder="Override only this image" /><small>The original extension is always preserved.</small></label>
        </section>

        <section class="rename-preview-batch" aria-label="Batch rename preview">
          <div class="rename-preview-heading"><div><span>Batch preview</span><strong><span data-role="preview-count">0</span> filename changes</strong></div><small>Review every file before renaming.</small></div>
          <div class="rename-preview-list" data-role="rename-preview-list"></div>
        </section>
      </div>
      <ImageBatchProgress slot="progress" total={0} cancellable={false} />
      <ImageBatchActionBar slot="actions" processLabel="Rename files" downloadLabel="Download ZIP" />
    </ImageBatchShell>
    <p class="image-tool-policy-note">{tool.policyNote}</p>
  </section>
</div>
<script src="../client/image-tool-app.ts"></script>
<style is:global>
.rename-tool{padding:0}.rename-standard-workspace{padding:8px 14px 14px}.rename-header{min-height:42px;display:flex;justify-content:space-between;gap:18px;align-items:center;padding:4px 2px 7px}.rename-header>div:first-child{min-width:0;display:flex;align-items:center;gap:7px}.rename-header strong{font-size:13px;font-weight:740}.rename-header small{display:none}.rename-settings span,.rename-preview-batch span{color:#8e95a5;font-size:10px;font-weight:700;letter-spacing:.055em;text-transform:uppercase}.rename-queue{display:flex;gap:7px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x proximity;scrollbar-width:thin;scrollbar-color:#343c4d transparent;padding:0 0 8px;margin-bottom:2px}.rename-queue::-webkit-scrollbar{height:8px}.rename-queue::-webkit-scrollbar-thumb{border:2px solid #141923;border-radius:999px;background:#343c4d}.rename-card{min-width:218px;flex:0 0 218px;display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:8px;align-items:center;padding:7px;border:1px solid #29313f;border-radius:11px;background:#10151e;cursor:pointer;scroll-snap-align:start;transition:border-color .14s ease,background .14s ease}.rename-card.is-active{border-color:#625bc2;background:#17172a}.rename-card img{width:52px;height:44px;object-fit:cover;border-radius:8px}.rename-card__copy{display:grid;gap:2px;min-width:0}.rename-card__copy strong,.rename-card__copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rename-card__copy strong{font-size:11px;font-weight:700}.rename-card__copy small{color:#838b9b;font-size:9px}.rename-badge{width:max-content;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:2px 5px;border:1px solid #3b4352;border-radius:999px;color:#9098a8;font-size:8px;font-weight:680}.rename-badge.custom{border-color:#5b557e;color:#beb9e9}.rename-remove{width:24px;height:24px;display:grid;place-items:center;padding:0;border:1px solid #343c4d;border-radius:7px;background:#171c27;color:#8f97a7;font-size:16px;line-height:1;cursor:pointer}.rename-remove:hover:not(:disabled){border-color:#68413f;background:#291918;color:#ff9f98}.rename-workspace{display:grid;gap:10px}.rename-settings,.rename-preview-batch{display:grid;gap:11px;padding:11px 12px;border:1px solid #2b3240;border-radius:13px;background:#10151e}.rename-settings-heading{display:grid;gap:3px}.rename-settings-heading strong{font-size:12px;font-weight:720}.rename-settings-heading small,.rename-preview-heading small{color:#858fa0;font-size:9.5px;line-height:1.4}.rename-method-tabs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}.rename-method{min-height:48px;display:grid;gap:2px;justify-items:start;padding:7px 9px;border:1px solid #343c4d;border-radius:9px;background:#111722;color:#b7becb;text-align:left;cursor:pointer}.rename-method strong{font-size:10.5px}.rename-method small{font-size:8.5px;color:#7f8899}.rename-method.is-active{border-color:#7168e7;background:#262143;color:#f3f1ff;box-shadow:inset 0 0 0 1px rgba(132,122,255,.18)}.rename-method-panel{display:grid;grid-template-columns:minmax(220px,2fr) repeat(2,minmax(120px,1fr));gap:10px}.rename-method-panel[hidden]{display:none}.rename-method-panel label,.rename-custom{display:grid;gap:6px}.rename-method-panel input,.rename-method-panel select,.rename-custom input{width:100%;box-sizing:border-box;min-height:38px;border:1px solid #363f50;border-radius:9px;background:#0c1118;color:#eef1f6;padding:7px 9px;font:inherit;font-size:11px}.rename-method-panel small,.rename-custom small{font-size:9.5px;color:#858fa0;line-height:1.4}.rename-method-wide{grid-column:span 1}.rename-custom{padding-top:9px;border-top:1px solid #29313f}.rename-preview-heading{display:flex;justify-content:space-between;align-items:end;gap:12px}.rename-preview-heading>div{display:grid;gap:3px}.rename-preview-heading strong{font-size:12px}.rename-preview-list{display:grid;max-height:300px;overflow:auto;border:1px solid #29313f;border-radius:10px;background:#0c1118;scrollbar-width:thin}.rename-preview-row{display:grid;grid-template-columns:30px minmax(0,1fr) 22px minmax(0,1fr);align-items:center;gap:9px;min-height:38px;padding:6px 9px;border-bottom:1px solid #202735;cursor:pointer}.rename-preview-row:last-child{border-bottom:0}.rename-preview-row:hover,.rename-preview-row.is-active{background:#151827}.rename-preview-row__index{color:#697286;font-size:9px;font-variant-numeric:tabular-nums}.rename-preview-row strong,.rename-preview-row span:not(.rename-preview-row__index){min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10.5px}.rename-preview-row strong{color:#dfe3eb}.rename-preview-row__arrow{color:#746bff;text-align:center;font-size:15px}.rename-tool[data-has-items="false"] .image-batch-shell__scope,.rename-tool[data-has-items="false"] .image-batch-shell__workspace,.rename-tool[data-has-items="false"] .image-batch-shell__progress,.rename-tool[data-has-items="false"] .image-batch-shell__actions,.rename-tool[data-has-items="false"] .rename-header{display:none}.rename-tool[data-has-items="true"] .image-batch-shell__upload{display:none}@media(max-width:980px){.rename-method-tabs{grid-template-columns:repeat(3,minmax(0,1fr))}.rename-method-panel{grid-template-columns:1fr 1fr}.rename-method-panel[data-rename-method-panel="number"] label:first-child,.rename-method-wide{grid-column:1/-1}}@media(max-width:760px){.rename-standard-workspace{padding:8px 10px 10px}.rename-header{align-items:stretch;flex-direction:column}.rename-method-tabs,.rename-method-panel{grid-template-columns:1fr}.rename-method-panel[data-rename-method-panel="number"] label:first-child,.rename-method-wide{grid-column:auto}.rename-card{min-width:210px;flex-basis:210px}.rename-preview-heading{align-items:stretch;flex-direction:column}.rename-preview-row{grid-template-columns:24px minmax(0,1fr);gap:3px 8px}.rename-preview-row__arrow{display:none}.rename-preview-row span:last-child{grid-column:2;color:#a7afff}}
</style>
