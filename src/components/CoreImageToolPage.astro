---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageToolPageFrame from './ImageToolPageFrame.astro';
import ImageToolGrid from './ImageToolGrid.astro';
import type { ImageToolDefinition } from '../platform/image-tools/types';
import { SITE } from '../config/site';

interface Props {
  tool: ImageToolDefinition;
  kicker: string;
  heading: string;
  copy: string;
  bullets: string[];
}
const { tool, kicker, heading, copy, bullets } = Astro.props;
const isMetadataCleaner = tool.id === 'remove-image-metadata';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `ConvertAnyFile ${tool.displayName}`,
  url: `${SITE.origin}/${tool.slug}/`,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: isMetadataCleaner
    ? ['Browser-only image processing', 'Local metadata scan', 'Batch up to 50 images', 'Shared output settings', 'Optional per-image output overrides', 'ZIP download']
    : ['Browser-only image processing', 'Batch up to 50 images', 'Shared settings', 'Per-image overrides', 'Live preview', 'ZIP download'],
};
---
<SiteLayout title={tool.title} description={tool.description} schema={schema}>
  <ImageToolPageFrame tool={tool} />
  <section class="content-wide-section white gemini-content-section"><div class="site-container">
    <div class="content-intro-grid"><div class="section-heading wide"><span class="section-kicker">{kicker}</span><h2>{heading}</h2><p>{copy}</p></div><div class="content-summary-card"><strong>Private by design</strong><p>Source images are decoded and processed locally in your browser. The tool does not require an image-processing API upload.</p></div></div>
    <ul class="content-checklist">{bullets.map((bullet) => <li>{bullet}</li>)}</ul>
  </div></section>
  <section class="content-wide-section gemini-content-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Batch workflow</span><h2>Apply one setup to all, or customize individual images.</h2><p>The shared Image Tools platform keeps one batch queue while allowing per-image overrides. Successful multi-image results can be downloaded together as a ZIP.</p></div><ImageToolGrid compact /></div></section>
</SiteLayout>
