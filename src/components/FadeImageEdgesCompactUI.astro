.fade-image-edges-v2-shell .edge-fade-v2-grid--compact>.edge-fade-advanced{grid-column:1/-1;margin-top:1px!important}
.fade-image-edges-v2-shell .edge-fade-v2-grid--compact label>span{margin-bottom:5px}
.fade-image-edges-v2-shell .edge-fade-v2-grid--compact .edge-fade-advanced>summary{min-height:36px;display:flex;align-items:center;padding:0 2px;font-size:10.5px}
.fade-image-edges-v2-shell .edge-fade-v2-grid--compact .edge-fade-advanced[open]>summary{margin-bottom:8px!important}
