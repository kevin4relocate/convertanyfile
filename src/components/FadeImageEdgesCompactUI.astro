  .fade-image-edges-v2-shell .edge-fade-v2-grid.edge-fade-v2-grid--compact{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .fade-image-edges-v2-shell .edge-fade-v2-grid--compact>.edge-fade-compact-preset,
  .fade-image-edges-v2-shell .edge-fade-v2-grid--compact>.edge-fade-compact-edge{grid-column:span 1}
