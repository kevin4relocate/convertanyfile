---
import { PLATFORM_CATEGORIES } from '../config/site';
---
<div class="category-grid">
  {PLATFORM_CATEGORIES.map((category) => category.status === 'live' ? (
    <a class="category-card category-card--live" href={category.href}><div class="category-icon" aria-hidden="true">{category.label.slice(0,1)}</div><div><span class="live-badge">Live</span><h3>{category.label}</h3><p>{category.description}</p></div><span class="category-arrow">→</span></a>
  ) : (
    <article class="category-card category-card--planned"><div class="category-icon" aria-hidden="true">{category.label.slice(0,1)}</div><div><span class="planned-badge">Planned</span><h3>{category.label}</h3><p>{category.description}</p></div></article>
  ))}
</div>
