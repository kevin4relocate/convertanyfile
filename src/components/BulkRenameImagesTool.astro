<div class="rename-tool" data-bulk-rename>
  <div class="rename-topbar"><div><span>Local image tool</span><strong>Bulk Rename Images</strong></div><em>Bytes stay unchanged</em></div>
  <div class="rename-notice" data-role="notice" role="status" aria-live="polite" hidden></div>
  <div class="rename-drop" data-role="dropzone" tabindex="0" role="button">
    <input data-role="file-input" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple hidden />
    <span aria-hidden="true">↥</span><strong>Drop images to rename</strong><p>JPG, PNG and WebP · up to 100 files · 200 MB total</p><button type="button" class="primary-button" data-role="choose">Choose images</button>
  </div>
  <div class="rename-workspace" data-role="workspace" hidden>
    <div class="rename-summary"><div><span>Rename batch</span><strong data-role="summary">0 images</strong></div><button type="button" data-role="clear">Clear all</button></div>
    <div class="rename-settings">
      <label><span>Name pattern</span><input data-role="pattern" type="text" value="{name}-{n}" maxlength="120" /></label>
      <label><span>Start number</span><input data-role="start" type="number" value="1" min="0" max="999999" /></label>
      <label><span>Number padding</span><select data-role="padding"><option value="1">1 → 1</option><option value="2">2 → 01</option><option value="3" selected>3 → 001</option><option value="4">4 → 0001</option></select></label>
      <label class="rename-toggle"><input data-role="lowercase" type="checkbox" /><span>Lowercase filenames</span></label>
    </div>
    <p class="rename-help"><code>{'{name}'}</code> keeps the original filename without its extension. <code>{'{n}'}</code> inserts the sequence number. Invalid filename characters are replaced safely.</p>
    <div class="rename-list" data-role="list"></div>
    <div class="rename-downloads"><span data-role="preview-summary"></span><button type="button" class="secondary-button" data-role="download-all">Download renamed ZIP</button></div>
  </div>
</div>
<script>import '../scripts/bulk-rename-images';</script>
<style>
.rename-tool{overflow:hidden;border:1px solid #303746;border-radius:22px;background:#121821}.rename-topbar{min-height:64px;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #303746;background:#171c27}.rename-topbar>div{display:grid;gap:2px}.rename-topbar span{color:#a99fff;font-size:10px;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.rename-topbar strong{color:#f3f5fb;font-size:15px}.rename-topbar em{color:#62d6a2;font-size:11px;font-style:normal;font-weight:750}.rename-notice{margin:12px 18px 0;padding:10px 12px;border:1px solid #6d5931;border-radius:11px;background:#211c13;color:#e1c27b;font-size:11px}.rename-drop{margin:18px;min-height:280px;display:grid;place-items:center;align-content:center;gap:12px;padding:30px;border:1.5px dashed #465064;border-radius:18px;background:#0f151e;text-align:center;cursor:pointer}.rename-drop>span{font-size:32px;color:#cbc7ff}.rename-drop>strong{color:#f4f5fa;font-size:28px}.rename-drop p,.rename-help{margin:0;color:#9299a9;font-size:11px}.rename-workspace{padding:18px}.rename-summary{display:flex;align-items:end;justify-content:space-between;gap:12px;padding:4px 4px 14px}.rename-summary>div{display:grid;gap:3px}.rename-summary span{color:#a69cff;font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.1em}.rename-summary strong{color:#f3f5fb;font-size:23px}.rename-summary button{border:0;background:none;color:#9299a8;cursor:pointer;font:inherit;font-size:12px;font-weight:750}.rename-settings{display:grid;grid-template-columns:2fr repeat(2,minmax(120px,1fr)) 1.2fr;gap:10px;padding:14px;border:1px solid #32394a;border-radius:16px;background:#171c27}.rename-settings label{display:grid;gap:7px;color:#aeb4c2;font-size:11px;font-weight:750}.rename-settings input[type=text],.rename-settings input[type=number],.rename-settings select{width:100%;height:42px;box-sizing:border-box;border:1px solid #3a4354;border-radius:10px;background:#111720;color:#f0f2f7;padding:0 12px;font:inherit;font-size:12px}.rename-toggle{display:flex!important;align-items:center;grid-template-columns:auto 1fr!important;gap:8px!important;padding:0 12px;border:1px solid #343c4c;border-radius:10px;background:#141a24}.rename-toggle input{width:16px;height:16px}.rename-help{padding:10px 3px}.rename-help code{color:#cbc7ff}.rename-list{border:1px solid #2e3644;border-radius:14px;background:#0f151e}.rename-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;min-height:60px;padding:9px 14px;border-bottom:1px solid #272e3a}.rename-row:last-child{border-bottom:0}.rename-row-copy{min-width:0;display:grid;gap:3px}.rename-row-copy strong,.rename-row-copy span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rename-row-copy strong{color:#e9ecf2;font-size:11px}.rename-row-copy span{color:#75d7ad;font-size:10px}.rename-row button{border:0;background:none;color:#aaa4ff;cursor:pointer;font:inherit;font-size:11px;font-weight:760}.rename-downloads{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:12px}.rename-downloads span{color:#959cab;font-size:11px}.primary-button,.secondary-button{border:0;border-radius:12px;cursor:pointer;font:inherit;font-weight:800}.primary-button{min-height:46px;padding:0 24px;background:linear-gradient(135deg,#766dff,#6359ef);color:#fff}.secondary-button{min-height:40px;padding:0 18px;border:1px solid #3a4354;background:#1a202b;color:#e7e9f0}
@media(max-width:850px){.rename-settings{grid-template-columns:1fr 1fr}.rename-settings label:first-child{grid-column:1/-1}}
@media(max-width:560px){.rename-topbar{align-items:flex-start;flex-direction:column;gap:5px}.rename-drop{min-height:240px;margin:12px;padding:22px 14px}.rename-drop>strong{font-size:23px}.rename-workspace{padding:12px}.rename-settings{grid-template-columns:1fr}.rename-settings label:first-child{grid-column:1}.rename-row{grid-template-columns:minmax(0,1fr) auto}.rename-downloads{align-items:stretch;flex-direction:column}.rename-downloads button{width:100%}}
</style>
