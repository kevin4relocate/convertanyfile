---
import type { GrowthLinkGroup } from '../config/growth-links';

interface Props {
  groups: readonly GrowthLinkGroup[];
  compact?: boolean;
}
const { groups, compact = false } = Astro.props;
---
<div class:list={['growth-link-groups', compact && 'growth-link-groups--compact']}>
  {groups.map((group) => (
    <section class="growth-link-group" aria-label={group.title}>
      <h3>{group.title}</h3>
      <div class="growth-link-list">
        {group.links.map((link) => (
          <a class="growth-link" href={link.href}>
            <span><strong>{link.label}</strong><small>{link.description}</small></span>
            <span class="growth-link-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .growth-link-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .growth-link-group{min-width:0;padding:18px;border:1px solid var(--line);border-radius:18px;background:var(--card)}
  .growth-link-group h3{margin:0 0 12px;font-size:15px;letter-spacing:-.02em}
  .growth-link-list{display:grid;gap:7px}
  .growth-link{min-width:0;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 12px;border:1px solid var(--line);border-radius:12px;background:var(--soft);transition:border-color .15s ease,transform .15s ease,background .15s ease}
  .growth-link:hover{transform:translateY(-1px);border-color:color-mix(in srgb,var(--accent) 42%,var(--line));background:var(--accent-soft)}
  .growth-link>span:first-child{min-width:0;display:grid;gap:3px}
  .growth-link strong{font-size:12px;line-height:1.3}
  .growth-link small{color:var(--muted);font-size:10.5px;line-height:1.45}
  .growth-link-arrow{flex:0 0 auto;color:var(--accent-dark);font-size:17px}
  .growth-link-groups--compact{grid-template-columns:1fr}
  .growth-link-groups--compact .growth-link-group{padding:0;border:0;background:transparent}
  .growth-link-groups--compact .growth-link-list{grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
  .growth-link-groups--compact .growth-link{align-items:flex-start;min-height:94px;background:var(--card)}
  @media(max-width:900px){.growth-link-groups{grid-template-columns:1fr}.growth-link-groups--compact .growth-link-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.growth-link-groups--compact .growth-link-list{grid-template-columns:1fr}.growth-link{padding:12px}}
</style>
