---
import type { ConverterDefinition } from '../platform/converter/types';
import { acceptedExtensionsForConverter } from '../config/converter-registry';
interface Props { converter: ConverterDefinition; compact?: boolean; }
const { converter, compact = false } = Astro.props;
const policy = converter.batchPolicy;
const acceptedHint = converter.input
  ? `${converter.input.toUpperCase()} files`
  : converter.category === 'image'
    ? 'JPG, PNG, WebP, HEIC, AVIF, TIFF and other supported images'
    : converter.category === 'data'
      ? 'CSV, TSV, JSON, JSONL and NDJSON files'
      : 'Supported files';
const toolLabel = converter.input && converter.output
  ? `${converter.input.toUpperCase()} → ${converter.output.toUpperCase()}`
  : converter.category === 'image'
    ? 'Image Converter'
    : converter.category === 'data'
      ? 'Data Converter'
      : 'File Converter';
const accept = acceptedExtensionsForConverter(converter).map((extension) => `.${extension}`).join(',');
---
<div
  class:list={['converter-card', compact && 'converter-card--compact']}
  data-converter-app
  data-engine={converter.engine}
  data-input={converter.input ?? ''}
  data-output={converter.output ?? ''}
  data-quick-outputs={(converter.quickOutputs ?? []).join(',')}
  data-max-files={policy.maxFiles}
  data-max-total-bytes={policy.maxTotalBytes}
  data-max-file-bytes={policy.maxFileBytes}
>
  <div class="converter-topbar">
    <div><span class="tool-kicker">Local converter</span><strong>{toolLabel}</strong></div>
    <div class="engine-state" data-role="engine-state" data-state="idle" role="status" aria-live="polite"><span class="engine-dot" aria-hidden="true"></span><span data-engine-label>Loads when you add files</span></div>
  </div>
  <section class="converter-app">
    <div class="notice" data-role="notice" role="status" aria-live="polite" hidden></div>
    <div class="notice" data-role="success-notice" data-type="success" role="status" aria-live="polite" hidden></div>
    <div class="drop-view" data-role="drop-view">
      <button class="drop-zone" data-role="drop-zone" type="button" aria-label={`Choose or drop ${acceptedHint.toLowerCase()}`}>
        <span class="drop-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14.5v3A2.5 2.5 0 0 0 7.5 20h9a2.5 2.5 0 0 0 2.5-2.5v-3" /></svg></span>
        <span class="drop-title">Drop your files here</span><span class="drop-copy">{acceptedHint}</span><span class="choose-button">Choose files</span><span class="drop-privacy"><span class="privacy-dot" aria-hidden="true"></span> Files stay on your device during conversion</span>
      </button>
      <input data-role="file-input" type="file" multiple accept={accept} hidden />
    </div>
    <div class="workspace" data-role="workspace" hidden>
      <div class="workspace-drop-hint" data-role="workspace-drop-hint" aria-hidden="true"><span>Drop to add files</span></div>
      <header class="workspace-header">
        <div><span class="workspace-label">Ready to convert</span><h2 data-role="batch-summary">0 files</h2><p>Processed locally in this browser session.</p></div>
        <div class="workspace-actions"><button data-role="add-more" class="text-button strong" type="button">+ Add more</button><button data-role="clear-all" class="text-button" type="button">Clear all</button></div>
      </header>
      <section class="settings-card" aria-label="Conversion settings">
        <label class="field output-field"><span>Convert all to</span><select data-role="output-format" aria-label="Output format"></select></label>
        <div class="quick-field"><span>Popular outputs</span><div class="quick-outputs" data-role="quick-outputs"></div></div>
        <div class="output-controls" data-role="output-controls">
          <label class="field quality-field" data-role="quality-field"><span data-role="quality-label">Quality 90</span><input data-role="quality" type="range" min="1" max="100" value="90" aria-label="Output quality" /></label>
          <div class="extra-output-controls" data-role="extra-controls"></div>
        </div>
        {compact && <button data-role="convert-top" class="primary-button settings-convert-button" type="button">Preparing converter…</button>}
      </section>
      {converter.category === 'image' && (
        <p class="conversion-policy-note">Certified output formats are filtered against the image engine running in your browser. Animated, multi-page, or layered inputs are currently exported as a single image; ICO inputs use the best available icon frame.</p>
      )}
      {converter.category === 'data' && (
        <p class="conversion-policy-note">UTF-8 structured text is processed locally. CSV/TSV use the first row as headers; nested JSON objects use dot-notation columns for tabular output, while arrays remain explicit JSON text.</p>
      )}
      <div class="progress-wrap" data-role="progress" hidden role="progressbar" aria-label="Conversion progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-copy"><strong data-role="progress-text">Preparing…</strong><span>Keep this tab open</span></div><div class="progress-track"><span data-role="progress-bar"></span></div></div>
      <div class="file-list" data-role="file-list" aria-label="Selected files"></div>
      <div class="batch-action-bar"><p class="result-summary" data-role="result-summary" hidden></p><div class="batch-buttons"><button data-role="cancel" class="secondary-button danger-button" type="button" hidden>Cancel</button><button data-role="download-zip" class="secondary-button" type="button" hidden>Download ZIP</button><button data-role="convert-all" class="primary-button" type="button">Preparing converter…</button></div></div>
    </div>
    {compact && <div class="sticky-convert-bar" data-role="sticky-convert-bar" hidden><span data-role="sticky-summary">Ready to convert</span><button data-role="convert-sticky" class="primary-button" type="button">Convert</button></div>}
  </section>
</div>
<script src="../client/converter-app.ts"></script>
<script>
  const feedbackTimers = new WeakMap<HTMLElement, number>();

  const prettyLimit = (bytes: number): string => {
    const mib = bytes / (1024 * 1024);
    return Number.isInteger(mib) ? `${mib} MB` : `${mib.toFixed(1)} MB`;
  };

  const compactSkippedNotice = (root: HTMLElement, raw: string): string => {
    const match = raw.match(/^(\d+) files? skipped:/i);
    if (!match) return raw;
    const count = Number(match[1]);
    const noun = count === 1 ? 'file' : 'files';
    const maxFiles = Number(root.dataset.maxFiles || 50);
    const maxFileBytes = Number(root.dataset.maxFileBytes || 0);
    const maxTotalBytes = Number(root.dataset.maxTotalBytes || 0);

    if (raw.includes(`over the ${maxFiles}-file limit`)) return `${count} ${noun} skipped — ${maxFiles}-file limit reached.`;
    if (raw.includes('per file') && maxFileBytes > 0) return `${count} ${noun} skipped — max ${prettyLimit(maxFileBytes)} per file.`;
    if (raw.includes('batch limit') && maxTotalBytes > 0) return `${count} ${noun} skipped — batch limit ${prettyLimit(maxTotalBytes)}.`;
    return raw;
  };

  const showSuccessNotice = (root: HTMLElement, message: string): void => {
    const notice = root.querySelector<HTMLElement>('[data-role="success-notice"]');
    const warningNotice = root.querySelector<HTMLElement>('[data-role="notice"]');
    if (!notice) return;
    const previous = feedbackTimers.get(notice);
    if (previous) window.clearTimeout(previous);
    if (warningNotice) warningNotice.hidden = true;
    notice.textContent = message;
    notice.hidden = false;
    feedbackTimers.set(notice, window.setTimeout(() => { notice.hidden = true; }, 4600));
  };

  const clearDragVisuals = (): void => {
    document.querySelectorAll<HTMLElement>('.workspace.is-dragging, .drop-zone.is-dragging').forEach((element) => element.classList.remove('is-dragging'));
  };

  const initCompactConvertActions = (root: HTMLElement): void => {
    if (!root.classList.contains('converter-card--compact') || root.dataset.compactActionsReady === 'true') return;
    root.dataset.compactActionsReady = 'true';
    const source = root.querySelector<HTMLButtonElement>('[data-role="convert-all"]');
    const top = root.querySelector<HTMLButtonElement>('[data-role="convert-top"]');
    const sticky = root.querySelector<HTMLButtonElement>('[data-role="convert-sticky"]');
    const stickyBar = root.querySelector<HTMLElement>('[data-role="sticky-convert-bar"]');
    const stickySummary = root.querySelector<HTMLElement>('[data-role="sticky-summary"]');
    const workspace = root.querySelector<HTMLElement>('[data-role="workspace"]');
    const batchSummary = root.querySelector<HTMLElement>('[data-role="batch-summary"]');
    if (!source || !top || !sticky || !stickyBar || !workspace) return;

    let topVisible = true;
    const sync = (): void => {
      const unavailable = source.disabled || source.hidden;
      top.textContent = source.textContent || 'Convert';
      top.disabled = source.disabled;
      top.hidden = source.hidden;
      sticky.textContent = source.textContent || 'Convert';
      sticky.disabled = source.disabled;
      if (stickySummary) stickySummary.textContent = batchSummary?.textContent?.trim() || 'Ready to convert';
      stickyBar.hidden = workspace.hidden || unavailable || topVisible;
    };

    top.addEventListener('click', () => source.click());
    sticky.addEventListener('click', () => source.click());
    const observer = new MutationObserver(sync);
    observer.observe(source, { attributes: true, attributeFilter: ['disabled', 'hidden'], childList: true, characterData: true, subtree: true });
    observer.observe(workspace, { attributes: true, attributeFilter: ['hidden'] });
    if (batchSummary) observer.observe(batchSummary, { childList: true, characterData: true, subtree: true });
    const visibility = new IntersectionObserver((entries) => {
      topVisible = entries[0]?.isIntersecting ?? true;
      sync();
    }, { threshold: 0.15 });
    visibility.observe(top);
    sync();
  };

  const initConverterFeedback = (): void => {
    document.querySelectorAll<HTMLElement>('[data-converter-app]').forEach((root) => {
      if (root.dataset.feedbackReady === 'true') return;
      root.dataset.feedbackReady = 'true';
      initCompactConvertActions(root);

      const notice = root.querySelector<HTMLElement>('[data-role="notice"]');
      const result = root.querySelector<HTMLElement>('[data-role="result-summary"]');
      if (notice) {
        const noticeObserver = new MutationObserver(() => {
          if (notice.hidden) return;
          const raw = notice.textContent?.trim() ?? '';
          const compact = compactSkippedNotice(root, raw);
          if (compact !== raw) notice.textContent = compact;
        });
        noticeObserver.observe(notice, { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
      }

      if (result) {
        let lastSuccess = '';
        const resultObserver = new MutationObserver(() => {
          if (result.hidden) return;
          const text = result.textContent?.trim() ?? '';
          const match = text.match(/^(\d+)\/(\d+) converted\b/i);
          if (!match || match[1] !== match[2] || Number(match[2]) < 1) return;
          const total = Number(match[2]);
          const key = `${total}:${text}`;
          if (key === lastSuccess) return;
          lastSuccess = key;
          showSuccessNotice(root, `${total} ${total === 1 ? 'file' : 'files'} converted successfully.`);
        });
        resultObserver.observe(result, { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
      }
    });

    const html = document.documentElement;
    if (html.dataset.converterDragRecoveryReady !== 'true') {
      html.dataset.converterDragRecoveryReady = 'true';
      document.addEventListener('drop', () => queueMicrotask(clearDragVisuals), true);
      document.addEventListener('dragend', clearDragVisuals, true);
      window.addEventListener('blur', clearDragVisuals);
    }
  };

  initConverterFeedback();
</script>
<style is:global>
  .settings-card{padding-left:26px;padding-right:28px;column-gap:24px}.output-field{padding-left:2px;padding-right:4px}.output-controls{display:flex;align-items:center;justify-content:flex-end;gap:12px;flex-wrap:wrap;min-width:0;padding-right:2px}.extra-output-controls{display:flex;align-items:center;justify-content:flex-end;gap:14px;flex-wrap:wrap}.setting-field{white-space:nowrap}.setting-field select{min-width:88px}.setting-field--checkbox{gap:8px;margin-right:2px}.setting-field--checkbox input{width:15px;height:15px;margin:0;accent-color:var(--accent)}
  .notice{width:min(760px,calc(100vw - 40px));max-width:760px;text-align:center;line-height:1.45;overflow-wrap:anywhere}.notice[data-type=success]{color:#166b49;background:#eefaf4;border-color:#bfe8d2;box-shadow:0 12px 35px rgba(24,122,85,.12)}
  .converter-card--compact .settings-card{grid-template-columns:auto minmax(180px,1fr) auto;grid-template-areas:"output controls action" "quick quick quick";row-gap:12px}.converter-card--compact .output-field{grid-area:output}.converter-card--compact .quick-field{grid-area:quick;border-top:1px solid #e7e8ef;padding-top:11px}.converter-card--compact .output-controls{grid-area:controls}.converter-card--compact .settings-convert-button{grid-area:action;min-height:42px;min-width:170px;padding:9px 18px;white-space:nowrap}.converter-card--compact .batch-buttons [data-role="convert-all"]{display:none}.converter-card--compact .batch-action-bar:has(.batch-buttons button:not([hidden])){padding-top:10px}.sticky-convert-bar{position:fixed;left:50%;bottom:16px;z-index:65;transform:translateX(-50%);width:min(760px,calc(100vw - 32px));display:flex;align-items:center;gap:14px;padding:10px 10px 10px 16px;border:1px solid #dedfe8;border-radius:16px;background:rgba(255,255,255,.94);box-shadow:0 18px 48px rgba(23,24,34,.18);backdrop-filter:blur(16px)}.sticky-convert-bar>span{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#616573;font-size:12px;font-weight:760}.sticky-convert-bar .primary-button{flex:0 0 auto;min-height:42px;min-width:190px;padding:9px 18px}
  @media(max-width:900px){.settings-card{padding-left:18px;padding-right:18px}.output-controls,.extra-output-controls{justify-content:flex-start;padding-right:0}.setting-field{white-space:normal}.setting-field--checkbox{margin-right:0}.converter-card--compact .settings-card{grid-template-columns:1fr auto;grid-template-areas:"output action" "controls controls" "quick quick"}.converter-card--compact .settings-convert-button{min-width:160px}}
  @media(max-width:760px){.notice{width:calc(100vw - 24px);max-width:calc(100vw - 24px);padding:10px 12px;font-size:11px}.converter-card--compact .settings-card{grid-template-columns:1fr;grid-template-areas:"output" "controls" "action" "quick"}.converter-card--compact .settings-convert-button{width:100%;min-height:48px}.sticky-convert-bar{bottom:10px;width:calc(100vw - 20px);padding:8px 8px 8px 12px}.sticky-convert-bar>span{font-size:11px}.sticky-convert-bar .primary-button{min-width:150px}}
</style>
