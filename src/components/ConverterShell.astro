---
import type { ConverterDefinition } from '../platform/converter/types';
import { acceptedExtensionsForConverter } from '../config/converter-registry';
interface Props { converter: ConverterDefinition; compact?: boolean; }
const { converter, compact = false } = Astro.props;
const policy = converter.batchPolicy;
const acceptedHint = converter.input
  ? `${converter.input.toUpperCase()} files`
  : converter.category === 'image'
    ? 'JPG, PNG, WebP, HEIC, AVIF, TIFF, RAW and 40+ more image extensions'
    : converter.category === 'data'
      ? 'CSV, TSV, JSON, JSONL and NDJSON files'
      : 'Supported files';
const toolLabel = converter.input && converter.output
  ? `${converter.input.toUpperCase()} → ${converter.output.toUpperCase()}`
  : converter.category === 'image'
    ? 'Image Converter'
    : converter.category === 'data'
      ? 'Data Converter'
      : 'File Converter';
const accept = acceptedExtensionsForConverter(converter).map((extension) => `.${extension}`).join(',');
---
<div
  class:list={['converter-card', compact && 'converter-card--compact']}
  data-converter-app
  data-engine={converter.engine}
  data-input={converter.input ?? ''}
  data-output={converter.output ?? ''}
  data-quick-outputs={(converter.quickOutputs ?? []).join(',')}
  data-max-files={policy.maxFiles}
  data-max-total-bytes={policy.maxTotalBytes}
  data-max-file-bytes={policy.maxFileBytes}
>
  <div class="converter-topbar">
    <div><span class="tool-kicker">Local converter</span><strong>{toolLabel}</strong></div>
    <div class="engine-state" data-role="engine-state" data-state="idle" role="status" aria-live="polite"><span class="engine-dot" aria-hidden="true"></span><span data-engine-label>Loads when you add files</span></div>
  </div>
  <section class="converter-app">
    <div class="notice" data-role="notice" role="status" aria-live="polite" hidden></div>
    <div class="drop-view" data-role="drop-view">
      <button class="drop-zone" data-role="drop-zone" type="button" aria-label={`Choose or drop ${acceptedHint.toLowerCase()}`}>
        <span class="drop-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14.5v3A2.5 2.5 0 0 0 7.5 20h9a2.5 2.5 0 0 0 2.5-2.5v-3" /></svg></span>
        <span class="drop-title">Drop your files here</span><span class="drop-copy">{acceptedHint}</span><span class="choose-button">Choose files</span><span class="drop-privacy"><span class="privacy-dot" aria-hidden="true"></span> Files stay on your device during conversion</span>
      </button>
      <input data-role="file-input" type="file" multiple accept={accept} hidden />
    </div>
    <div class="workspace" data-role="workspace" hidden>
      <div class="workspace-drop-hint" data-role="workspace-drop-hint" aria-hidden="true"><span>Drop to add files</span></div>
      <header class="workspace-header">
        <div><span class="workspace-label">Ready to convert</span><h2 data-role="batch-summary">0 files</h2><p>Processed locally in this browser session.</p></div>
        <div class="workspace-actions"><button data-role="add-more" class="text-button strong" type="button">+ Add more</button><button data-role="clear-all" class="text-button" type="button">Clear all</button></div>
      </header>
      <section class="settings-card" aria-label="Conversion settings">
        <label class="field output-field"><span>Convert all to</span><select data-role="output-format" aria-label="Output format"></select></label>
        <div class="quick-field"><span>Popular outputs</span><div class="quick-outputs" data-role="quick-outputs"></div></div>
        <div class="output-controls" data-role="output-controls">
          <label class="field quality-field" data-role="quality-field"><span data-role="quality-label">Quality 90</span><input data-role="quality" type="range" min="1" max="100" value="90" aria-label="Output quality" /></label>
          <div class="extra-output-controls" data-role="extra-controls"></div>
        </div>
      </section>
      {converter.category === 'image' && (
        <p class="conversion-policy-note">Certified output formats are filtered against the image engine running in your browser. Animated, multi-page, or layered inputs are currently exported as a single image; ICO inputs use the best available icon frame.</p>
      )}
      {converter.category === 'data' && (
        <p class="conversion-policy-note">UTF-8 structured text is processed locally. CSV/TSV use the first row as headers; nested JSON objects use dot-notation columns for tabular output, while arrays remain explicit JSON text.</p>
      )}
      <div class="progress-wrap" data-role="progress" hidden role="progressbar" aria-label="Conversion progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-copy"><strong data-role="progress-text">Preparing…</strong><span>Keep this tab open</span></div><div class="progress-track"><span data-role="progress-bar"></span></div></div>
      <div class="file-list" data-role="file-list" aria-label="Selected files"></div>
      <div class="batch-action-bar"><p class="result-summary" data-role="result-summary" hidden></p><div class="batch-buttons"><button data-role="cancel" class="secondary-button danger-button" type="button" hidden>Cancel</button><button data-role="download-zip" class="secondary-button" type="button" hidden>Download ZIP</button><button data-role="convert-all" class="primary-button" type="button">Preparing converter…</button></div></div>
    </div>
  </section>
</div>
<script src="../client/converter-app.ts"></script>
<style is:global>
  .output-controls{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap;min-width:0}.extra-output-controls{display:flex;align-items:center;justify-content:flex-end;gap:9px;flex-wrap:wrap}.setting-field{white-space:nowrap}.setting-field select{min-width:78px}.setting-field--checkbox{gap:6px}.setting-field--checkbox input{width:15px;height:15px;margin:0;accent-color:var(--accent)}
  @media(max-width:900px){.output-controls,.extra-output-controls{justify-content:flex-start}.setting-field{white-space:normal}}
</style>
