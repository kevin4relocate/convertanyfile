<div class="region-blur-editor" data-region-blur>
  <div class="region-blur-topbar"><div><span>Interactive privacy blur</span><strong>Selected Region</strong></div><span class="region-blur-local"><i></i> Browser-only</span></div>
  <div class="region-blur-notice" data-role="notice" role="status" aria-live="polite" hidden></div>
  <section class="region-blur-upload" data-role="upload-view">
    <button class="region-blur-drop" data-role="drop-zone" type="button"><span class="region-blur-upload-icon">↑</span><strong>Add one image</strong><span>JPG, PNG or WebP · 20 MB max · 20 MP safety limit</span><span class="primary-button">Choose image</span><small>Source pixels stay on this device</small></button>
    <input data-role="file-input" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden />
  </section>
  <section class="region-blur-workspace" data-role="workspace" hidden>
    <header class="region-blur-header"><div><span>Selected image</span><strong data-role="filename">image.png</strong><small data-role="filemeta"></small></div><div><button type="button" data-role="replace">Replace</button><button type="button" data-role="clear">Clear</button></div></header>
    <div class="region-blur-settings">
      <label><span>Shape</span><select data-role="shape"><option value="rect">Rectangle</option><option value="ellipse">Circle / ellipse</option></select></label>
      <label class="region-blur-strength"><span>Blur strength <strong data-role="strength-value">8</strong></span><input data-role="strength" type="range" min="1" max="20" value="8" /></label>
      <label><span>Output</span><select data-role="output"><option value="source">Same as source</option><option value="png">PNG</option><option value="jpg">JPG</option><option value="webp">WebP</option></select></label>
      <label><span>Quality <strong data-role="quality-value">92</strong></span><input data-role="quality" type="range" min="80" max="100" value="92" /></label>
      <div class="region-blur-presets"><span>Strength</span><button type="button" data-strength="4">Subtle</button><button type="button" data-strength="8">Privacy</button><button type="button" data-strength="14">Strong</button><button type="button" data-role="reset-selection">Reset selection</button></div>
    </div>
    <div class="region-blur-preview-grid">
      <article class="region-blur-panel"><header><div><span>Before</span><strong>Drag or resize the blur region</strong></div><small data-role="selection-meta">Selection ready</small></header><div class="region-blur-canvas-wrap"><canvas data-role="source-canvas"></canvas><canvas class="region-blur-overlay" data-role="overlay-canvas" aria-label="Selected blur region"></canvas></div></article>
      <article class="region-blur-panel"><header><div><span>After</span><strong>Blur preview</strong></div><small data-role="result-meta">Run blur to preview</small></header><div class="region-blur-result-wrap"><canvas data-role="result-canvas"></canvas><div data-role="result-empty"><span>Result preview</span><small>The processed result appears here.</small></div></div></article>
    </div>
    <div class="region-blur-status"><span data-role="status">Move the selection over a face, plate, screen, address, or other detail you want to obscure.</span></div>
    <div class="region-blur-actions"><button class="secondary-button" data-role="cancel" type="button" hidden>Cancel</button><button class="primary-button" data-role="run" type="button">Blur selected region</button><button class="secondary-button" data-role="download" type="button" disabled>Download result</button></div>
    <p class="region-blur-policy">This tool obscures only the region you select. Blur reduces visual readability but is not a guarantee that sensitive information cannot be recovered from another copy or source.</p>
  </section>
</div>
<script>
  import '../scripts/region-blur-editor';
</script>
<style>
  .region-blur-editor{overflow:hidden;border:1px solid #303746;border-radius:22px;background:#121821;box-shadow:0 22px 60px rgba(0,0,0,.18)}.region-blur-topbar{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 20px;border-bottom:1px solid #303746;background:#171c27}.region-blur-topbar>div{display:grid;gap:2px}.region-blur-topbar span{color:#a99fff;font-size:10px;font-weight:850;letter-spacing:.11em;text-transform:uppercase}.region-blur-topbar strong{color:#f3f5fb;font-size:15px}.region-blur-local{display:flex!important;align-items:center;gap:7px;color:#62d6a2!important;font-size:12px!important;letter-spacing:0!important;text-transform:none!important}.region-blur-local i{width:8px;height:8px;border-radius:50%;background:#21bd7b;box-shadow:0 0 0 5px rgba(33,189,123,.12)}
  .region-blur-notice{margin:12px 18px 0;padding:10px 12px;border:1px solid #6d5931;border-radius:11px;background:#211c13;color:#e1c27b;font-size:11px}.region-blur-upload{padding:18px}.region-blur-drop{width:100%;min-height:290px;display:grid;place-items:center;align-content:center;gap:12px;padding:30px;border:1.5px dashed #465064;border-radius:18px;background:#0f151e;color:inherit;cursor:pointer}.region-blur-drop>strong{color:#f4f5fa;font-size:28px}.region-blur-drop>span:not(.primary-button),.region-blur-drop small{color:#989faf}.region-blur-upload-icon{width:48px;height:48px;display:grid;place-items:center;border:1px solid #384152;border-radius:14px;background:#181e29;color:#e8e6ff!important;font-size:28px}
  .region-blur-workspace{padding:18px}.region-blur-header{display:flex;align-items:end;justify-content:space-between;gap:16px;padding:4px 4px 16px}.region-blur-header>div:first-child{display:grid;gap:3px}.region-blur-header span{color:#a69cff;font-size:10px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.region-blur-header strong{color:#f3f5fb;font-size:20px}.region-blur-header small{color:#8992a3}.region-blur-header>div:last-child{display:flex;gap:14px}.region-blur-header button{border:0;background:none;color:#b7b0ff;cursor:pointer;font:inherit;font-size:12px;font-weight:750}
  .region-blur-settings{display:grid;grid-template-columns:1fr 1.4fr 1fr 1.2fr;gap:10px;padding:14px;border:1px solid #32394a;border-radius:16px;background:#171c27}.region-blur-settings label{display:grid;gap:7px;color:#aeb4c2;font-size:11px;font-weight:750}.region-blur-settings label>span{display:flex;justify-content:space-between}.region-blur-settings select{height:42px;border:1px solid #3a4354;border-radius:10px;background:#111720;color:#f0f2f7;padding:0 12px}.region-blur-settings input[type=range]{width:100%;accent-color:#756cff}.region-blur-presets{grid-column:1/-1;display:flex;align-items:center;flex-wrap:wrap;gap:6px}.region-blur-presets span{margin-right:3px;color:#858d9d;font-size:10px;font-weight:750}.region-blur-presets button{min-height:30px;padding:0 10px;border:1px solid #343c4c;border-radius:8px;background:#121821;color:#aeb5c3;cursor:pointer;font:inherit;font-size:10px;font-weight:720}
  .region-blur-preview-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.region-blur-panel{overflow:hidden;border:1px solid #2e3644;border-radius:14px;background:#0f151e}.region-blur-panel>header{min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px;border-bottom:1px solid #272e3a}.region-blur-panel>header>div{display:grid;gap:2px}.region-blur-panel>header span{color:#948cff;font-size:9px;font-weight:800;text-transform:uppercase}.region-blur-panel>header strong{color:#eef0f5;font-size:11px}.region-blur-panel>header small{color:#858d9d;font-size:9px}.region-blur-canvas-wrap,.region-blur-result-wrap{position:relative;min-height:360px;display:grid;place-items:center;padding:14px;background:repeating-conic-gradient(#151b25 0 25%,#10161f 0 50%) 50%/22px 22px}.region-blur-canvas-wrap canvas,.region-blur-result-wrap canvas{display:block;max-width:100%;max-height:520px;width:auto;height:auto}.region-blur-overlay{position:absolute;inset:14px;margin:auto;cursor:crosshair;touch-action:none}.region-blur-result-wrap>[data-role=result-empty]{position:absolute;inset:0;display:grid;place-items:center;align-content:center;gap:5px;text-align:center;color:#8992a3}.region-blur-result-wrap>[data-role=result-empty] span{color:#b5bac5;font-weight:750}
  .region-blur-status{margin-top:12px;padding:10px 12px;border:1px solid #303746;border-radius:10px;background:#141a24;color:#9ba3b2;font-size:11px}.region-blur-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.region-blur-policy{margin:12px 2px 0;color:#7f8796;font-size:10px;line-height:1.5}.primary-button,.secondary-button{border:0;border-radius:12px;cursor:pointer;font:inherit;font-weight:800}.primary-button{min-height:44px;padding:0 20px;background:linear-gradient(135deg,#766dff,#6359ef);color:#fff}.secondary-button{min-height:40px;padding:0 18px;border:1px solid #3a4354;background:#1a202b;color:#e7e9f0}.primary-button:disabled,.secondary-button:disabled{opacity:.55;cursor:not-allowed}
  @media(max-width:900px){.region-blur-settings{grid-template-columns:1fr 1fr}.region-blur-preview-grid{grid-template-columns:1fr}.region-blur-canvas-wrap,.region-blur-result-wrap{min-height:320px}}@media(max-width:600px){.region-blur-topbar,.region-blur-header{align-items:flex-start;flex-direction:column}.region-blur-workspace{padding:12px}.region-blur-settings{grid-template-columns:1fr}.region-blur-preview-grid{gap:10px}.region-blur-canvas-wrap,.region-blur-result-wrap{min-height:260px;padding:10px}.region-blur-overlay{inset:10px}.region-blur-actions{flex-direction:column}.region-blur-actions button{width:100%}}
</style>
