---
import type { ImageToolDefinition } from '../platform/image-tools/types';
import ImageBatchDropzone from '../image-tools/components/ImageBatchDropzone.astro';
import ImageBatchProgress from '../image-tools/components/ImageBatchProgress.astro';
import ImageBatchActionBar from '../image-tools/components/ImageBatchActionBar.astro';

interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const accept = tool.acceptedExtensions.map((extension) => `.${extension}`).join(',');
const maxFiles = tool.maxFiles ?? 50;
const maxFileMb = Math.max(1, Math.round(tool.maxFileBytes / (1024 * 1024)));
---

<div class="image-editor-card metadata-cleaner" data-image-tool-app data-tool-id={tool.id} data-download-suffix={tool.downloadSuffix} data-max-file-bytes={tool.maxFileBytes} data-max-pixels={tool.maxPixels} data-max-dimension={tool.maxDimension} data-max-files={maxFiles} data-has-items="false">
  <div class="image-editor-topbar"><div><span>Privacy utility</span><strong>{tool.displayName}</strong></div><div class="image-editor-local-state"><span aria-hidden="true"></span>Browser-only</div></div>
  <div class="image-editor-notice" data-role="notice" role="status" aria-live="polite" hidden></div>

  <section class="metadata-upload" data-role="upload-view">
    <ImageBatchDropzone accept={accept} maxFiles={maxFiles} maxFileMb={maxFileMb} />
  </section>

  <section class="metadata-app" data-role="metadata-workspace" hidden>
    <header class="metadata-header">
      <div><span>Images</span><strong><span data-role="batch-count">0</span> selected</strong><small>Metadata removal applies to every image by default.</small></div>
      <div class="metadata-header__actions"><button type="button" data-role="add-more">+ Add images</button><button type="button" data-role="clear-all">Clear all</button></div>
    </header>

    <div class="metadata-grid">
      <section class="metadata-files" aria-label="Selected images">
        <div class="metadata-files__heading"><div><span>Privacy scan</span><strong>Metadata found</strong></div><span class="metadata-scan-summary" data-role="scan-summary">Scanning…</span></div>
        <div class="metadata-list" data-role="batch-list"></div>
      </section>

      <section class="metadata-settings" aria-label="Clean output settings">
        <div class="metadata-settings__heading"><div><span>Output</span><strong>Clean copies</strong></div><span class="metadata-safe-badge">Metadata stripped on output</span></div>
        <div class="metadata-setting-grid">
          <label><span>Output format</span><select data-role="shared-format"><option value="source">Same as source</option><option value="jpg">JPG</option><option value="webp">WebP</option><option value="png">PNG</option></select></label>
          <label><span>Quality</span><div class="metadata-range"><input data-role="shared-quality" type="range" min="1" max="100" value="92" /><output data-role="shared-quality-value">92</output></div></label>
        </div>
        <div class="metadata-removes"><strong>Removed from generated copies</strong><div><span>GPS / location</span><span>Camera & lens</span><span>Date & time</span><span>Software tags</span><span>EXIF / XMP / text</span><span>Embedded profiles*</span></div><small>*Browser re-encoding may also replace embedded color-profile metadata. Visible pixels are preserved as closely as browser encoding allows.</small></div>
        <details class="metadata-advanced" data-role="advanced-panel"><summary>Advanced per-file output</summary><p>Select an image on the left, then override its output format or quality. Metadata removal itself always remains enabled.</p><div class="metadata-setting-grid"><label><span>Selected image format</span><select data-role="item-format" disabled><option value="shared">Use shared setting</option><option value="source">Same as source</option><option value="jpg">JPG</option><option value="webp">WebP</option><option value="png">PNG</option></select></label><label><span>Selected image quality</span><div class="metadata-range"><input data-role="item-quality" type="range" min="1" max="100" value="92" disabled /><output data-role="item-quality-value">92</output></div></label></div><button type="button" data-role="reset-item" disabled>Reset selected image to shared settings</button></details>
        <div class="metadata-note"><strong>No image preview is needed.</strong><p>This utility changes metadata, not the visible composition. It decodes the image pixels and creates a fresh file without copying common metadata blocks.</p></div>
      </section>
    </div>

    <ImageBatchProgress total={0} />
    <ImageBatchActionBar processLabel="Remove metadata" downloadLabel="Download cleaned files" />
  </section>
  <p class="image-tool-policy-note">{tool.policyNote}</p>
</div>

<script src="../client/image-tool-app.ts"></script>

<style is:global>
.metadata-cleaner{padding:18px}.metadata-app{display:grid;gap:16px}.metadata-header{display:flex;justify-content:space-between;gap:16px;align-items:center}.metadata-header>div:first-child{display:grid;gap:3px}.metadata-header span,.metadata-files__heading span,.metadata-settings__heading span{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#929bad}.metadata-header small{color:#8992a3}.metadata-header__actions{display:flex;gap:8px;flex-wrap:wrap}.metadata-header button,.metadata-advanced button{border:1px solid #323a48;border-radius:8px;background:#151b24;color:#dfe4ed;padding:7px 10px;cursor:pointer}.metadata-grid{display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);gap:16px;align-items:start}.metadata-files,.metadata-settings{padding:14px;border:1px solid #303744;border-radius:12px;background:#10151e}.metadata-files{display:grid;gap:12px}.metadata-files__heading,.metadata-settings__heading{display:flex;justify-content:space-between;gap:12px;align-items:center}.metadata-files__heading>div,.metadata-settings__heading>div{display:grid;gap:2px}.metadata-scan-summary{font-size:11px!important;text-transform:none!important;letter-spacing:0!important}.metadata-list{display:grid;gap:8px}.metadata-file{display:grid;grid-template-columns:46px minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px;border:1px solid #303744;border-radius:10px;background:#11161f;cursor:pointer}.metadata-file.is-active{border-color:#7c73ff;box-shadow:0 0 0 1px rgba(124,115,255,.35)}.metadata-file img{width:46px;height:46px;object-fit:cover;border-radius:7px}.metadata-file__copy{display:grid;gap:4px;min-width:0}.metadata-file__copy strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.metadata-file__copy small{color:#8d96a6}.metadata-tags{display:flex;gap:4px;flex-wrap:wrap}.metadata-tag{font-size:9px;padding:2px 5px;border:1px solid #465063;border-radius:99px;color:#aeb6c4}.metadata-tag--safe{border-color:#37664d;color:#8ed7ae}.metadata-tag--warn{border-color:#6a5735;color:#e7c57d}.metadata-file button{border:0;background:transparent;color:#8f98a8;font-size:18px;cursor:pointer}.metadata-settings{display:grid;gap:14px}.metadata-safe-badge{font-size:10px!important;text-transform:none!important;letter-spacing:0!important;padding:4px 8px;border:1px solid #37664d;border-radius:99px;color:#8ed7ae!important}.metadata-setting-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.metadata-setting-grid label{display:grid;gap:6px}.metadata-setting-grid label>span{font-size:11px;font-weight:700;color:#aeb6c4}.metadata-setting-grid select{width:100%;min-height:38px;border:1px solid #363f50;border-radius:8px;background:#0c1118;color:#eef1f6;padding:7px 9px}.metadata-range{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;align-items:center}.metadata-range output{min-width:34px;text-align:right;color:#aeb6c4;font-size:11px}.metadata-removes,.metadata-note{padding:12px;border-radius:9px;background:#0c1118;color:#aeb6c4}.metadata-removes>div{display:flex;gap:6px;flex-wrap:wrap;margin:9px 0}.metadata-removes>div span{padding:4px 7px;border:1px solid #343d4c;border-radius:99px;font-size:10px}.metadata-removes small,.metadata-note p,.metadata-advanced p{font-size:11px;line-height:1.5;color:#8992a3}.metadata-note p{margin:5px 0 0}.metadata-advanced{border-top:1px solid #2c3441;padding-top:12px}.metadata-advanced summary{cursor:pointer;font-weight:700;color:#cdd3dd}.metadata-advanced[open]{display:grid;gap:12px}.metadata-cleaner[data-has-items="false"] .metadata-app{display:none}.metadata-cleaner[data-has-items="true"] .metadata-upload{display:none}@media(max-width:820px){.metadata-grid{grid-template-columns:1fr}.metadata-header,.metadata-files__heading,.metadata-settings__heading{align-items:stretch;flex-direction:column}.metadata-setting-grid{grid-template-columns:1fr}}
</style>
