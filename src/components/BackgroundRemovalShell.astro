---
import type { ImageToolDefinition } from '../platform/image-tools/types';
import ImageBatchShell from '../image-tools/components/ImageBatchShell.astro';
import ImageBatchDropzone from '../image-tools/components/ImageBatchDropzone.astro';
import ImageEditScopeSwitch from '../image-tools/components/ImageEditScopeSwitch.astro';
import ImagePreviewPanel from '../image-tools/components/ImagePreviewPanel.astro';
import ImageBatchProgress from '../image-tools/components/ImageBatchProgress.astro';
import ImageBatchActionBar from '../image-tools/components/ImageBatchActionBar.astro';
import ImageToolHeaderActions from '../image-tools/components/ImageToolHeaderActions.astro';

interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const accept = tool.acceptedExtensions.map((extension) => `.${extension}`).join(',');
const maxFiles = tool.maxFiles ?? 50;
const maxFileMb = Math.max(1, Math.round(tool.maxFileBytes / (1024 * 1024)));
---
<div
  class="image-editor-card background-removal-tool"
  data-image-tool-app
  data-tool-id={tool.id}
  data-max-file-bytes={tool.maxFileBytes}
  data-max-pixels={tool.maxPixels}
  data-max-dimension={tool.maxDimension}
  data-max-files={maxFiles}
  data-has-items="false"
>
  <div class="image-editor-topbar">
    <div><span>Local AI image tool</span><strong>{tool.displayName}</strong></div>
    <div class="image-editor-local-state"><span aria-hidden="true"></span>No image upload</div>
  </div>
  <div class="image-editor-notice" data-role="notice" role="status" aria-live="polite" hidden></div>

  <ImageBatchShell>
    <div slot="header" class="background-header">
      <div><span>Images</span><strong><span data-role="batch-count">0</span> images</strong><small data-role="mode-summary">One cutout setup applies to the whole batch.</small></div>
      <ImageToolHeaderActions />
    </div>

    <div slot="upload"><ImageBatchDropzone accept={accept} maxFiles={maxFiles} maxFileMb={maxFileMb} /></div>
    <ImageEditScopeSwitch slot="scope" mode="shared" />
    <div slot="queue" class="background-queue" data-role="batch-list" aria-label="Background removal batch"></div>

    <div slot="workspace" class="background-workspace">
      <section class="background-settings" aria-label="Background removal settings">
        <div class="background-settings__heading">
          <div><span>Cutout settings</span><strong>Refine the local AI mask</strong></div>
          <div class="background-settings__copy-actions"><button type="button" data-role="use-shared-settings" hidden>Use shared settings</button><button type="button" data-role="apply-current-to-all" hidden>Apply current to all</button></div>
        </div>
        <p class="background-model-status" data-role="model-status">Local AI runtime loads on first use (~18 MB) and is cached by the browser.</p>
        <div class="background-setting-grid">
          <label><span>Cutout level</span><div class="background-range"><input data-setting="threshold" type="range" min="15" max="85" value="50" /><output data-output-for="threshold">50%</output></div><small>Higher values remove more uncertain edge pixels.</small></label>
          <label><span>Edge feather</span><div class="background-range"><input data-setting="feather" type="range" min="0" max="30" value="8" /><output data-output-for="feather">8</output></div><small>Softens the transition around the generated subject mask.</small></label>
          <label><span>Background</span><select data-setting="background"><option value="transparent">Transparent</option><option value="white">White</option><option value="black">Black</option><option value="custom">Custom color</option></select></label>
          <label data-role="custom-color-wrap" hidden><span>Custom color</span><input data-setting="color" type="color" value="#ffffff" /></label>
        </div>
        <div class="background-setting-note"><strong>U²-NetP · browser-side inference</strong><p>Best on photos with a clear primary subject. Fine hair, transparent materials, shadows and low-contrast edges may need adjustment.</p></div>
      </section>
      <div class="background-preview-wrap"><ImagePreviewPanel beforeLabel="Original" afterLabel="Background removed" /></div>
    </div>

    <div slot="output" class="background-output-note"><strong>Output: PNG</strong><span>Transparent and solid-background results use PNG so alpha and edge detail are preserved.</span></div>
    <ImageBatchProgress slot="progress" total={0} />
    <ImageBatchActionBar slot="actions" processLabel="Remove backgrounds" downloadLabel="Download cutouts" />
  </ImageBatchShell>
  <p class="image-tool-policy-note">{tool.policyNote}</p>
</div>
<script src="../client/image-tool-app.ts"></script>
<style is:global>
.background-removal-tool{padding:18px}.background-header{display:flex;justify-content:space-between;gap:14px;align-items:center}.background-header>div:first-child,.background-settings__heading>div:first-child{display:grid;gap:3px}.background-header span,.background-settings__heading span,.background-setting-grid label>span{font-size:11px;text-transform:uppercase;letter-spacing:.045em;color:#929bad}.background-header small{color:#8992a3}.background-settings__copy-actions{display:flex;gap:8px;flex-wrap:wrap}.background-settings button{border:1px solid #303744;border-radius:8px;background:#151b24;color:#e8ebf1;padding:7px 10px;cursor:pointer}.background-queue{display:grid;gap:8px}.background-file-card{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:10px;align-items:center;padding:8px;border:1px solid #303744;border-radius:10px;background:#11161f;cursor:pointer}.background-file-card.is-active{border-color:#7c73ff;box-shadow:0 0 0 1px rgba(124,115,255,.3)}.background-file-card img{width:52px;height:52px;object-fit:cover;border-radius:7px}.background-file-card__copy{display:grid;gap:3px;min-width:0}.background-file-card__copy strong,.background-file-card__copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.background-file-card__copy small{color:#8d96a6}.background-badge{justify-self:start;font-size:9px;padding:2px 5px;border:1px solid #465063;border-radius:99px;color:#aeb6c4}.background-badge.custom{border-color:#766ef0;color:#c5c0ff}.background-file-remove{border:0;background:transparent;color:#8f98a8;font-size:19px;cursor:pointer}.background-workspace{display:grid;gap:16px}.background-settings{display:grid;gap:12px;padding:14px;border:1px solid #303744;border-radius:12px;background:#10151e}.background-settings__heading{display:flex;justify-content:space-between;gap:12px;align-items:center}.background-model-status{margin:0;padding:9px 10px;border-radius:8px;background:#0c1118;color:#9da6b5;font-size:11px}.background-setting-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.background-setting-grid label{display:grid;gap:6px}.background-setting-grid select,.background-setting-grid input[type="color"]{width:100%;box-sizing:border-box;min-height:38px;border:1px solid #363f50;border-radius:8px;background:#0c1118;color:#eef1f6;padding:6px 8px}.background-setting-grid input[type="color"]{padding:3px}.background-setting-grid small{font-size:10px;color:#858fa0;line-height:1.4}.background-range{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;align-items:center}.background-range output{min-width:42px;text-align:right;font-size:11px;color:#aeb6c4}.background-setting-note{padding:11px;border:1px solid #283140;border-radius:9px;background:#0c1118;color:#aeb6c4}.background-setting-note p{margin:5px 0 0;font-size:11px;line-height:1.5}.background-output-note{display:flex;justify-content:space-between;gap:12px;padding:11px 12px;border:1px solid #303744;border-radius:10px;color:#aeb6c4;font-size:11px}.background-preview-wrap .image-preview-panel__frame{background-color:#11161f;background-image:linear-gradient(45deg,rgba(255,255,255,.045) 25%,transparent 25%),linear-gradient(-45deg,rgba(255,255,255,.045) 25%,transparent 25%),linear-gradient(45deg,transparent 75%,rgba(255,255,255,.045) 75%),linear-gradient(-45deg,transparent 75%,rgba(255,255,255,.045) 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0}.background-removal-tool[data-has-items="false"] .image-batch-shell__scope,.background-removal-tool[data-has-items="false"] .image-batch-shell__workspace,.background-removal-tool[data-has-items="false"] .image-batch-shell__output,.background-removal-tool[data-has-items="false"] .image-batch-shell__progress,.background-removal-tool[data-has-items="false"] .image-batch-shell__actions,.background-removal-tool[data-has-items="false"] .background-header{display:none}.background-removal-tool[data-has-items="true"] .image-batch-shell__upload{display:none}@media(max-width:720px){.background-header,.background-settings__heading,.background-output-note{align-items:stretch;flex-direction:column}.background-setting-grid{grid-template-columns:1fr}.background-file-card{grid-template-columns:44px minmax(0,1fr) auto}.background-file-card img{width:44px;height:44px}}
</style>