---
import { NAV_ITEMS, SITE } from '../config/site';
const currentPath = Astro.url.pathname;
const imageToolPaths = ['/image-tools/', '/resize-image/', '/compress-image/', '/crop-image/', '/rotate-image/', '/image-background/', '/blur-image/', '/image-metadata/', '/bulk-rename-images/', '/remove-object/', '/remove-watermark/', '/gemini-ai-logo-remover/'];
const imageToolsActive = imageToolPaths.includes(currentPath);
const converterPaths = ['/image-converter/', '/data-converter/', '/archive-converter/', '/subtitle-converter/'];
const convertersActive = converterPaths.includes(currentPath);
const featuredImageTools = [
  { href: '/resize-image/', name: 'Resize Image', detail: 'Dimensions · batch · presets', icon: 'R' },
  { href: '/compress-image/', name: 'Compress Image', detail: 'Quality · format · size', icon: 'C' },
  { href: '/remove-watermark/', name: 'Remove Watermark', detail: 'Batch · shapes · text mask', icon: 'W' },
  { href: '/gemini-ai-logo-remover/', name: 'Gemini Watermark Remover', detail: 'Visible mark · Circle · Star', icon: '✦', spark: true },
];
---
<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>{SITE.name}</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {NAV_ITEMS.map((item) => item.label === 'Image Tools' ? (
        <details class:list={['nav-dropdown', imageToolsActive && 'is-current']}>
          <summary>
            <span>Image Tools</span>
            <svg class="nav-dropdown-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
          </summary>
          <div class="nav-submenu">
            <a class:list={['nav-submenu-overview', currentPath === '/image-tools/' && 'is-current']} href="/image-tools/">
              <span>All Image Tools</span>
              <span aria-hidden="true">→</span>
            </a>
            {featuredImageTools.map((tool) => (
              <a class:list={['nav-tool-link', currentPath === tool.href && 'is-current']} href={tool.href}>
                <span class:list={['nav-tool-icon', tool.spark && 'nav-tool-icon--spark']} aria-hidden="true">{tool.icon}</span>
                <span class="nav-tool-copy"><strong>{tool.name}</strong><small>{tool.detail}</small></span>
              </a>
            ))}
          </div>
        </details>
      ) : <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="privacy-chip" href="/privacy/"><span aria-hidden="true"></span>Private by design</a>

    <details class="mobile-nav">
      <summary><span class="mobile-nav-icon" aria-hidden="true"><span></span><span></span><span></span></span><span>Menu</span></summary>
      <nav class="mobile-menu" aria-label="Mobile navigation">
        <details class:list={['mobile-menu-section', convertersActive && 'is-current']} open={convertersActive}>
          <summary class="mobile-menu-row">
            <span>Converters</span>
            <span class="mobile-menu-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="mobile-menu-submenu">
            <a class:list={['mobile-menu-subitem', currentPath === '/image-converter/' && 'is-current']} href="/image-converter/">Image Converter</a>
            <a class:list={['mobile-menu-subitem', currentPath === '/data-converter/' && 'is-current']} href="/data-converter/">Data Converter</a>
            <a class:list={['mobile-menu-subitem', currentPath === '/archive-converter/' && 'is-current']} href="/archive-converter/">Archive Converter</a>
            <a class:list={['mobile-menu-subitem', currentPath === '/subtitle-converter/' && 'is-current']} href="/subtitle-converter/">Subtitle Converter</a>
          </div>
        </details>

        <details class:list={['mobile-menu-section', imageToolsActive && 'is-current']} open={imageToolsActive}>
          <summary class="mobile-menu-row">
            <span>Image Tools</span>
            <span class="mobile-menu-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="mobile-menu-submenu">
            <a class:list={['mobile-menu-subitem', currentPath === '/image-tools/' && 'is-current']} href="/image-tools/">All Image Tools</a>
            {featuredImageTools.map((tool) => <a class:list={['mobile-menu-subitem', currentPath === tool.href && 'is-current']} href={tool.href}>{tool.name}</a>)}
          </div>
        </details>

        {NAV_ITEMS.filter((item) => item.label !== 'Converters' && item.label !== 'Image Tools').map((item) => (
          <a class="mobile-menu-row mobile-menu-link" href={item.href}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown'));
  const closeDesktopDropdowns = (except?: HTMLDetailsElement) => {
    for (const dropdown of dropdowns) if (dropdown !== except) dropdown.removeAttribute('open');
  };

  for (const dropdown of dropdowns) {
    dropdown.addEventListener('toggle', () => {
      if (dropdown.open) closeDesktopDropdowns(dropdown);
    });
    dropdown.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => dropdown.removeAttribute('open')));
  }

  const mobileSections = Array.from(document.querySelectorAll<HTMLDetailsElement>('.mobile-menu-section'));
  for (const section of mobileSections) {
    section.addEventListener('toggle', () => {
      if (!section.open) return;
      for (const other of mobileSections) if (other !== section) other.removeAttribute('open');
    });
  }

  document.addEventListener('pointerdown', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (!dropdowns.some((dropdown) => dropdown.contains(target))) closeDesktopDropdowns();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDesktopDropdowns();
  });
</script>

<style>
  .nav-dropdown { position: relative; }
  .nav-dropdown > summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 34px;
    color: #a5abba;
    font-size: 14px;
    font-weight: 680;
    cursor: pointer;
    list-style: none;
    transition: color .15s ease;
  }
  .nav-dropdown > summary::-webkit-details-marker { display: none; }
  .nav-dropdown > summary:hover,
  .nav-dropdown[open] > summary,
  .nav-dropdown:focus-within > summary,
  .nav-dropdown.is-current > summary { color: #f5f6fb; }
  .nav-dropdown-chevron {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .15s ease;
  }
  .nav-dropdown[open] .nav-dropdown-chevron { transform: rotate(180deg); }

  .nav-submenu {
    position: absolute;
    left: 50%;
    top: calc(100% + 10px);
    z-index: 80;
    width: 310px;
    display: none;
    gap: 4px;
    padding: 8px;
    border: 1px solid #303746;
    border-radius: 15px;
    background: rgba(17, 22, 31, .98);
    box-shadow: 0 22px 55px rgba(0, 0, 0, .38);
    transform: translateX(-50%);
    backdrop-filter: blur(18px);
  }
  .nav-submenu::before { content: ''; position: absolute; left: 0; right: 0; top: -11px; height: 11px; }
  .nav-dropdown:hover > .nav-submenu,
  .nav-dropdown:focus-within > .nav-submenu,
  .nav-dropdown[open] > .nav-submenu { display: grid; }

  .main-nav .nav-submenu a { color: #aeb4c2; }
  .nav-submenu-overview { display:flex;align-items:center;justify-content:space-between;min-height:36px;padding:7px 9px 9px;border-bottom:1px solid #272e3a;font-size:11px!important;font-weight:690!important; }
  .nav-submenu-overview:hover,.nav-submenu-overview.is-current { color:#f3f5fb!important; }
  .nav-tool-link { display:grid;grid-template-columns:36px minmax(0,1fr);align-items:center;gap:10px;min-height:56px;padding:8px 9px;border-radius:10px; }
  .nav-tool-link:hover,.nav-tool-link.is-current { background:#1a202c;color:#f3f5fb!important; }
  .nav-tool-link.is-current { box-shadow:inset 0 0 0 1px rgba(124,115,255,.2); }
  .nav-tool-icon { width:36px;height:36px;display:grid;place-items:center;border:1px solid #373f50;border-radius:10px;background:#151b25;color:#b2accf;font-size:12px;font-weight:760; }
  .nav-tool-icon--spark { color:#aaa4ff;font-size:18px; }
  .nav-tool-copy { min-width:0;display:grid;gap:2px; }
  .nav-tool-copy strong { overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#eef0f6;font-size:12px;font-weight:690; }
  .nav-tool-copy small { color:#858d9d;font-size:9.75px;line-height:1.35; }

  .mobile-menu,.mobile-menu * { font-family:inherit;font-style:normal;letter-spacing:normal;text-transform:none; }
  .mobile-menu-section { width:100%;margin:0;padding:0;border:0;background:transparent;box-shadow:none; }
  .mobile-menu-row { width:100%;min-height:46px;display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:#b9beca;font-size:15px!important;font-weight:720!important;line-height:1.2!important;text-decoration:none;cursor:pointer;list-style:none;box-sizing:border-box; }
  .mobile-menu-section > summary::-webkit-details-marker { display:none; }
  .mobile-menu-link { display:flex!important; }
  .mobile-menu-row:hover,.mobile-menu-section.is-current > .mobile-menu-row { color:#f4f5fa; }
  .mobile-menu-chevron { flex:0 0 auto;color:#858c9c;font-size:13px!important;font-weight:700!important;line-height:1!important;transition:transform .15s ease; }
  .mobile-menu-section[open] .mobile-menu-chevron { transform:rotate(180deg); }
  .mobile-menu-submenu { display:grid;gap:0;margin:0 0 6px 8px;padding:2px 0 3px 15px;border-left:1px solid #343b4a; }
  .mobile-menu-subitem { min-height:36px!important;display:flex!important;align-items:center;margin:0!important;padding:5px 0!important;border:0!important;border-radius:0!important;background:transparent!important;color:#8f96a6!important;font-size:12.5px!important;font-weight:650!important;line-height:1.25!important;text-decoration:none; }
  .mobile-menu-subitem:hover,.mobile-menu-subitem.is-current { color:#f1f0ff!important; }

  @media (max-width:980px) {
    .nav-submenu { width:286px; }
    .mobile-nav > nav.mobile-menu > a.mobile-menu-row,
    .mobile-nav > nav.mobile-menu > details.mobile-menu-section > summary.mobile-menu-row { min-height:46px!important;padding:0!important;font-size:15px!important;font-weight:720!important;line-height:1.2!important;color:#b9beca!important;background:transparent!important;border:0!important;box-shadow:none!important; }
    .mobile-nav > nav.mobile-menu > a.mobile-menu-row:hover,
    .mobile-nav > nav.mobile-menu > details.mobile-menu-section.is-current > summary.mobile-menu-row { color:#f4f5fa!important; }
  }
</style>