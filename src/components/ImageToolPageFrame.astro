---
import type { ImageToolDefinition, MaskImageToolDefinition } from '../platform/image-tools/types';
import { SITE } from '../config/site';
import { getImageToolManifest } from '../config/image-tools';
import BatchMaskEditorShell from './BatchMaskEditorShell.astro';
import BulkRenameImageShell from './BulkRenameImageShell.astro';
import DeterministicImageToolShell from './DeterministicImageToolShell.astro';
import FadeImageEdgesV2Shell from './FadeImageEdgesV2Shell.astro';
import MetadataCleanupShell from './MetadataCleanupShell.astro';
import AddWatermarkShell from './AddWatermarkShell.astro';
import ImageUtilityWorkbench from './ImageUtilityWorkbench.astro';
import type { AdvancedImageTool } from '../config/image-advanced-tools';
import AdvancedImageToolWorkbench from './AdvancedImageToolWorkbench.astro';
interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const entry = getImageToolManifest(tool.id);
if (!entry) throw new Error(`Image tool is missing from the catalog: ${tool.id}`);
const maskTool = entry.runtime === 'mask' ? tool as MaskImageToolDefinition : undefined;
const usesRenameEditor = entry.runtime === 'rename';
const usesMetadataCleanup = entry.runtime === 'metadata';
const usesEdgeFadeV2 = entry.runtime === 'edge-fade';
const usesWatermarkEditor = entry.runtime === 'watermark';
const usesUtility = entry.runtime === 'utility';
const usesAdvanced = entry.runtime === 'advanced';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Image Tools', item: `${SITE.origin}/image-tools/` },
    { '@type': 'ListItem', position: 3, name: tool.displayName, item: `${SITE.origin}/${tool.slug}/` },
  ],
};
// Gemini already carries a hand-tuned breadcrumb schema in its page content.
const includeBreadcrumbSchema = tool.id !== 'gemini-ai-logo-remover';
---
{includeBreadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
<section class="converter-page-hero image-tool-page-hero">
  <div class="site-container converter-page-hero-inner">
    <div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>{tool.displayName}</span></div>
    <span class="eyebrow converter-page-eyebrow">{tool.eyebrow}</span>
    <h1>{tool.h1}</h1>
    <p>{tool.intro}</p>
  </div>
</section>
<section class="image-tool-page-tool"><div class="site-container">{maskTool ? <BatchMaskEditorShell tool={maskTool} /> : usesRenameEditor ? <BulkRenameImageShell tool={tool} /> : usesMetadataCleanup ? <MetadataCleanupShell tool={tool} /> : usesEdgeFadeV2 ? <FadeImageEdgesV2Shell tool={tool} /> : usesWatermarkEditor ? <AddWatermarkShell tool={tool} /> : usesUtility ? <ImageUtilityWorkbench tool={tool} /> : usesAdvanced ? <AdvancedImageToolWorkbench tool={tool as AdvancedImageTool} /> : <DeterministicImageToolShell tool={tool} />}</div></section>
