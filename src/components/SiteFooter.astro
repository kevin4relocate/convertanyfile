---
import { FOOTER_GROUPS, SITE } from '../config/site';
---
<footer class="site-footer">
  <div class="site-container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>{SITE.name}</span>
      </a>
      <p>{SITE.tagline}</p>
      <span class="footer-note">Files are processed in your browser for supported local converters.</span>
    </div>
    {FOOTER_GROUPS.map((group) => (
      <div class="footer-links">
        <strong>{group.title}</strong>
        {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
        {group.title === 'Company' && <button type="button" class="footer-privacy-button" data-open-privacy-preferences>Privacy choices</button>}
      </div>
    ))}
  </div>
  <div class="site-container footer-bottom">
    <span>© 2026 {SITE.name}</span>
    <a href="/">{SITE.domain}</a>
  </div>
  <style>.footer-privacy-button{display:block;border:0;background:transparent;padding:0;color:inherit;font:inherit;text-align:left;cursor:pointer;text-decoration:underline;text-underline-offset:3px}.footer-privacy-button:focus-visible{outline:2px solid #b9a8ff;outline-offset:3px}</style>
</footer>
