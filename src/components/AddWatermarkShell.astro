---
import type { ImageToolDefinition } from '../platform/image-tools/types';
import ImageBatchDropzone from '../image-tools/components/ImageBatchDropzone.astro';
interface Props { tool: ImageToolDefinition; }
const { tool } = Astro.props;
const accept = tool.acceptedExtensions.map((extension) => `.${extension}`).join(',');
const maxFiles = tool.maxFiles ?? 50;
const maxFileMb = Math.max(1, Math.round(tool.maxFileBytes / (1024 * 1024)));
---
<div class="image-editor-card watermark-tool" data-image-tool-app data-tool-id={tool.id} data-max-file-bytes={tool.maxFileBytes} data-max-files={maxFiles} data-max-pixels={tool.maxPixels} data-max-dimension={tool.maxDimension} data-has-items="false">
  <div class="image-editor-topbar">
    <div><span>Local image tool</span><strong>{tool.displayName}</strong></div>
    <div class="image-editor-local-state"><span aria-hidden="true"></span>Processed on your device</div>
  </div>
  <div class="image-editor-notice" data-role="notice" role="status" aria-live="polite" hidden></div>

  <section class="watermark-upload" data-role="upload-section">
    <ImageBatchDropzone variant="standard" accept={accept} maxFiles={maxFiles} maxFileMb={maxFileMb} />
  </section>

  <section class="watermark-editor" data-role="editor" hidden>
    <header class="watermark-editor__header">
      <div><span>Images</span><strong><span data-role="batch-count">0</span> ready</strong><small>Choose an image to preview. The same watermark setup applies to the whole batch.</small></div>
      <div class="watermark-header-actions">
        <button type="button" class="secondary-button" data-role="add-more">Add more</button>
        <button type="button" class="secondary-button" data-role="clear-all">Clear</button>
      </div>
    </header>

    <div class="watermark-queue" data-role="batch-list" aria-label="Batch images"></div>

    <div class="watermark-workspace">
      <aside class="watermark-controls">
        <div class="watermark-controls__title"><span>Watermark</span><strong>Text or logo</strong></div>
        <div class="watermark-kind" role="group" aria-label="Watermark type">
          <button type="button" class="is-active" data-watermark-kind="text" aria-pressed="true">Text</button>
          <button type="button" data-watermark-kind="logo" aria-pressed="false">Logo</button>
        </div>

        <div class="watermark-text-controls" data-role="text-controls">
          <label><span>Text</span><input data-role="watermark-text" type="text" value="ConvertAnyFile" maxlength="120" /></label>
          <div class="watermark-grid-2">
            <label><span>Color</span><input data-role="watermark-color" type="color" value="#ffffff" /></label>
            <label class="watermark-check"><span>Style</span><span class="watermark-check__line"><input data-role="watermark-bold" type="checkbox" checked /> Bold</span></label>
          </div>
          <label><span>Text size <output data-role="text-size-output">5%</output></span><input data-role="text-size" type="range" min="2" max="20" value="5" /></label>
        </div>

        <div class="watermark-logo-controls" data-role="logo-controls" hidden>
          <label class="watermark-logo-upload"><span>Logo image</span><input data-role="logo-input" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" /><strong data-role="logo-name">Choose a PNG, JPG or WebP logo</strong></label>
          <label><span>Logo width <output data-role="logo-size-output">20%</output></span><input data-role="logo-size" type="range" min="5" max="70" value="20" /></label>
        </div>

        <label><span>Opacity <output data-role="opacity-output">70%</output></span><input data-role="watermark-opacity" type="range" min="5" max="100" value="70" /></label>

        <div class="watermark-position-note">
          <strong>Drag directly on the preview</strong>
          <small>Position is stored proportionally, so the same placement can be applied to images with different dimensions.</small>
        </div>
      </aside>

      <section class="watermark-preview">
        <div class="watermark-preview__head"><div><span>Preview</span><strong data-role="active-name">Select an image</strong></div><small>Drag the watermark to reposition it</small></div>
        <div class="watermark-canvas-wrap"><canvas data-role="preview-canvas" aria-label="Watermark preview"></canvas></div>
      </section>
    </div>

    <div class="watermark-actions" data-role="batch-action-bar">
      <div class="watermark-actions__summary"><strong data-role="ready-count">0 images ready</strong><small data-role="batch-result-summary">Preview your watermark, then apply it to all images.</small></div>
      <div class="watermark-actions__buttons">
        <button class="secondary-button" type="button" data-role="cancel-batch" hidden>Cancel</button>
        <button class="primary-button" type="button" data-role="process-batch">Apply watermark</button>
        <button class="secondary-button" type="button" data-role="download-batch" disabled>Download</button>
      </div>
    </div>
    <div class="watermark-progress" data-role="batch-progress" hidden><span data-role="progress-text">Processing…</span><progress data-role="progress-bar" value="0" max="1"></progress></div>
    <p class="image-tool-policy-note">{tool.policyNote}</p>
  </section>
</div>
<script src="../client/image-tool-app.ts"></script>
<style is:global>
.watermark-tool{padding:0}.watermark-upload{padding:8px 14px 14px}.watermark-editor{padding:8px 14px 14px}.watermark-editor__header{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:6px 2px 10px}.watermark-editor__header>div:first-child{display:grid;gap:2px}.watermark-editor__header span,.watermark-controls span,.watermark-preview span{color:#8e95a5;font-size:10px;font-weight:700;letter-spacing:.055em;text-transform:uppercase}.watermark-editor__header strong{font-size:15px}.watermark-editor__header small{color:#939aa9;font-size:10.5px}.watermark-header-actions,.watermark-actions__buttons{display:flex;gap:8px;flex-wrap:wrap}.watermark-queue{display:flex;gap:7px;overflow-x:auto;padding:0 0 10px}.watermark-card{min-width:210px;flex:0 0 210px;display:grid;grid-template-columns:54px minmax(0,1fr) 26px;gap:8px;align-items:center;padding:7px;border:1px solid #29313f;border-radius:11px;background:#10151e;cursor:pointer}.watermark-card.is-active{border-color:#655ed0;background:#17172a}.watermark-card img{width:54px;height:46px;object-fit:cover;border-radius:8px}.watermark-card__copy{min-width:0;display:grid;gap:2px}.watermark-card__copy strong,.watermark-card__copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.watermark-card__copy strong{font-size:11px}.watermark-card__copy small{font-size:9px;color:#858d9d}.watermark-remove{width:24px;height:24px;padding:0;border:1px solid #343c4d;border-radius:7px;background:#171c27;color:#9aa2b1;cursor:pointer}.watermark-workspace{display:grid;grid-template-columns:minmax(250px,320px) minmax(0,1fr);gap:12px}.watermark-controls,.watermark-preview{border:1px solid #2b3240;border-radius:13px;background:#10151e}.watermark-controls{display:grid;align-content:start;gap:13px;padding:14px}.watermark-controls__title{display:grid;gap:2px}.watermark-controls__title strong{font-size:13px}.watermark-kind{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:5px;border:1px solid #303747;border-radius:11px;background:#0c1118}.watermark-kind button{min-height:38px;border:1px solid transparent;border-radius:8px;background:transparent;color:#aab1bf;font:inherit;font-size:11px;font-weight:700;cursor:pointer}.watermark-kind button.is-active{border-color:#655ed0;background:#282442;color:#f4f2ff}.watermark-text-controls,.watermark-logo-controls{display:grid;gap:11px}.watermark-controls label{display:grid;gap:6px}.watermark-controls label>span:first-child{display:flex;justify-content:space-between;align-items:center}.watermark-controls input[type="text"]{min-height:40px;border:1px solid #363f50;border-radius:9px;background:#0c1118;color:#eef1f6;padding:8px 10px;font:inherit;font-size:11px}.watermark-controls input[type="range"]{width:100%;accent-color:#736bff}.watermark-controls input[type="color"]{width:100%;height:40px;padding:3px;border:1px solid #363f50;border-radius:9px;background:#0c1118}.watermark-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.watermark-check__line{min-height:40px;display:flex!important;justify-content:flex-start!important;gap:7px;align-items:center;padding:0 10px;border:1px solid #363f50;border-radius:9px;background:#0c1118;color:#d9dde5;font-size:11px!important;text-transform:none!important;letter-spacing:0!important}.watermark-logo-upload input{font-size:10px;color:#aab1bf}.watermark-logo-upload strong{font-size:10px;color:#d9dde5;font-weight:600}.watermark-position-note{display:grid;gap:4px;padding:10px;border:1px solid #2f3746;border-radius:10px;background:#0d121a}.watermark-position-note strong{font-size:10.5px}.watermark-position-note small{font-size:9.5px;color:#858d9d;line-height:1.4}.watermark-preview{display:grid;grid-template-rows:auto minmax(320px,1fr);min-width:0;padding:12px}.watermark-preview__head{display:flex;justify-content:space-between;gap:12px;align-items:end;padding:0 2px 10px}.watermark-preview__head>div{display:grid;gap:2px;min-width:0}.watermark-preview__head strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.watermark-preview__head small{font-size:9.5px;color:#858d9d}.watermark-canvas-wrap{min-height:320px;display:grid;place-items:center;overflow:hidden;border:1px solid #252d3a;border-radius:10px;background:#090d13}.watermark-canvas-wrap canvas{display:block;max-width:100%;max-height:520px;touch-action:none;cursor:grab}.watermark-canvas-wrap canvas.is-dragging{cursor:grabbing}.watermark-actions{display:flex;justify-content:space-between;gap:14px;align-items:center;margin-top:12px;padding:12px 13px;border:1px solid #2b3240;border-radius:12px;background:#10151e}.watermark-actions__summary{display:grid;gap:2px}.watermark-actions__summary strong{font-size:12px}.watermark-actions__summary small{font-size:9.5px;color:#858d9d}.watermark-progress{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;margin-top:8px;padding:8px 12px;font-size:10px}.watermark-progress progress{width:100%}.watermark-tool[data-has-items="true"] .watermark-upload{display:none}@media(max-width:800px){.watermark-workspace{grid-template-columns:1fr}.watermark-preview{grid-template-rows:auto minmax(260px,1fr)}.watermark-editor__header,.watermark-actions{align-items:stretch;flex-direction:column}}@media(max-width:520px){.watermark-editor{padding:8px 10px 10px}.watermark-grid-2{grid-template-columns:1fr}.watermark-card{min-width:190px;flex-basis:190px}.watermark-actions__buttons>*{flex:1 1 auto}}
</style>