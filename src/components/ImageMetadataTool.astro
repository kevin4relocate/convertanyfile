<div class="metadata-tool" data-image-metadata>
  <div class="metadata-topbar"><div><span>Local image tool</span><strong>Image Metadata Viewer</strong></div><em>Inspect locally</em></div>
  <div class="metadata-notice" data-role="notice" role="status" aria-live="polite">Viewing metadata does not change the file. Cleaning metadata creates a newly encoded copy, so keep important originals.</div>
  <div class="metadata-drop" data-role="dropzone" tabindex="0" role="button">
    <input data-role="file-input" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden />
    <span aria-hidden="true">ⓘ</span><strong>Choose an image to inspect</strong><p>JPG, PNG or WebP · up to 20 MB · no upload</p><button type="button" class="primary-button" data-role="choose">Choose image</button>
  </div>
  <div class="metadata-workspace" data-role="workspace" hidden>
    <div class="metadata-summary"><div><span>Selected image</span><strong data-role="filename"></strong><small data-role="filemeta"></small></div><button type="button" data-role="clear">Choose another</button></div>
    <div class="metadata-stats"><div><span>Profiles</span><strong data-role="profile-count">0</strong></div><div><span>Attributes</span><strong data-role="attribute-count">0</strong></div><div><span>Dimensions</span><strong data-role="dimensions">—</strong></div></div>
    <div class="metadata-cleaner">
      <label><input data-role="preserve-color" type="checkbox" checked /><span>Preserve ICC/ICM color profile when cleaning</span></label>
      <button type="button" class="primary-button" data-role="clean">Remove metadata</button>
    </div>
    <div class="metadata-result" data-role="result" hidden><span data-role="result-summary"></span><button type="button" class="secondary-button" data-role="download">Download cleaned image</button></div>
    <div class="metadata-grid">
      <section><h2>Profiles</h2><div data-role="profiles" class="metadata-list"></div></section>
      <section><h2>Attributes</h2><div data-role="attributes" class="metadata-list metadata-list--attributes"></div></section>
    </div>
  </div>
</div>
<script>import '../scripts/image-metadata-tool';</script>
<style>
.metadata-tool{overflow:hidden;border:1px solid #303746;border-radius:22px;background:#121821}.metadata-topbar{min-height:64px;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #303746;background:#171c27}.metadata-topbar>div{display:grid;gap:2px}.metadata-topbar span{color:#a99fff;font-size:10px;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.metadata-topbar strong{color:#f3f5fb;font-size:15px}.metadata-topbar em{color:#62d6a2;font-size:11px;font-style:normal;font-weight:750}.metadata-notice{margin:12px 18px 0;padding:10px 12px;border:1px solid #514a73;border-radius:11px;background:#171728;color:#b9b4df;font-size:11px;line-height:1.45}.metadata-drop{margin:18px;min-height:270px;display:grid;place-items:center;align-content:center;gap:12px;padding:30px;border:1.5px dashed #465064;border-radius:18px;background:#0f151e;text-align:center;cursor:pointer}.metadata-drop>span{font-size:32px;color:#cbc7ff}.metadata-drop>strong{color:#f4f5fa;font-size:27px}.metadata-drop p{margin:0;color:#9299a9;font-size:12px}.metadata-workspace{padding:18px}.metadata-summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:2px 3px 14px}.metadata-summary>div{min-width:0;display:grid;gap:3px}.metadata-summary span{color:#a69cff;font-size:10px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.metadata-summary strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#f3f5fb;font-size:18px}.metadata-summary small{color:#8f97a7;font-size:10px}.metadata-summary button{border:0;background:none;color:#aaa4ff;cursor:pointer;font:inherit;font-size:11px;font-weight:750}.metadata-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.metadata-stats>div{display:grid;gap:3px;padding:12px;border:1px solid #303847;border-radius:12px;background:#0f151e}.metadata-stats span{color:#858d9d;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.metadata-stats strong{color:#eef0f5;font-size:16px}.metadata-cleaner{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px;padding:12px;border:1px solid #32394a;border-radius:14px;background:#171c27}.metadata-cleaner label{display:flex;align-items:center;gap:8px;color:#aeb5c3;font-size:11px;font-weight:700}.metadata-cleaner input{width:16px;height:16px}.metadata-result{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px;padding:11px 12px;border:1px solid #285c49;border-radius:12px;background:#12211c}.metadata-result span{color:#78d9b2;font-size:11px}.metadata-grid{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:10px;margin-top:12px}.metadata-grid section{min-width:0;padding:12px;border:1px solid #2e3644;border-radius:14px;background:#0f151e}.metadata-grid h2{margin:0 0 9px;color:#eceef4;font-size:12px}.metadata-list{display:grid;gap:5px;max-height:380px;overflow:auto}.metadata-entry{display:grid;gap:2px;padding:7px 8px;border-radius:8px;background:#151b25}.metadata-entry strong{overflow-wrap:anywhere;color:#bbb6ef;font-size:10px}.metadata-entry span{overflow-wrap:anywhere;color:#8f97a7;font-size:9px;line-height:1.45}.metadata-empty{color:#737b8b;font-size:10px}.primary-button,.secondary-button{border:0;border-radius:12px;cursor:pointer;font:inherit;font-weight:800}.primary-button{min-height:42px;padding:0 18px;background:linear-gradient(135deg,#766dff,#6359ef);color:#fff}.secondary-button{min-height:38px;padding:0 15px;border:1px solid #3a4354;background:#1a202b;color:#e7e9f0}.primary-button:disabled,.secondary-button:disabled{opacity:.55;cursor:not-allowed}
@media(max-width:700px){.metadata-grid{grid-template-columns:1fr}.metadata-cleaner,.metadata-result{align-items:stretch;flex-direction:column}.metadata-cleaner button,.metadata-result button{width:100%}}
@media(max-width:520px){.metadata-topbar{align-items:flex-start;flex-direction:column;gap:4px}.metadata-drop{min-height:230px;margin:12px;padding:22px 14px}.metadata-drop>strong{font-size:22px}.metadata-workspace{padding:12px}.metadata-stats{grid-template-columns:1fr}.metadata-summary{align-items:flex-start;flex-direction:column}}
</style>
