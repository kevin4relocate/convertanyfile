---
import '../styles/global.css';
import '../styles/layout-fixes.css';
import '../styles/converter-pages.css';
import '../styles/product-polish.css';
import '../styles/dark-theme.css';
import '../styles/critical-dark-overrides.css';
import '../styles/image-tools.css';
import '../styles/image-tools-standard.css';
import '../styles/tool-sticky-actions.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PrivacyPreferences from '../components/PrivacyPreferences.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = `${SITE.name} — Fast, Private File Converter & Image Tools`,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.origin).toString(),
  noindex = false,
  schema,
} = Astro.props;
const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const isHomePage = Astro.url.pathname === '/';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: 'Convert Any File',
  url: SITE.origin,
  description: SITE.description,
  inLanguage: 'en',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e14" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content={SITE.name} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-card.png', SITE.origin).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ConvertAnyFile three-layer purple logo — Local-first file tools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/social-card.png', SITE.origin).toString()} />
    <meta name="twitter:image:alt" content="ConvertAnyFile — Local-first file tools" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <!-- AdSense site ownership verification: no advertising JavaScript is loaded
         until site approval and a suitable ad consent solution are configured. -->
    <meta name="google-adsense-account" content="ca-pub-4046271575630296" />
    <script is:inline>
      // Basic Consent Mode v2: GA4 does not load before explicit Analytics opt-in.
      (() => {
        const analyticsHosts = new Set(['convertanyfile.net', 'www.convertanyfile.net']);
        const isProduction = analyticsHosts.has(window.location.hostname);
        const consentKey = 'convertanyfile-analytics-consent-v1';
        const measurementId = 'G-LX78XZ9FH2';
        let selected = null;
        try {
          const stored = window.localStorage.getItem(consentKey);
          if (stored === 'granted' || stored === 'denied') selected = stored;
        } catch (_) { /* Browsers may disable storage; keep a session-only choice. */ }
        let gaLoaded = false;
        window.cafGetAnalyticsConsent = () => selected;
        if (isProduction) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('consent', 'default', {
            analytics_storage: 'denied', ad_storage: 'denied',
            ad_user_data: 'denied', ad_personalization: 'denied'
          });
        }
        const loadAnalytics = () => {
          if (!isProduction || gaLoaded) return;
          gaLoaded = true;
          window.gtag('js', new Date());
          window.gtag('config', measurementId);
          const tag = document.createElement('script');
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.appendChild(tag);
        };
        window.cafSetAnalyticsConsent = (allow) => {
          const wasGranted = selected === 'granted';
          selected = allow ? 'granted' : 'denied';
          try { window.localStorage.setItem(consentKey, selected); } catch (_) {}
          if (isProduction) window.gtag('consent', 'update', { analytics_storage: selected });
          if (allow) loadAnalytics();
          else if (wasGranted && gaLoaded) window.location.reload();
        };
        if (selected === 'granted') {
          if (isProduction) window.gtag('consent', 'update', { analytics_storage: 'granted' });
          loadAnalytics();
        }
      })();
    </script>
    {isHomePage && <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>}
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
    <style is:global>.nav-tool-status{display:none!important}</style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <PrivacyPreferences />
  </body>
</html>
