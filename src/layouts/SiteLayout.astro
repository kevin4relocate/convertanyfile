---
import '../styles/global.css';
import '../styles/layout-fixes.css';
import '../styles/converter-pages.css';
import '../styles/product-polish.css';
import '../styles/dark-theme.css';
import '../styles/critical-dark-overrides.css';
import '../styles/image-tools.css';
import '../styles/image-tools-standard.css';
import '../styles/tool-sticky-actions.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = `${SITE.name} — Fast, Private File Converter & Image Tools`,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.origin).toString(),
  noindex = false,
  schema,
} = Astro.props;
const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const isHomePage = Astro.url.pathname === '/';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: 'Convert Any File',
  url: SITE.origin,
  description: SITE.description,
  inLanguage: 'en',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e14" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content={SITE.name} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const analyticsHosts = new Set(['convertanyfile.net', 'www.convertanyfile.net']);
      if (analyticsHosts.has(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', 'G-LX78XZ9FH2');

        const analyticsScript = document.createElement('script');
        analyticsScript.async = true;
        analyticsScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-LX78XZ9FH2';
        document.head.appendChild(analyticsScript);
      }
    </script>
    {isHomePage && <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>}
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <SiteFooter />
  </body>
</html>
