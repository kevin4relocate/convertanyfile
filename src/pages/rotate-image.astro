---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageUtilityTool from '../components/ImageUtilityTool.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Rotate Image',url:`${SITE.origin}/rotate-image/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Rotate JPG, PNG and WebP images','Rotate 90, 180 or 270 degrees','Flip images horizontally or vertically','Batch processing up to 50 images','Local browser processing','ZIP batch download']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Rotate Image',item:`${SITE.origin}/rotate-image/`}]},
];
---
<SiteLayout title="Rotate Image Online Free — Rotate & Flip JPG, PNG, WebP | ConvertAnyFile" description="Rotate or flip JPG, PNG and WebP images free in your browser. Turn images 90, 180 or 270 degrees, mirror them horizontally or vertically, process batches locally, and download without source-image uploads." schema={schemas}>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Rotate Image</span></div><span class="eyebrow converter-page-eyebrow">Rotate / Flip · Preview</span><h1>Rotate and flip images online</h1><p>Rotate JPG, PNG and WebP images by 90, 180 or 270 degrees, flip them horizontally or vertically, and process a whole batch locally in your browser.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><ImageUtilityTool mode="rotate" /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Batch orientation fixes</span><h2>Rotate or mirror a whole set with one shared action.</h2><p>Choose a rotation angle, optionally flip the image horizontally or vertically, and apply the same transform across the batch. This is useful for scanned pages, imported photos, product shots and image sets that share the same orientation problem.</p></div><div class="content-summary-card"><strong>Auto-orientation first</strong><p>The browser worker normalizes embedded orientation before applying your requested transform, so the visible result is based on the image as it should be viewed rather than raw camera orientation flags.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Privacy</span><h2>The transform runs locally.</h2><p>Image bytes are decoded, rotated or flipped, re-encoded and packaged in your browser with the shared ImageMagick WebAssembly worker. Source images do not need to be uploaded to a conversion server.</p></div><div class="related-grid"><a class="related-card" href="/crop-image/">Crop Image <span>→</span></a><a class="related-card" href="/resize-image/">Resize Image <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
