---
import CoreImageToolPage from '../components/CoreImageToolPage.astro';
import { REMOVE_IMAGE_METADATA_TOOL } from '../config/image-tools';
---
<CoreImageToolPage
  tool={REMOVE_IMAGE_METADATA_TOOL}
  kicker="Private image cleanup"
  heading="Remove private image metadata in one clean batch."
  copy="Scan common metadata locally, then create fresh image files without copying EXIF, GPS, camera, date, software and common XMP or text metadata. Source images stay in your browser."
  bullets={[
    'Scan supported metadata locally before processing.',
    'One clean-output setup applies to the full batch by default.',
    'Open Advanced per-file output only when one image needs a different format or quality.',
    'No visual preview is needed because this utility changes metadata rather than image composition.',
  ]}
/>
