---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageUtilityTool from '../components/ImageUtilityTool.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Image Background',url:`${SITE.origin}/image-background/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Fill transparent pixels with a custom background color','Preserve existing transparency in PNG and WebP','Batch processing up to 50 images','JPG, PNG and WebP input','Local browser processing','ZIP batch download']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Image Background',item:`${SITE.origin}/image-background/`}]},
];
---
<SiteLayout title="Add Image Background Color Online | ConvertAnyFile" description="Fill transparent areas in JPG, PNG or WebP workflows with a custom color, or preserve existing transparency in PNG/WebP outputs. Process batches locally in your browser." schema={schemas} noindex={true}>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Image Background</span></div><span class="eyebrow converter-page-eyebrow">Image Background · Preview</span><h1>Add a background color to transparent images</h1><p>Fill transparent pixels with white, black, gray or a custom color, or preserve existing transparency when exporting PNG or WebP. Process one image or a batch locally in your browser.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><ImageUtilityTool mode="background" /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Transparency workflow</span><h2>Fill transparency without pretending to remove a background.</h2><p>This tool works with transparency that already exists in the source image. Fill mode composites transparent pixels onto a chosen color. Preserve mode keeps existing transparency in PNG or WebP output.</p></div><div class="content-summary-card"><strong>Not automatic background removal</strong><p>An opaque photo background remains opaque. Subject isolation and automatic background removal require a different engine and are not claimed by this utility.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Common uses</span><h2>Prepare transparent assets for their destination.</h2></div><ul class="content-checklist"><li>Put transparent logos or product cutouts on a white background for forms and marketplaces.</li><li>Use a dark or brand-color background for prepared delivery copies.</li><li>Keep transparency when moving an existing transparent image into PNG or WebP.</li><li>Process a batch with the same background rule and download results together as ZIP.</li></ul><div class="related-grid"><a class="related-card" href="/compress-image/">Compress Image <span>→</span></a><a class="related-card" href="/image-metadata/">Image Metadata <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
