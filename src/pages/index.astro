---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConverterShell from '../components/ConverterShell.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import FaqList from '../components/FaqList.astro';
import { getConverter } from '../config/converters';
import { GENERAL_FAQ } from '../content/faq';
import { SITE } from '../config/site';
const converter = getConverter('image-converter')!;
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Image Converter',url:`${SITE.origin}/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Browser-based conversion','Batch image conversion','ZIP download','No account required']};
---
<SiteLayout schema={schema}>
<section class="hero"><div class="site-container"><div class="hero-copy"><span class="eyebrow">Browser-first file conversion</span><h1>Convert files fast.<br /><span>Keep them private.</span></h1><p class="hero-lead">Image conversion is live now: JPG, PNG, WebP, HEIC, AVIF, TIFF, RAW and more, processed directly in your browser. More local file categories will follow.</p><div class="hero-trust"><span>No upload step</span><span>Batch conversion</span><span>No account</span><span>Free to use</span></div></div><div class="hero-converter"><ConverterShell converter={converter} compact /></div></div></section>
<section class="proof-strip" aria-label="Product facts"><div class="site-container proof-grid"><div><strong>Local</strong><span>processing runs in your browser</span></div><div><strong>Batch</strong><span>convert multiple files together</span></div><div><strong>ZIP</strong><span>download successful results at once</span></div><div><strong>Private</strong><span>no image upload required</span></div></div></section>
<section class="content-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Converter platform</span><h2>One interface. Multiple file categories.</h2><p>ConvertAnyFile is built around reusable local converter engines. Images are available first; new categories will use the same simple drop, convert, and download workflow when they are ready.</p></div><CategoryGrid /></div></section>
<section class="content-section white"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">How it works</span><h2>Three steps. No account. No waiting for uploads.</h2><p>The current image converter runs inside the browser, so the common workflow stays simple even for a batch.</p></div><div class="steps-grid"><article class="step-card"><span class="step-number">01</span><h3>Add files</h3><p>Drag files onto the converter or choose them from your device. Invalid and unsupported files are kept out of the queue.</p></article><article class="step-card"><span class="step-number">02</span><h3>Choose an output</h3><p>Select the output format and quality where the codec supports it. The runtime verifies available codecs before conversion.</p></article><article class="step-card"><span class="step-number">03</span><h3>Download results</h3><p>Download converted files individually or package successful batch results into one ZIP file.</p></article></div></div></section>
<section class="content-section"><div class="site-container"><FaqList items={GENERAL_FAQ} title="Built for quick, private conversion" intro="The platform is deliberately browser-first: simple for users and lightweight to operate." /></div></section>
<section class="closing-cta"><div class="site-container closing-card"><div><span class="section-kicker light-kicker">Available now</span><h2>Convert your next image batch without uploading it first.</h2></div><a class="cta-button" href="/image-converter/">Open image converter →</a></div></section>
</SiteLayout>
