---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomepageConverter from '../components/HomepageConverter.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ImageToolGrid from '../components/ImageToolGrid.astro';
import FaqList from '../components/FaqList.astro';
import SubtitlePremiumStyles from '../components/SubtitlePremiumStyles.astro';
import { GENERAL_FAQ } from '../content/faq';
import { SITE } from '../config/site';
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile',url:`${SITE.origin}/`,applicationCategory:'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Browser-based conversion','Batch image conversion','Structured data conversion','Archive conversion','Subtitle converter preview','Full-file subtitle preflight analysis','Subtitle timing shift and transcript export','Local Image Tools','Batch visible watermark removal','Movable text watermark masks','Free Gemini watermark remover','Focused Gemini-style visible logo removal','Automatic shared or per-image mask editing','7Z and RAR input decoding','ZIP download','No account required']};
---
<SiteLayout schema={schema}>
<SubtitlePremiumStyles />
<section class="hero"><div class="site-container"><div class="hero-copy"><h1>Convert files fast. <span>Keep them private.</span></h1><p class="hero-lead">Convert files, preview subtitle conversion, and run focused image edits locally in your browser.</p><div class="hero-trust"><span>No uploads</span><span>Batch workflows</span><span>No account</span></div></div><div class="hero-converter"><HomepageConverter /></div></div></section>
<section class="proof-strip" aria-label="Product facts"><div class="site-container proof-grid"><div><strong>Local</strong><span>supported conversion and image editing run in your browser</span></div><div><strong>3 live + 1 preview</strong><span>Images, archives and data are live; Subtitles are in Preview</span></div><div><strong>Batch + ZIP</strong><span>process multiple files and download results</span></div><div><strong>Private</strong><span>no source-file upload step required</span></div></div></section>
<section class="content-section converter-platform-section" id="converters"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Converter platform</span><h2>One interface. Multiple file categories.</h2><p>Images, archives, and structured data are live today. Subtitle is available as a Preview with full-file timed-text preflight, timing correction, formatting cleanup and transcript export. Every category uses the same local batch workflow while keeping its own validation, safety limits and conversion engine.</p></div><CategoryGrid /></div></section>
<section class="content-section white" id="image-tools"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Free Online Image Tools</span><h2>Focused image edits on a shared local batch editor.</h2><p>Use the <a href="/gemini-ai-logo-remover/"><strong>Gemini Watermark Remover</strong></a> for a small visible Gemini-style sparkle mark with Circle or 4-Point Star masks. <a href="/remove-watermark/">Remove Watermark</a> handles broader visible marks with Rectangle, Circle, Square, Diamond, 4-Point Star and Text masks. Both support local batch processing, smart shared-or-individual editing and ZIP download.</p></div><ImageToolGrid compact /></div></section>
<section class="content-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">How conversion works</span><h2>Three steps. No account. No waiting for uploads.</h2><p>Live converters and Preview engines process supported files locally, while each category defines its own validation, safety limits, output formats, and conversion settings.</p></div><div class="steps-grid"><article class="step-card"><span class="step-number">01</span><h3>Add files</h3><p>Choose a category or drop files onto the homepage converter. A homogeneous Image, Data, Archive, or Subtitle drop automatically routes to the matching local engine. Subtitle files are fully parsed in a worker before the queue marks them Ready.</p></article><article class="step-card"><span class="step-number">02</span><h3>Choose an output</h3><p>Select the destination format and only the controls relevant to that output, such as image quality, archive compression, data line endings, or subtitle timing shift, text cleanup, transcript timestamps and cue spacing.</p></article><article class="step-card"><span class="step-number">03</span><h3>Download results</h3><p>Download converted files individually or package successful batch results into one ZIP file.</p></article></div></div></section>
<section class="content-section white"><div class="site-container"><FaqList items={GENERAL_FAQ} title="Built for quick, private file work" intro="The platform is deliberately browser-first: simple for users, explicit about support, and lightweight to operate." /></div></section>
<section class="closing-cta"><div class="site-container closing-card"><div><span class="section-kicker light-kicker">Featured Image Tool</span><h2>Remove a visible Gemini watermark locally in your browser.</h2></div><a class="cta-button" href="/gemini-ai-logo-remover/">Open Gemini Watermark Remover →</a></div></section>
</SiteLayout>

<style>
  .hero { padding-top: 22px; padding-bottom: 20px; }
  .hero h1 { margin: 0 0 7px; font-size: clamp(38px, 4.65vw, 58px); }
  .hero-lead { font-size: clamp(14px, 1.45vw, 16px); line-height: 1.4; }
  .hero-trust { margin-top: 8px; gap: 15px; }
  .hero-converter { margin-top: 14px; }
  :global(.proof-strip .proof-grid > div) { padding-top: 17px; padding-bottom: 17px; }
  @media (max-width: 760px) {
    .hero { padding-top: 16px; padding-bottom: 16px; }
    .hero h1 { font-size: clamp(33px, 9.6vw, 46px); }
    .hero-trust { margin-top: 7px; }
    .hero-converter { margin-top: 12px; }
  }
</style>