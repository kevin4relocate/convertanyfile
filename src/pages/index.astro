---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConverterShell from '../components/ConverterShell.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import FaqList from '../components/FaqList.astro';
import { getConverter } from '../config/converters';
import { GENERAL_FAQ } from '../content/faq';
import { SITE } from '../config/site';
const converter = getConverter('image-converter')!;
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile',url:`${SITE.origin}/`,applicationCategory:'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Browser-based conversion','Batch image conversion','Structured data conversion','ZIP download','No account required']};
---
<SiteLayout schema={schema}>
<section class="hero"><div class="site-container"><div class="hero-copy"><span class="eyebrow">Browser-first file conversion</span><h1>Convert files fast. <span>Keep them private.</span></h1><p class="hero-lead">Image and structured-data conversion are live now. Convert images or work with CSV, TSV, JSON, JSONL and NDJSON directly in your browser without an upload queue.</p><div class="hero-trust"><span>No upload step</span><span>Batch conversion</span><span>No account</span><span>Free to use</span></div></div><div class="hero-converter"><ConverterShell converter={converter} compact /></div></div></section>
<section class="proof-strip" aria-label="Product facts"><div class="site-container proof-grid"><div><strong>Local</strong><span>supported conversion runs in your browser</span></div><div><strong>2 categories</strong><span>Images and structured data are live</span></div><div><strong>Batch + ZIP</strong><span>process multiple files and download results</span></div><div><strong>Private</strong><span>no file upload step required</span></div></div></section>
<section class="content-section converter-platform-section" id="converters"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Converter platform</span><h2>One interface. Multiple file categories.</h2><p>ConvertAnyFile uses reusable local converter engines behind one queue, settings, progress, and download workflow. Image and Data are live; planned categories will only appear as working converters after their own production tests pass.</p></div><CategoryGrid /></div></section>
<section class="content-section white"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">How it works</span><h2>Three steps. No account. No waiting for uploads.</h2><p>Live converters process supported files locally, while each category defines its own validation, safety limits, output formats, and conversion settings.</p></div><div class="steps-grid"><article class="step-card"><span class="step-number">01</span><h3>Add files</h3><p>Drag files onto a converter or choose them from your device. Category validation keeps invalid or unsupported files out of the queue.</p></article><article class="step-card"><span class="step-number">02</span><h3>Choose an output</h3><p>Select the destination format and only the controls relevant to that output, such as image quality or data line endings and headers.</p></article><article class="step-card"><span class="step-number">03</span><h3>Download results</h3><p>Download converted files individually or package successful batch results into one ZIP file.</p></article></div></div></section>
<section class="content-section"><div class="site-container"><FaqList items={GENERAL_FAQ} title="Built for quick, private conversion" intro="The platform is deliberately browser-first: simple for users, explicit about support, and lightweight to operate." /></div></section>
<section class="closing-cta"><div class="site-container closing-card"><div><span class="section-kicker light-kicker">Available now</span><h2>Choose the converter that matches your file.</h2></div><a class="cta-button" href="/#converters">Browse converters →</a></div></section>
</SiteLayout>
