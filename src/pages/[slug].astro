---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConverterShell from '../components/ConverterShell.astro';
import FaqList from '../components/FaqList.astro';
import { PAIR_CONVERTERS, getConverter } from '../config/converters';
import { PAIR_CONTENT } from '../content/pair-content';
import { SITE } from '../config/site';

export function getStaticPaths(){return PAIR_CONVERTERS.map((converter)=>({params:{slug:converter.slug},props:{converter}}));}
const { converter } = Astro.props;
const content = PAIR_CONTENT[converter.slug];
const related = (converter.related ?? []).map((slug:string)=>getConverter(slug)).filter(Boolean);
const faq = [
  {question:`Can I convert ${converter.input?.toUpperCase()} to ${converter.output?.toUpperCase()} without uploading the file?`,answer:'Yes. This converter runs the supported image conversion workflow in your browser, so an image upload step is not required.'},
  {question:`Can I batch convert ${converter.input?.toUpperCase()} files?`,answer:'Yes. Add multiple supported files, convert them sequentially for browser memory safety, then download successful results individually or together as a ZIP.'},
  {question:'Does conversion change my original files?',answer:'No. The original files remain unchanged. The browser creates new downloadable output files.'},
  {question:'What if one file fails?',answer:'The batch continues. Failed files can be retried without throwing away successful results.'},
];
const schema={'@context':'https://schema.org','@type':'WebApplication',name:converter.h1,url:`${SITE.origin}/${converter.slug}/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}};
---
<SiteLayout title={converter.title} description={converter.description} schema={schema}>
<section class="page-hero"><div class="site-container hero-inner"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-converter/">Image Converter</a><span>/</span><span>{converter.eyebrow}</span></div><span class="eyebrow">{converter.eyebrow}</span><h1>{converter.h1}</h1><p>{converter.intro}</p></div></section>
<section class="converter-page-wrap"><div class="site-container"><ConverterShell converter={converter} /></div></section>
<section class="content-section white"><div class="site-container article"><span class="section-kicker">Format decision</span><h2>Why convert {converter.input?.toUpperCase()} to {converter.output?.toUpperCase()}?</h2><p>{content?.why}</p><h3>When this conversion makes sense</h3><p>{content?.when}</p><div class="callout"><strong>Quality note</strong><p>{content?.note}</p></div>{related.length>0&&<><h3>Related image conversions</h3><div class="related-grid">{related.map((item:any)=><a class="related-card" href={`/${item.slug}/`}>{item.eyebrow} →</a>)}</div></>}</div></section>
<section class="content-section"><div class="site-container"><FaqList items={faq} title={`${converter.input?.toUpperCase()} to ${converter.output?.toUpperCase()} FAQ`} /></div></section>
</SiteLayout>
