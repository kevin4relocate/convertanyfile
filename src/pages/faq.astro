---
import SiteLayout from '../layouts/SiteLayout.astro';
import FaqList from '../components/FaqList.astro';
import { GENERAL_FAQ, IMAGE_FAQ } from '../content/faq';
import { DATA_FAQ } from '../content/data-faq';
import { SUBTITLE_FAQ } from '../content/subtitle-faq';
const ARCHIVE_FAQ = [
  { question: 'Which archive formats can I add?', answer: 'The Archive converter accepts ZIP, TAR, TAR.GZ/TGZ, GZIP/GZ, 7Z, and supported RAR4/RAR5 input. 7Z and RAR use a lazy-loaded browser WebAssembly decoder.' },
  { question: 'Which archive formats can I convert to?', answer: 'Certified public Archive outputs are ZIP, TAR, and TAR.GZ. 7Z, RAR, and generic GZIP are input-only in the current release.' },
  { question: 'Are password-protected archives supported?', answer: 'No. Password-protected or encrypted ZIP, 7Z, and RAR inputs are rejected instead of producing an incomplete result.' },
  { question: 'How does Archive protect against unsafe files?', answer: 'The engine validates signatures and container integrity, rejects unsafe or duplicate paths and unsupported special entries, and enforces entry-count, per-entry, source-size, and expanded-size browser limits.' },
  { question: 'Why can an archive fail even when it is small?', answer: 'Compressed size can be much smaller than expanded content. A small archive can contain a very large file tree or use unsupported metadata or compression features, so the browser applies limits while decoding rather than trusting compressed size alone.' },
] as const;
---
<SiteLayout title="FAQ | ConvertAnyFile" description="Answers about private browser conversion, image, archive, subtitle, CSV and JSON formats, batch limits, retries, local processing, and file safety.">
<section class="page-hero"><div class="site-container hero-inner"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>FAQ</span></div><span class="eyebrow">Help</span><h1>Questions about ConvertAnyFile.</h1><p>How browser-first conversion works, why each category has safety limits, what the live Image, Data, and Archive engines can do, and what to expect from the Subtitle Preview.</p></div></section>

<section class="content-wide-section"><div class="site-container"><div class="content-intro-grid"><div class="section-heading wide"><span class="section-kicker">Before you convert</span><h2>The important answers in one place.</h2><p>ConvertAnyFile follows a simple rule: explain what each local engine can do, do not publish placeholder converters, and keep the batch workflow understandable when something goes wrong.</p></div><div class="content-summary-card"><strong>3 live + 1 Preview</strong><p>Image, structured Data, and Archive are production categories. Subtitle is being tested as a browser-first Preview before any production promotion.</p></div></div><ul class="content-checklist"><li>Live converters and Preview engines process supported file bytes in the browser session.</li><li>The shared workspace supports batches, cancel, recoverable retry, individual downloads, and ZIP results.</li><li>Each category validates its own inputs instead of trusting filenames blindly.</li><li>Safety limits protect browser memory and CPU rather than protecting a conversion server.</li></ul></div></section>

<section class="content-wide-section white"><div class="site-container"><FaqList items={GENERAL_FAQ} title="Platform questions" intro="Accounts, local processing, batches, cancellation, failures, and how the platform grows without duplicating the converter shell." /></div></section>
<section class="content-wide-section"><div class="site-container"><FaqList items={IMAGE_FAQ} title="Image converter questions" intro="Image formats, quality settings, transparency, RAW files, memory use, and what conversion can or cannot improve." /></div></section>
<section class="content-wide-section white"><div class="site-container"><FaqList items={DATA_FAQ} title="Data converter questions" intro="CSV and TSV headers, JSON nesting, JSONL/NDJSON, UTF-8, output controls, and structured-data batch limits." /></div></section>
<section class="content-wide-section"><div class="site-container"><FaqList items={ARCHIVE_FAQ} title="Archive converter questions" intro="ZIP, 7Z, RAR, TAR, TAR.GZ, GZIP, password protection, browser limits, and fail-closed archive safety." /></div></section>
<section class="content-wide-section white"><div class="site-container"><FaqList items={SUBTITLE_FAQ} title="Subtitle Preview questions" intro="SRT, WebVTT, ASS/SSA styling, SBV, text extraction, encodings, local worker processing, and Preview limits." /></div></section>

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Open a converter</span><h2>Use the category that matches the source file.</h2><p>Image, Data, Archive, and the Subtitle Preview have separate validation and transformation rules, but share the same local queue and download experience.</p></div><div class="related-grid"><a class="related-card" href="/image-converter/">Image Converter <span>→</span></a><a class="related-card" href="/data-converter/">Data Converter <span>→</span></a><a class="related-card" href="/archive-converter/">Archive Converter <span>→</span></a><a class="related-card" href="/subtitle-converter/">Subtitle Preview <span>→</span></a></div></div></section>
</SiteLayout>
