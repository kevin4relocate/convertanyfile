---
import SiteLayout from '../layouts/SiteLayout.astro';
import BulkRenameImagesTool from '../components/BulkRenameImagesTool.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Bulk Rename Images',url:`${SITE.origin}/bulk-rename-images/`,applicationCategory:'UtilitiesApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Bulk rename JPG, PNG and WebP files','Original-name and sequence tokens','Prefix and suffix patterns','Safe filename cleanup','No image re-encoding','Local browser ZIP creation']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Bulk Rename Images',item:`${SITE.origin}/bulk-rename-images/`}]},
];
---
<SiteLayout title="Bulk Rename Images Online Free | ConvertAnyFile" description="Bulk rename JPG, PNG and WebP image files in your browser. Use original-name and number tokens, safe filename cleanup, preview every new filename, and download a renamed ZIP without changing image bytes." schema={schemas} noindex>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Bulk Rename Images</span></div><span class="eyebrow converter-page-eyebrow">Bulk Rename · Preview</span><h1>Bulk rename image files in your browser</h1><p>Preview a consistent naming pattern across JPG, PNG and WebP files, add sequence numbers, clean unsafe filename characters, and download renamed copies without re-encoding the images.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><BulkRenameImagesTool /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Filename patterns</span><h2>Keep original names, add numbering, or build a consistent batch pattern.</h2><p>Use <code>{'{name}'}</code> to keep the original base filename and <code>{'{n}'}</code> to insert a padded sequence number. The preview updates before download so duplicate or awkward names are visible before a ZIP is created.</p></div><div class="content-summary-card"><strong>No image transform</strong><p>This tool does not decode or re-encode image pixels. It changes the download filename only, so the original image bytes are preserved inside the renamed download or ZIP.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Related tools</span><h2>Finish the batch before you rename it.</h2><p>If the images also need resizing, compression, cropping or rotation, do that first and apply final filenames to the delivery copies afterward.</p></div><div class="related-grid"><a class="related-card" href="/resize-image/">Resize Image <span>→</span></a><a class="related-card" href="/compress-image/">Compress Image <span>→</span></a><a class="related-card" href="/image-metadata/">Image Metadata <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
