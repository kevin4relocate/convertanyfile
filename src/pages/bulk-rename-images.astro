---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageToolPageFrame from '../components/ImageToolPageFrame.astro';
import ImageToolGrid from '../components/ImageToolGrid.astro';
import FaqList from '../components/FaqList.astro';
import { BULK_RENAME_IMAGES_TOOL } from '../config/image-tools';
import { IMAGE_TOOL_SEO } from '../content/image-tool-seo';
import { imageToolSchemas } from '../seo/image-tool-schema';
const tool = BULK_RENAME_IMAGES_TOOL;
const seo = IMAGE_TOOL_SEO[tool.id];
const schemas = imageToolSchemas(tool, ['Batch rename up to 50 images','Numbering, prefix, suffix and replace-text methods','Custom pattern mode','Per-image filename override','Original image bytes unchanged','Original image extension preserved','Full batch filename preview','ZIP download'], 'UtilitiesApplication');
---
<SiteLayout title={tool.title} description={tool.description} schema={schemas}>
  <ImageToolPageFrame tool={tool} />

  <section class="content-wide-section white gemini-content-section"><div class="site-container"><div class="content-intro-grid"><div class="section-heading wide"><span class="section-kicker">Filename-only operation</span><h2>Rename files without touching image quality or metadata.</h2><p>Choose a simple rename method such as <strong>Numbering</strong>, <strong>Prefix</strong>, <strong>Suffix</strong> or <strong>Replace text</strong>. A Custom pattern option remains available for advanced workflows. The full batch preview shows every original filename beside its new name before you prepare downloads.</p></div><div class="content-summary-card"><strong>Bytes stay unchanged</strong><p>Visible pixels, compression quality and embedded metadata remain exactly as they were in the uploaded file. Only the downloaded filename changes.</p></div></div><ul class="content-checklist"><li>Add sequential numbering with a base name and padding such as image-001, image-002 and image-003.</li><li>Add a prefix or suffix while keeping each original filename stem.</li><li>Find and replace text across the whole batch.</li><li>Use Custom pattern with {`{name}`}, {`{number}`} and {`{ext}`} only when you need advanced combinations.</li><li>Review every generated filename before downloading one file or a ZIP.</li></ul></div></section>

  {seo && <section class="content-wide-section gemini-content-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">How to use it</span><h2>{seo.howToHeading}</h2><p>{seo.howToIntro}</p></div><div class="steps-grid image-tool-howto-grid">{seo.steps.map((step, index) => <article class="step-card"><span class="step-number">{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></div></section>}

  {seo && <section class="content-wide-section white gemini-content-section"><div class="site-container"><div class="content-intro-grid"><div class="section-heading wide"><span class="section-kicker">When to use it</span><h2>{seo.useCasesHeading}</h2><p>{seo.useCasesIntro}</p></div><div class="content-summary-card"><strong>Rename is not conversion</strong><p>Changing a filename or extension text does not convert image data. ConvertAnyFile therefore keeps the original source extension instead of creating misleading filenames.</p></div></div><ul class="content-checklist">{seo.useCases.map((item) => <li>{item}</li>)}</ul></div></section>}

  {seo && <section class="content-wide-section gemini-content-section"><div class="site-container"><FaqList items={seo.faq} title="Bulk Rename Images FAQ" intro="Answers about numbering, prefixes, suffixes, replace-text rules, custom patterns, source extensions, unchanged image bytes and ZIP downloads." /></div></section>}

  <section class="content-wide-section white gemini-content-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Related Image Tools</span><h2>Rename, clean or optimize the same image batch.</h2><p>Use a related browser-based tool when the next task is metadata cleanup, resizing, compression or cropping.</p></div><ImageToolGrid compact ids={seo?.relatedIds} excludeId={tool.id} /></div></section>
</SiteLayout>
