---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageUtilityTool from '../components/ImageUtilityTool.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Crop Image',url:`${SITE.origin}/crop-image/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Crop JPG, PNG and WebP images','Centered aspect-ratio crops','Exact centered crop dimensions','Batch processing up to 50 images','Local browser processing','ZIP batch download']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Crop Image',item:`${SITE.origin}/crop-image/`}]},
];
---
<SiteLayout title="Crop Image Online Free — JPG, PNG & WebP | ConvertAnyFile" description="Crop JPG, PNG and WebP images free in your browser. Use common aspect ratios or exact centered crop dimensions, process batches locally, and download without uploading source images." schema={schemas}>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Crop Image</span></div><span class="eyebrow converter-page-eyebrow">Crop Image · Preview</span><h1>Crop images online in your browser</h1><p>Crop JPG, PNG and WebP images to common aspect ratios or exact centered dimensions. Apply one crop rule across a batch and download the results individually or together.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><ImageUtilityTool mode="crop" /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Two crop workflows</span><h2>Choose an aspect ratio or an exact center size.</h2><p>Aspect-ratio mode keeps the largest centered area that matches 1:1, 4:3, 3:2, 16:9 or 9:16. Exact mode crops a centered width and height when every image in the batch is large enough for that target.</p></div><div class="content-summary-card"><strong>Preview scope</strong><p>This version intentionally uses centered crops rather than a drag-to-select canvas. That keeps batch behavior deterministic while the interactive crop editor is evaluated separately.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Privacy</span><h2>Crop locally, then download a new copy.</h2><p>The crop operation runs inside the shared browser-side ImageMagick worker. The source image remains on your device and the tool creates a new cropped output without a remote upload queue.</p></div><div class="related-grid"><a class="related-card" href="/rotate-image/">Rotate / Flip <span>→</span></a><a class="related-card" href="/resize-image/">Resize Image <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
