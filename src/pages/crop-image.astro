---
import CoreImageToolPage from '../components/CoreImageToolPage.astro';
import { CROP_IMAGE_TOOL } from '../config/image-tools';
---
<CoreImageToolPage
  tool={CROP_IMAGE_TOOL}
  kicker="Rectangle, square, circle or triangle"
  heading="Drag the crop directly on the image."
  copy="Choose a crop shape and aspect ratio, then move the crop frame on the preview and resize it from a corner. Reuse the same framing across a batch or switch to individual mode when compositions differ."
  bullets={['Choose Rectangle, Square, Circle or Triangle crop shapes.', 'Drag the crop directly on the image and resize it from any corner.', 'Use Free, Original, 1:1, 4:3, 3:2, 16:9 or 9:16 aspect presets.', 'Circle and Triangle crops preserve the outside area as transparency with PNG or WebP output.', 'Apply one crop across a batch or customize individual images before download.']}
/>
