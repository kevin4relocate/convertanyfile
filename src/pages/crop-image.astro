---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageUtilityTool from '../components/ImageUtilityTool.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Crop Image',url:`${SITE.origin}/crop-image/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Crop JPG, PNG and WebP images','Common aspect-ratio crops','Exact crop dimensions','Drag crop position on the first image','Apply relative crop position across a batch','Batch processing up to 50 images','Local browser processing','ZIP batch download']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Crop Image',item:`${SITE.origin}/crop-image/`}]},
];
---
<SiteLayout title="Crop Image Online Free — JPG, PNG & WebP | ConvertAnyFile" description="Crop JPG, PNG and WebP images in your browser. Choose an aspect ratio or exact size, drag the crop position on the first image, apply it across a batch, and download locally." schema={schemas} noindex={true}>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Crop Image</span></div><span class="eyebrow converter-page-eyebrow">Crop Image · Preview</span><h1>Crop images online in your browser</h1><p>Choose a common aspect ratio or exact crop size, then drag the crop window on the first image to set the batch position. The same relative placement is applied to every image.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><ImageUtilityTool mode="crop" /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Interactive batch crop</span><h2>Set the shape, then position it visually.</h2><p>Aspect-ratio mode keeps the largest area that matches 1:1, 4:3, 3:2, 16:9 or 9:16. Exact mode uses a fixed width and height. After choosing the crop shape, move the preview window or use the nine anchor shortcuts.</p></div><div class="content-summary-card"><strong>Relative batch placement</strong><p>The first image is the positioning reference. A crop placed near the top-right, for example, stays near the same relative top-right position on different image dimensions instead of copying one absolute pixel coordinate.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Batch safety</span><h2>Each image still has to fit the requested crop.</h2><p>Ratio crops adapt to each source image. Exact-size crops fail only for files that are smaller than the requested dimensions, so the rest of the batch can complete and failed rows can be retried after settings change.</p></div><div class="related-grid"><a class="related-card" href="/rotate-image/">Rotate / Flip <span>→</span></a><a class="related-card" href="/resize-image/">Resize Image <span>→</span></a><a class="related-card" href="/blur-image/">Blur Image <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
