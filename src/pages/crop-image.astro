---
import CoreImageToolPage from '../components/CoreImageToolPage.astro';
import { CROP_IMAGE_TOOL } from '../config/image-tools';
---
<CoreImageToolPage
  tool={CROP_IMAGE_TOOL}
  kicker="Visual crop shapes and common aspect ratios"
  heading="Frame a crop directly on the image, then reuse it across a batch."
  copy="Choose Rectangle, Square, Circle or a common aspect ratio, then drag the crop box over the subject and resize it from the corners. Shared mode reuses the framing across similar images, while individual mode handles different compositions."
  bullets={['Drag the crop box directly on the image and resize it from four corner handles.', 'Rectangle, Square and Circle crop shapes.', 'Presets for original, 4:3, 3:2, 16:9 and 9:16 framing.', 'Circle crops export PNG with transparent corners.', 'Advanced percentage coordinates remain available for exact batch positioning.']}
/>
