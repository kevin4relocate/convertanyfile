---
import SiteLayout from '../../layouts/SiteLayout.astro';
import GrowthLinkHub from '../../components/GrowthLinkHub.astro';
import { IMAGE_GROWTH_GUIDES } from '../../content/image-growth-guides';
import { CONVERSION_GROWTH_GUIDES } from '../../content/conversion-growth-guides';
import { STATIC_GUIDES } from '../../config/guide-links';
import { POPULAR_IMAGE_GUIDES, POPULAR_CONVERSION_GUIDES } from '../../config/growth-links';
import { SITE } from '../../config/site';

const imageGuideCards = IMAGE_GROWTH_GUIDES.map((guide)=>({href:`/guides/${guide.slug}/`,title:guide.h1,text:guide.indexText}));
const conversionGuideCards = CONVERSION_GROWTH_GUIDES.map((guide)=>({href:`/guides/${guide.slug}/`,title:guide.h1,text:guide.indexText}));
const guides=[...conversionGuideCards,...imageGuideCards,...STATIC_GUIDES];
const conversionGuideGroups=[{title:'High-demand conversion guides',links:POPULAR_CONVERSION_GUIDES}] as const;
const imageGuideGroups=[{title:'Popular image editing guides',links:POPULAR_IMAGE_GUIDES}] as const;
const schema=[
  {'@context':'https://schema.org','@type':'CollectionPage',name:'ConvertAnyFile Guides',url:`${SITE.origin}/guides/`,description:'Practical guides for image editing, image conversion, data conversion, subtitles, archives and browser-first workflows.',isPartOf:{'@type':'WebSite',name:SITE.name,url:SITE.origin}},
  {'@context':'https://schema.org','@type':'ItemList',name:'ConvertAnyFile Guides',itemListElement:guides.map((guide,index)=>({'@type':'ListItem',position:index+1,name:guide.title,url:`${SITE.origin}${guide.href}`}))},
];
---
<SiteLayout title="File Conversion & Image Editing Guides | ConvertAnyFile" description="Practical browser-based guides for CSV and JSON conversion, JPG, PNG, WebP, resizing, compression, cropping, metadata, subtitles, archives and private local workflows." schema={schema}>
<section class="page-hero"><div class="site-container hero-inner"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Guides</span></div><span class="eyebrow">Practical guides</span><h1>File conversion and image editing guides.</h1><p>Learn the practical trade-offs behind CSV and JSON conversion, image formats, resizing, compression, cropping, metadata cleanup, subtitle timing and archive compatibility — then open the matching browser tool.</p></div></section>

<section class="content-wide-section"><div class="site-container"><div class="content-intro-grid"><div class="section-heading wide"><span class="section-kicker">Why these guides exist</span><h2>Useful tools are easier when the trade-offs are clear.</h2><p>A converter or image editor can run in seconds, but the right result depends on schema, dimensions, aspect ratio, compression, transparency, metadata, compatibility, subtitle timing, archive structure and what the next application expects. These guides explain those decisions before you process a batch.</p></div><div class="content-summary-card"><strong>People-first content</strong><p>Each guide is tied to a working ConvertAnyFile tool or a real format decision. The goal is useful product education, not thin pages created only to repeat keywords.</p></div></div></div></section>

<section class="content-wide-section white"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Conversion starting points</span><h2>Start with high-demand format problems.</h2><p>These guides support the conversion pages that people are most likely to search for directly, while keeping the tool page focused on doing the job and the guide focused on explaining the trade-offs.</p></div><GrowthLinkHub groups={conversionGuideGroups} compact /></div></section>

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Image editing starting points</span><h2>Common image questions have dedicated how-to paths.</h2><p>Start with the problem you are trying to solve, learn the constraint that matters, then open the live tool with the right workflow in mind.</p></div><GrowthLinkHub groups={imageGuideGroups} compact /></div></section>

<section class="content-wide-section white"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Data conversion starting points</span><h2>Choose the table or JSON shape you need.</h2><p>Structured-data conversion is most useful when the output schema is predictable. These entry points explain headers, nested values, JSON Lines and spreadsheet-oriented exports before you run the converter.</p></div><div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Your task</th><th>Best starting guide</th><th>Useful tool</th></tr></thead><tbody>
<tr><td>Turn spreadsheet rows into JSON objects</td><td><a href="/guides/how-to-convert-csv-to-json/">CSV to JSON guide</a></td><td><a href="/csv-to-json/">CSV to JSON</a></td></tr>
<tr><td>Open JSON records in a spreadsheet</td><td><a href="/guides/how-to-convert-json-to-csv/">JSON to CSV guide</a></td><td><a href="/json-to-csv/">JSON to CSV</a></td></tr>
<tr><td>Compare table and object formats first</td><td><a href="/guides/csv-vs-json/">CSV vs JSON</a></td><td><a href="/data-converter/">Data Converter</a></td></tr>
<tr><td>Turn line-oriented records into JSON</td><td><a href="/guides/csv-vs-json/">Structured data basics</a></td><td><a href="/jsonl-to-json/">JSONL to JSON</a></td></tr>
</tbody></table></div></div></section>

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Image conversion starting points</span><h2>Match the format to the real destination.</h2><p>Conversion should solve compatibility or delivery requirements, not promise imaginary quality gains. These guides explain the cases behind the most useful JPG, PNG and WebP routes.</p></div><div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Your task</th><th>Best starting guide</th><th>Useful tool</th></tr></thead><tbody>
<tr><td>Create WebP delivery copies from JPG</td><td><a href="/guides/how-to-convert-jpg-to-webp/">JPG to WebP guide</a></td><td><a href="/jpg-to-webp/">JPG to WebP</a></td></tr>
<tr><td>Create a JPEG compatibility copy from WebP</td><td><a href="/guides/how-to-convert-webp-to-jpg/">WebP to JPG guide</a></td><td><a href="/webp-to-jpg/">WebP to JPG</a></td></tr>
<tr><td>Reduce a photographic PNG with JPEG</td><td><a href="/guides/how-to-convert-png-to-jpg/">PNG to JPG guide</a></td><td><a href="/png-to-jpg/">PNG to JPG</a></td></tr>
<tr><td>Create a PNG workflow copy from JPG</td><td><a href="/guides/how-to-convert-jpg-to-png/">JPG to PNG guide</a></td><td><a href="/jpg-to-png/">JPG to PNG</a></td></tr>
</tbody></table></div></div></section>

<section class="content-wide-section white"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Image utility starting points</span><h2>Choose the image problem first.</h2></div><div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Your task</th><th>Best starting guide</th><th>Useful tool</th></tr></thead><tbody><tr><td>Resize without distortion</td><td><a href="/guides/resize-image-without-stretching/">Resize without stretching</a></td><td><a href="/resize-image/">Resize Image</a></td></tr><tr><td>Create a 1920 × 1080 frame</td><td><a href="/guides/resize-image-to-1920x1080/">Resize to 1920 × 1080</a></td><td><a href="/resize-image/">Resize Image</a></td></tr><tr><td>Reduce file size without changing dimensions</td><td><a href="/guides/reduce-image-file-size-without-resizing/">Reduce file size without resizing</a></td><td><a href="/compress-image/">Compress Image</a></td></tr><tr><td>Create a transparent circle crop</td><td><a href="/guides/crop-image-to-circle/">Crop an image into a circle</a></td><td><a href="/crop-image/">Crop Image</a></td></tr><tr><td>Blur one part of an image</td><td><a href="/guides/blur-part-of-image/">Blur part of an image</a></td><td><a href="/blur-image/">Blur Image</a></td></tr><tr><td>Remove camera or location metadata</td><td><a href="/guides/remove-exif-from-photo/">Remove EXIF data</a></td><td><a href="/remove-image-metadata/">Remove Image Metadata</a></td></tr></tbody></table></div></div></section>

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Subtitle starting points</span><h2>Choose the subtitle problem first.</h2></div><div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Your task</th><th>Best starting guide</th><th>Useful tool</th></tr></thead><tbody><tr><td>Web video needs VTT</td><td><a href="/guides/how-to-convert-srt-to-vtt/">SRT to VTT guide</a></td><td><a href="/srt-to-vtt/">SRT to VTT</a></td></tr><tr><td>App or player needs SRT</td><td><a href="/guides/how-to-convert-vtt-to-srt/">VTT to SRT guide</a></td><td><a href="/vtt-to-srt/">VTT to SRT</a></td></tr><tr><td>Subtitles are early or late</td><td><a href="/guides/how-to-shift-subtitle-timing/">Timing shift guide</a></td><td><a href="/subtitle-converter/">Subtitle Converter</a></td></tr><tr><td>You only need readable dialogue</td><td><a href="/guides/subtitle-to-plain-text/">Subtitle to plain text guide</a></td><td><a href="/srt-to-txt/">SRT to TXT</a></td></tr></tbody></table></div></div></section>

<section class="content-wide-section white"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Watermark editing starting points</span><h2>Choose the focused workflow first.</h2></div><div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Your task</th><th>Best starting guide</th><th>Useful tool</th></tr></thead><tbody><tr><td>Visible Gemini sparkle watermark</td><td><a href="/guides/how-to-remove-gemini-watermark-from-image/">Gemini watermark removal guide</a></td><td><a href="/gemini-ai-logo-remover/">Gemini Watermark Remover</a></td></tr><tr><td>General visible watermark</td><td><a href="/guides/how-to-remove-watermark-from-image/">Watermark removal guide</a></td><td><a href="/remove-watermark/">Remove Watermark</a></td></tr><tr><td>Visible word, number, or phrase</td><td><a href="/guides/how-to-remove-text-watermark-from-image/">Text watermark guide</a></td><td><a href="/remove-watermark/">Text mask</a></td></tr></tbody></table></div></div></section>

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">All guides</span><h2>Browse every practical guide.</h2><p>Conversion and image-editing guides sit alongside subtitle compatibility and timing, archive containers, compression behavior and structured-data choices.</p></div><div class="category-grid">{guides.map((guide)=><a class="category-card category-card--live" href={guide.href}><div class="category-icon">G</div><div><span class="live-badge">Guide</span><h3>{guide.title}</h3><p>{guide.text}</p></div><span class="category-arrow">→</span></a>)}</div></div></section>
</SiteLayout>
