---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageToolGrid from '../components/ImageToolGrid.astro';
import FaqList from '../components/FaqList.astro';
import { IMAGE_TOOL_ROADMAP } from '../config/image-tools';
import { SITE } from '../config/site';

const everydayTools = ['resize-image','compress-image','rotate-flip-image','crop-image','blur-image'];
const cleanupTools = ['remove-image-metadata','bulk-rename-images'];
const removalTools = ['remove-watermark','remove-object','gemini-ai-logo-remover'];
const faq = [
  { question: 'Do these image tools upload my source images?', answer: 'The Image Tools are designed around browser-side processing. Supported transforms, manual repair, metadata cleanup, renaming and ZIP creation run locally in the browser instead of sending source images to an image-processing API.' },
  { question: 'Which image formats are supported?', answer: 'The current Image Tools accept JPG/JPEG, PNG and WebP. Individual tools may offer different output choices depending on transparency, lossless output or source-format preservation.' },
  { question: 'Can I edit multiple images at once?', answer: 'Yes. Most Image Tools support batches of up to 50 source images within the documented per-file and total-input limits. Use Apply to all for repeated settings or Edit individually for exceptions.' },
  { question: 'What is the difference between Remove Object and Remove Watermark?', answer: 'Both use manual selections so you control which visible pixels are repaired. Remove Watermark offers watermark-focused shape and text masks, while Remove Object is aimed at small unwanted objects.' },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'ConvertAnyFile Image Tools',
    url: `${SITE.origin}/image-tools/`,
    description: 'Browser-based image tools for resizing, compression, rotation, cropping, blur, renaming, metadata cleanup and manual image repair.',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.origin },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'ConvertAnyFile Image Tools',
    itemListElement: IMAGE_TOOL_ROADMAP.filter((item) => item.href).map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      url: `${SITE.origin}${item.href}`,
    })),
  },
];
---
<SiteLayout title="Online Image Tools — Resize, Compress, Crop & Repair | ConvertAnyFile" description="Browser-based image tools for resizing, compressing, rotating, cropping, blurring, renaming, stripping metadata and repairing small objects or visible watermarks." schema={schema}>
<section class="page-hero"><div class="site-container hero-inner"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Image Tools</span></div><span class="eyebrow">Online Image Tools</span><h1>Edit images in your browser without uploading the source files.</h1><p>Resize, compress, rotate, crop, blur, rename, strip metadata or repair small visible selections with focused tools that run locally in your browser.</p></div></section>

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Resize, compress and compose</span><h2>Everyday image edits with one familiar batch workflow.</h2><p>Use these tools when the goal is to change dimensions, encoding, orientation, framing or blur. Start with one setup for the batch, then override individual images when compositions or output needs differ.</p></div><ImageToolGrid ids={everydayTools} /></div></section>

<section class="content-wide-section white"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">File cleanup and organization</span><h2>Clean metadata or rename files without adding another upload step.</h2><p>Remove Image Metadata creates a new pixel copy without intentionally carrying source EXIF, GPS or software tags. Bulk Rename changes filenames only and preserves the original image bytes and extension.</p></div><ImageToolGrid ids={cleanupTools} /></div></section>

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Remove and repair</span><h2>Use focused manual repair tools when you need precise control.</h2><p>Remove Object and Remove Watermark use manual selections so you control exactly which visible pixels are repaired. The Gemini-focused remover keeps a streamlined mask set for that specific visible mark.</p></div><ImageToolGrid ids={removalTools} /></div></section>

<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Shared or individual</span><h2>Apply one setup to repeated work, then customize exceptions.</h2><p>Most tools start with a shared batch setup. Switch to Edit individually when a particular image needs different dimensions, quality, orientation, crop, blur region, output format, filename or mask placement.</p></div><div class="content-summary-card"><strong>Local by design</strong><p>Image decoding, previews, supported processing, ZIP creation and downloads happen in your browser. Bulk Rename does not decode or re-encode the image bytes at all.</p></div></div></div></section>

<section class="content-wide-section"><div class="site-container"><FaqList items={faq} title="Image Tools FAQ" intro="Common questions about local processing, supported formats, batch editing and manual image repair." /></div></section>
</SiteLayout>
