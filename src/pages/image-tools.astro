---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageToolsDirectory from '../components/ImageToolsDirectory.astro';
import GrowthLinkHub from '../components/GrowthLinkHub.astro';
import FaqList from '../components/FaqList.astro';
import { IMAGE_TOOL_ROADMAP } from '../config/image-tools';
import { POPULAR_IMAGE_GUIDES } from '../config/growth-links';
import { SITE } from '../config/site';

const guideGroups = [{ title: 'Popular image editing guides', links: POPULAR_IMAGE_GUIDES }] as const;
const faq = [
  { question: 'Do these image tools upload my source images?', answer: 'The current Image Tools are designed around browser-side processing. Supported transforms, visible-watermark repair, metadata cleanup, renaming, edge-fade preview processing and ZIP creation run locally instead of sending source images to an image-processing API.' },
  { question: 'Which image formats are supported?', answer: 'The current Image Tools accept JPG/JPEG, PNG and WebP. Individual tools may offer different output choices depending on whether transparency, lossless output or source-format preservation is needed.' },
  { question: 'Can I edit multiple images at once?', answer: 'Yes. The current Image Tools support batch workflows within documented per-file, pixel and total-input limits. Tools with visual settings can reuse one setup across a batch or customize individual images when needed.' },
  { question: 'What does Preview mean?', answer: 'Preview tools are functional builds available for hands-on testing before they are promoted into the live catalog. Their controls, defaults or visual effect may still be tuned based on real use.' },
  { question: 'What is the difference between the two watermark removers?', answer: 'Remove Watermark provides Rectangle, Circle, Square, Diamond, 4-Point Star and Text masks for general visible marks. Gemini Watermark Remover uses a smaller Circle and 4-Point Star workflow focused on a small visible Gemini-style sparkle mark.' },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'ConvertAnyFile Image Tools',
    url: `${SITE.origin}/image-tools/`,
    description: 'Browser-based image tools for resizing, compression, rotation, cropping, blur, renaming, metadata cleanup and visible-watermark repair.',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.origin },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'ConvertAnyFile Image Tools',
    itemListElement: IMAGE_TOOL_ROADMAP.filter((item) => item.href && item.status === 'live').map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      url: `${SITE.origin}${item.href}`,
    })),
  },
];
---
<SiteLayout title="Online Image Tools — Resize, Compress, Crop & Remove Watermarks | ConvertAnyFile" description="Browser-based image tools for resizing, compressing, rotating, cropping, blurring, renaming, stripping metadata and removing visible watermarks locally." schema={schema}>
<section class="page-hero"><div class="site-container hero-inner"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Image Tools</span></div><span class="eyebrow">Online Image Tools</span><h1>Free online image tools for resize, compress, crop and more.</h1><p>Resize, compress, rotate, crop, blur, rename, strip metadata or repair visible watermarks with focused tools that run locally where the browser supports the required processing.</p></div></section>

<ImageToolsDirectory />

<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Image editing guides</span><h2>Start with the question, then open the matching tool.</h2><p>These guides answer common image-search questions about aspect ratio, exact dimensions, compression, circle crops, selected-area blur, EXIF and GPS metadata. Each guide links directly to the live browser tool used for the workflow.</p></div><GrowthLinkHub groups={guideGroups} compact /></div></section>

<section class="content-wide-section"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Shared or individual</span><h2>Apply one setup to repeated work, then customize exceptions.</h2><p>Visual tools can start with a shared batch setup and switch to individual overrides when a particular image needs different dimensions, quality, orientation, crop, blur region, edge fade, output format or mask placement. Metadata cleanup deliberately uses one simple batch setup, while Bulk Rename supports shared naming rules plus exceptions.</p></div><div class="content-summary-card"><strong>Local by design</strong><p>Image decoding, previews, supported processing, ZIP creation and downloads happen in your browser. Bulk Rename does not decode or re-encode the image bytes at all.</p></div></div></div></section>

<section class="content-wide-section"><div class="site-container"><FaqList items={faq} title="Image Tools FAQ" intro="Common questions about local processing, supported formats, batch editing, Preview tools, metadata cleanup and visible-watermark repair." /></div></section>
</SiteLayout>
