---
import CoreImageToolPage from '../components/CoreImageToolPage.astro';
import { REMOVE_BACKGROUND_TOOL } from '../config/image-tools';
---
<CoreImageToolPage
  tool={REMOVE_BACKGROUND_TOOL}
  kicker="Self-hosted local AI"
  heading="Segment a clear foreground subject without sending the source image to an inference API."
  copy="The preview uses a compact U²-NetP ONNX model served from ConvertAnyFile and runs it in your browser with ONNX Runtime Web. The generated mask can be tightened or softened before export."
  bullets={[
    'Transparent, white, black or custom-color backgrounds.',
    'Shared batch settings or per-image cutout overrides.',
    'Cutout level and edge-feather controls reuse a cached AI mask instead of rerunning inference.',
    'Sequential processing keeps full-resolution memory use bounded across large batches.',
    'PNG output preserves transparency and soft edge alpha.',
  ]}
/>
