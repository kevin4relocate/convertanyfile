---
import SiteLayout from '../layouts/SiteLayout.astro';
import BlurImageWorkspace from '../components/BlurImageWorkspace.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Blur Image',url:`${SITE.origin}/blur-image/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Blur JPG, PNG and WebP images','Whole-image batch blur','Selected-region privacy blur','Rectangle or ellipse region selection','Drag and resize selected region','Adjust blur strength','Keep source format or export JPG, PNG or WebP','Local browser processing','ZIP batch download for whole-image workflow']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Blur Image',item:`${SITE.origin}/blur-image/`}]},
];
---
<SiteLayout title="Blur Image Online Free — Whole Image or Selected Area | ConvertAnyFile" description="Blur JPG, PNG and WebP images locally in your browser. Blur a whole batch or select a movable rectangle or ellipse over one area, adjust strength, preview, and download without source-image uploads." schema={schemas} noindex={true}>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Blur Image</span></div><span class="eyebrow converter-page-eyebrow">Blur Image · Preview</span><h1>Blur a whole image or just one selected area</h1><p>Apply adjustable blur to JPG, PNG and WebP images locally. Use Whole image for consistent batch processing, or switch to Selected region to drag and resize a privacy blur over a face, plate, screen, address or other detail.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><BlurImageWorkspace /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Two blur workflows</span><h2>Batch the whole image, or place one interactive region.</h2><p>Whole image keeps the P4 batch workflow with shared strength, cancel, retry and ZIP download. Selected region is intentionally a single-image editor so the mask can be positioned precisely before processing.</p></div><div class="content-summary-card"><strong>Selected-region privacy blur</strong><p>Choose Rectangle or Circle / ellipse, move the selection, resize from the corners, set the strength and review the result. The region worker processes only a guarded bounding area instead of blurring the entire source and masking it afterward.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Privacy and limits</span><h2>Useful for visual obscuring, not a recovery-proof guarantee.</h2><p>A strong blur can make a detail much harder to read in the exported image, but it cannot erase copies that already exist elsewhere and should not be treated as cryptographic redaction. For highly sensitive documents, remove the information at the source rather than relying only on visual blur.</p></div><div class="related-grid"><a class="related-card" href="/remove-object/">Remove Object <span>→</span></a><a class="related-card" href="/crop-image/">Crop Image <span>→</span></a><a class="related-card" href="/image-background/">Image Background <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
