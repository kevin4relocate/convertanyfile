---
import CoreImageToolPage from '../components/CoreImageToolPage.astro';
import { BLUR_IMAGE_TOOL } from '../config/image-tools';
---
<CoreImageToolPage
  tool={BLUR_IMAGE_TOOL}
  kicker="Whole image or visual region"
  heading="Blur the whole image or drag a blur area exactly where you need it."
  copy="Choose Blur whole image for a full-frame effect, or Blur selected area to place a movable rectangle directly on the image. Drag the box to move it and drag the corner handles to resize it; percentage coordinates remain available under Advanced for precise workflows."
  bullets={['Choose whole-image blur or a draggable selected area.', 'Move and resize the blur region directly on the image.', 'Adjust blur strength from light to strong with live preview.', 'Use shared placement for repeated layouts or individual placement for exceptions.', 'Export successful results individually or together as a ZIP.']}
/>
