---
import CoreImageToolPage from '../components/CoreImageToolPage.astro';
import { BLUR_IMAGE_TOOL } from '../config/image-tools';
---
<CoreImageToolPage
  tool={BLUR_IMAGE_TOOL}
  kicker="Whole image, rectangle or circle"
  heading="Drag a selected blur area directly on the image."
  copy="Blur the full frame or switch to Selected area, choose Rectangle or Circle, then move the highlighted area on the preview and resize it from a corner. Reuse the same placement across a batch or customize individual images when layouts differ."
  bullets={['Blur the whole image or only a selected area.', 'Choose Rectangle or Circle for selected-area blur.', 'Drag the highlighted blur area directly on the image and resize it from a corner.', 'Adjust blur strength and watch the live preview update.', 'Apply one setup across a batch or customize individual images before download.']}
/>
