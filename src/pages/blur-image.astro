---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageUtilityTool from '../components/ImageUtilityTool.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Blur Image',url:`${SITE.origin}/blur-image/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Blur JPG, PNG and WebP images','Adjust Gaussian blur strength','Batch processing up to 50 images','Keep source format or export JPG, PNG or WebP','Local browser processing','ZIP batch download']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Blur Image',item:`${SITE.origin}/blur-image/`}]},
];
---
<SiteLayout title="Blur Image Online Free — JPG, PNG & WebP | ConvertAnyFile" description="Blur JPG, PNG and WebP images locally in your browser. Adjust Gaussian blur strength, process batches, keep or change output format, and download individual results or ZIP." schema={schemas} noindex={true}>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Blur Image</span></div><span class="eyebrow converter-page-eyebrow">Blur Image · Preview</span><h1>Blur images locally in your browser</h1><p>Apply adjustable Gaussian blur to JPG, PNG and WebP images, use the same strength across a batch, and download the processed copies without a source-image upload queue.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><ImageUtilityTool mode="blur" /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Adjustable full-image blur</span><h2>Choose a subtle, medium or strong blur.</h2><p>The strength control changes the Gaussian blur applied to the whole image. Lower values soften detail slightly; higher values spread detail more aggressively. Preview outputs before replacing any delivery copy.</p></div><div class="content-summary-card"><strong>P4 scope</strong><p>This tool blurs the entire image. Region selection and movable blur masks belong to a later interactive editing workflow and are not claimed here.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Local batch processing</span><h2>Apply one blur rule to a whole image set.</h2><p>The shared ImageMagick WebAssembly worker decodes, blurs and re-encodes supported images in the browser. Batch limits, cancel, retry, per-file downloads and ZIP behavior are shared with the other Image Tools utilities.</p></div><div class="related-grid"><a class="related-card" href="/crop-image/">Crop Image <span>→</span></a><a class="related-card" href="/image-background/">Image Background <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
