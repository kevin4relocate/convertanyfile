---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageUtilityTool from '../components/ImageUtilityTool.astro';
import { SITE } from '../config/site';
const schemas = [
  {'@context':'https://schema.org','@type':'WebApplication',name:'ConvertAnyFile Resize Image',url:`${SITE.origin}/resize-image/`,applicationCategory:'MultimediaApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Resize JPG, PNG and WebP images','Batch resize up to 50 images','Fit inside width and height','Exact width and height','Percentage scaling','Keep aspect ratio','Local browser processing','ZIP batch download']},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${SITE.origin}/`},{'@type':'ListItem',position:2,name:'Image Tools',item:`${SITE.origin}/image-tools/`},{'@type':'ListItem',position:3,name:'Resize Image',item:`${SITE.origin}/resize-image/`}]},
];
---
<SiteLayout title="Resize Image Online Free — JPG, PNG & WebP | ConvertAnyFile" description="Resize JPG, PNG and WebP images free in your browser. Set a target width and height, keep aspect ratio, scale by percentage, process batches locally, and download without uploading source images." schema={schemas} noindex>
<section class="converter-page-hero image-tool-page-hero"><div class="site-container converter-page-hero-inner"><div class="breadcrumbs converter-page-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/image-tools/">Image Tools</a><span>/</span><span>Resize Image</span></div><span class="eyebrow converter-page-eyebrow">Resize Image · Preview</span><h1>Resize images online without uploading them</h1><p>Resize JPG, PNG and WebP images by a target box, exact width and height, or percentage. Process one image or a batch locally in your browser, then download individual results or a ZIP.</p></div></section>
<section class="image-tool-page-tool"><div class="site-container"><ImageUtilityTool mode="resize" /></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Three resize workflows</span><h2>Fit, exact dimensions, or percentage.</h2><p>Use Width × height with Keep aspect ratio enabled to fit each image inside a target box without stretching it. Turn aspect ratio off when you deliberately need an exact width and height. Percentage mode scales every image relative to its own original dimensions.</p></div><div class="content-summary-card"><strong>Batch-safe defaults</strong><p>Keeping aspect ratio is enabled by default. That makes mixed landscape and portrait batches predictable while still allowing exact dimensions when your destination requires them.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">How it works</span><h2>Resize images locally in four steps.</h2></div><ol class="content-checklist"><li>Add one or more JPG, PNG or WebP images.</li><li>Choose a target width and height or switch to percentage scaling.</li><li>Keep aspect ratio on for proportional resizing, or turn it off for exact dimensions.</li><li>Resize locally, review the reported output dimensions, then download files individually or together as ZIP.</li></ol></div></section>
<section class="content-wide-section white"><div class="site-container"><div class="content-intro-grid"><div><span class="section-kicker">Privacy & limits</span><h2>The source images stay in the browser workflow.</h2><p>The resize operation uses the same browser-side ImageMagick worker as the image converter. Source bytes are not sent to a remote conversion queue. The preview accepts up to 50 JPG, PNG or WebP images, 20 MB per file and 200 MB per batch, with browser safety guards for dimensions and total pixels.</p></div><div class="content-summary-card"><strong>Keep important originals</strong><p>Resizing creates a new delivery copy. Enlarging an image does not invent real source detail, and repeated lossy encoding can reduce quality. Keep the original when it matters.</p></div></div></div></section>
<section class="content-wide-section"><div class="site-container"><div class="section-heading wide"><span class="section-kicker">Related image tools</span><h2>Resize first, then choose the next job.</h2></div><div class="related-grid"><a class="related-card" href="/compress-image/">Compress Image <span>→</span></a><a class="related-card" href="/crop-image/">Crop Image <span>→</span></a><a class="related-card" href="/rotate-image/">Rotate / Flip <span>→</span></a><a class="related-card" href="/image-tools/">All Image Tools <span>→</span></a></div></div></section>
</SiteLayout>
