---
interface Props {
  readyCount?: number;
  processing?: boolean;
  canDownload?: boolean;
  processLabel?: string;
  downloadLabel?: string;
  variant?: 'generic' | 'mask';
  summary?: string;
  preparedSummary?: string;
}

const {
  readyCount = 0,
  processing = false,
  canDownload = false,
  processLabel = 'Process images',
  downloadLabel = 'Download ZIP',
  variant = 'generic',
  summary = 'Ready to process',
  preparedSummary = 'Prepare images to continue.',
} = Astro.props;
---

{variant === 'mask' ? (
  <div class="image-batch-action-bar gemini-batch-action-bar" data-role="batch-action-bar">
    <div>
      <strong data-role="batch-result-summary">{summary}</strong>
      <small data-role="prepared-summary">{preparedSummary}</small>
    </div>
    <div class="image-batch-action-bar__actions gemini-batch-actions">
      <button class="primary-button" data-role="remove" type="button" disabled>{processLabel}</button>
      <button class="secondary-button" data-role="download" type="button" disabled={!canDownload}>{downloadLabel}</button>
    </div>
  </div>
) : (
  <div class="image-batch-action-bar image-batch-action-bar--generic" data-role="batch-action-bar">
    <span data-role="ready-count">{readyCount} image{readyCount === 1 ? '' : 's'} ready</span>
    <div class="image-batch-action-bar__actions">
      <button class="image-batch-primary" type="button" data-role="process-batch" disabled={processing || readyCount === 0}>
        {processing ? 'Processing…' : processLabel}
      </button>
      <button class="image-batch-secondary" type="button" data-role="download-batch" disabled={!canDownload}>{downloadLabel}</button>
    </div>
  </div>
)}

<style>
  .image-batch-action-bar{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--border-color,#303744);border-radius:12px;background:var(--surface-color,#11161f);box-shadow:0 -8px 28px rgba(0,0,0,.12)}.image-batch-action-bar__actions{display:flex;gap:9px;flex-wrap:wrap}.image-batch-action-bar button{min-height:40px;padding:8px 16px;border-radius:9px;font-weight:760;transition:filter .15s ease,transform .15s ease,opacity .15s ease}.image-batch-primary{border:1px solid #766eff;background:linear-gradient(135deg,#7168ff,#6255ee);color:#fff;box-shadow:0 7px 18px rgba(92,78,238,.2)}.image-batch-primary:not(:disabled):hover{filter:brightness(1.08);transform:translateY(-1px)}.image-batch-secondary{border:1px solid #3a4252;background:#171d27;color:#e6e9f0}.image-batch-secondary:not(:disabled):hover{background:#1d2430;border-color:#4a5466}.image-batch-primary:disabled,.image-batch-secondary:disabled{cursor:not-allowed;box-shadow:none;transform:none}.image-batch-primary:disabled{background:#373b48;border-color:#444957;color:#858b98;opacity:.78}.image-batch-secondary:disabled{background:#171b23;border-color:#2c323d;color:#666d79;opacity:.72}.gemini-batch-action-bar{padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}@media(max-width:640px){.image-batch-action-bar{align-items:stretch;flex-direction:column}.image-batch-action-bar__actions{display:grid;grid-template-columns:1fr 1fr}.image-batch-action-bar button{width:100%}}
</style>
