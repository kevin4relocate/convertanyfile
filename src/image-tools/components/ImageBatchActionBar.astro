---
interface Props {
  readyCount?: number;
  processing?: boolean;
  canDownload?: boolean;
  processLabel?: string;
  downloadLabel?: string;
  variant?: 'generic' | 'mask';
  summary?: string;
  preparedSummary?: string;
}

const {
  readyCount = 0,
  processing = false,
  canDownload = false,
  processLabel = 'Process images',
  downloadLabel = 'Download ZIP',
  variant = 'generic',
  summary = 'Ready to process',
  preparedSummary = 'Prepare images to continue.',
} = Astro.props;
---

{variant === 'mask' ? (
  <div class="image-batch-action-bar image-batch-action-bar--mask" data-role="batch-action-bar">
    <div class="image-batch-action-bar__summary">
      <strong data-role="batch-result-summary">{summary}</strong>
      <small data-role="prepared-summary">{preparedSummary}</small>
    </div>
    <div class="image-batch-action-bar__actions">
      <button class="image-tool-cta image-tool-cta--primary" data-role="remove" type="button" disabled>{processLabel}</button>
      <button class="image-tool-cta image-tool-cta--secondary" data-role="download" type="button" disabled={!canDownload}>{downloadLabel}</button>
    </div>
  </div>
) : (
  <div class="image-batch-action-bar" data-role="batch-action-bar">
    <span class="image-batch-action-bar__ready" data-role="ready-count">{readyCount} image{readyCount === 1 ? '' : 's'} ready</span>
    <div class="image-batch-action-bar__actions">
      <button class="image-tool-cta image-tool-cta--primary" type="button" data-role="process-batch" disabled={processing || readyCount === 0}>
        {processing ? 'Processing…' : processLabel}
      </button>
      <button class="image-tool-cta image-tool-cta--secondary" type="button" data-role="download-batch" disabled={!canDownload}>{downloadLabel}</button>
    </div>
  </div>
)}

<style>
  .image-batch-action-bar{display:flex;justify-content:space-between;gap:18px;align-items:center;padding:12px 14px;border:1px solid #303744;border-radius:12px;background:#10151e;box-shadow:none}
  .image-batch-action-bar__summary{min-width:0;display:grid;gap:3px}
  .image-batch-action-bar__summary strong,.image-batch-action-bar__ready{font-size:12px;font-weight:720;line-height:1.3}
  .image-batch-action-bar__summary small{color:#858d9d;font-size:10px;line-height:1.4}
  .image-batch-action-bar__actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}
  .image-batch-action-bar .image-tool-cta{height:42px;min-width:156px;display:inline-flex;align-items:center;justify-content:center;padding:0 16px;border-radius:9px;cursor:pointer;font:inherit;font-size:11px;font-weight:760;line-height:1;white-space:nowrap;transition:border-color .14s ease,background .14s ease,color .14s ease,transform .14s ease}
  .image-batch-action-bar .image-tool-cta--primary{border:1px solid #746dff;background:#625bf6;color:#fff;box-shadow:0 6px 16px rgba(81,73,218,.18)}
  .image-batch-action-bar .image-tool-cta--primary:hover:not(:disabled){background:#716aff;border-color:#8a84ff;transform:translateY(-1px)}
  .image-batch-action-bar .image-tool-cta--secondary{border:1px solid #3a4353;background:#151b24;color:#d5dae4}
  .image-batch-action-bar .image-tool-cta--secondary:hover:not(:disabled){border-color:#505b6e;background:#1a222d;color:#f2f4f8}
  .image-batch-action-bar .image-tool-cta:disabled{opacity:.38;filter:saturate(.65);cursor:not-allowed;transform:none;box-shadow:none}
  @media(max-width:720px){.image-batch-action-bar{align-items:stretch;flex-direction:column}.image-batch-action-bar__actions{display:grid;grid-template-columns:1fr 1fr;width:100%}.image-batch-action-bar .image-tool-cta{width:100%;min-width:0}}
  @media(max-width:480px){.image-batch-action-bar__actions{grid-template-columns:1fr}}
</style>
