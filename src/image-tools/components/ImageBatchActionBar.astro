---
interface Props {
  readyCount?: number;
  processing?: boolean;
  canDownload?: boolean;
  processLabel?: string;
  downloadLabel?: string;
}

const {
  readyCount = 0,
  processing = false,
  canDownload = false,
  processLabel = 'Process images',
  downloadLabel = 'Download ZIP',
} = Astro.props;
---

<div class="image-batch-action-bar" data-role="batch-action-bar">
  <span data-role="ready-count">{readyCount} image{readyCount === 1 ? '' : 's'} ready</span>
  <div class="image-batch-action-bar__actions">
    <button type="button" data-role="process-batch" disabled={processing || readyCount === 0}>
      {processing ? 'Processing…' : processLabel}
    </button>
    <button type="button" data-role="download-batch" disabled={!canDownload}>
      {downloadLabel}
    </button>
  </div>
</div>

<style>
  .image-batch-action-bar{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--border-color,#303744);border-radius:12px;background:var(--surface-color,#11161f);box-shadow:0 -8px 28px rgba(0,0,0,.12)}.image-batch-action-bar__actions{display:flex;gap:8px;flex-wrap:wrap}.image-batch-action-bar button{min-height:40px;padding:8px 14px}@media(max-width:640px){.image-batch-action-bar{align-items:stretch;flex-direction:column}.image-batch-action-bar__actions{display:grid;grid-template-columns:1fr 1fr}.image-batch-action-bar button{width:100%}}
</style>
