<section class="image-tool-preview-grid image-preview-pair blur-interactive-preview" data-role="preview-panel">
  <article class="image-tool-preview-panel">
    <header>
      <div><span>Before</span><strong>Original</strong></div>
      <small data-role="source-meta"></small>
    </header>
    <div class="blur-editor-frame" data-role="blur-editor-frame">
      <img data-role="source-preview" alt="Original image" hidden />
      <span class="blur-editor-empty" data-role="source-empty">No image selected</span>
      <div class="blur-selection" data-role="blur-selection" hidden>
        <span class="blur-selection-label">Blur area</span>
        <button type="button" class="blur-handle blur-handle--nw" data-blur-handle="nw" aria-label="Resize blur area from top left"></button>
        <button type="button" class="blur-handle blur-handle--ne" data-blur-handle="ne" aria-label="Resize blur area from top right"></button>
        <button type="button" class="blur-handle blur-handle--sw" data-blur-handle="sw" aria-label="Resize blur area from bottom left"></button>
        <button type="button" class="blur-handle blur-handle--se" data-blur-handle="se" aria-label="Resize blur area from bottom right"></button>
      </div>
    </div>
  </article>
  <article class="image-tool-preview-panel">
    <header>
      <div><span>After</span><strong>Live preview</strong></div>
      <small data-role="preview-meta"></small>
    </header>
    <div class="blur-result-frame">
      <img data-role="result-preview" alt="Blur preview" hidden />
      <span data-role="result-empty">Preview will appear here</span>
    </div>
  </article>
</section>

<style>
  .blur-interactive-preview{margin-top:0}
  .blur-editor-frame,.blur-result-frame{position:relative;min-height:280px;display:grid;place-items:center;overflow:hidden;background:repeating-conic-gradient(#11161f 0 25%,#151b25 0 50%) 50%/18px 18px}
  .blur-editor-frame>img,.blur-result-frame>img{display:block;max-width:100%;max-height:500px;object-fit:contain}
  .blur-editor-empty,.blur-result-frame>span{padding:20px;color:#858d9d;font-size:10px;text-align:center}
  .blur-selection{position:absolute;z-index:3;box-sizing:border-box;min-width:28px;min-height:28px;border:2px solid #8178ff;border-radius:5px;background:rgba(115,103,255,.17);box-shadow:0 0 0 9999px rgba(4,7,12,.36);cursor:move;touch-action:none}
  .blur-selection::before,.blur-selection::after{content:"";position:absolute;pointer-events:none;opacity:.42}
  .blur-selection::before{left:33.333%;top:0;bottom:0;width:33.333%;border-left:1px dashed #d7d3ff;border-right:1px dashed #d7d3ff}
  .blur-selection::after{top:33.333%;left:0;right:0;height:33.333%;border-top:1px dashed #d7d3ff;border-bottom:1px dashed #d7d3ff}
  .blur-selection-label{position:absolute;left:7px;top:7px;padding:3px 6px;border-radius:5px;background:rgba(13,16,25,.82);color:#f1efff;font-size:9px;font-weight:750;pointer-events:none}
  .blur-handle{position:absolute!important;width:14px!important;height:14px!important;min-height:0!important;padding:0!important;border:2px solid #f5f3ff!important;border-radius:50%!important;background:#746bff!important;box-shadow:0 1px 5px rgba(0,0,0,.55);touch-action:none}
  .blur-handle--nw{left:-8px;top:-8px;cursor:nwse-resize}.blur-handle--ne{right:-8px;top:-8px;cursor:nesw-resize}.blur-handle--sw{left:-8px;bottom:-8px;cursor:nesw-resize}.blur-handle--se{right:-8px;bottom:-8px;cursor:nwse-resize}
  @media(max-width:1050px){.blur-editor-frame,.blur-result-frame{min-height:230px}}
  @media(max-width:760px){.blur-editor-frame,.blur-result-frame{min-height:200px}.blur-selection-label{display:none}}
</style>
