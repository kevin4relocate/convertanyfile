---
interface Props {
  completed?: number;
  total?: number;
  label?: string;
  cancellable?: boolean;
  variant?: 'generic' | 'mask';
}

const {
  completed = 0,
  total = 0,
  label = 'Processing images…',
  cancellable = true,
  variant = 'generic',
} = Astro.props;
const percent = total > 0 ? Math.min(100, Math.round((completed / total) * 100)) : 0;
---

{variant === 'mask' ? (
  <div class="image-batch-progress gemini-batch-progress" data-role="batch-progress" hidden aria-live="polite">
    <div class="image-batch-progress__topline">
      <strong data-role="progress-label">{label}</strong>
      <span data-role="progress-count">{completed} / {total}</span>
    </div>
    <div class="progress-track" aria-hidden="true"><span data-role="progress-bar" style={`width:${percent}%`}></span></div>
    {cancellable && <button class="gemini-cancel-button" type="button" data-role="cancel" hidden>Cancel batch</button>}
  </div>
) : (
  <section class="image-batch-progress" data-role="batch-progress" hidden={total === 0} aria-live="polite">
    <div class="image-batch-progress__topline">
      <strong data-role="progress-label">{label}</strong>
      <span data-role="progress-count">{completed} / {total}</span>
    </div>
    <progress data-role="progress-bar" max="100" value={percent}>{percent}%</progress>
    {cancellable && <button type="button" data-role="cancel-batch">Cancel</button>}
  </section>
)}

<style>
  .image-batch-progress{display:grid;gap:9px}.image-batch-progress[hidden]{display:none!important}.image-batch-progress__topline{display:flex;justify-content:space-between;gap:12px;align-items:center}.image-batch-progress progress{width:100%;height:10px}.image-batch-progress button{justify-self:start}
</style>
