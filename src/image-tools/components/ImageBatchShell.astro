---
import ImageEditScopeSwitch from './ImageEditScopeSwitch.astro';
import ImageBatchProgress from './ImageBatchProgress.astro';

interface Props {
  mode?: 'shared' | 'individual';
  completed?: number;
  total?: number;
}

const { mode = 'shared', completed = 0, total = 0 } = Astro.props;
---

<section class="image-batch-shell" data-role="image-batch-shell">
  <header class="image-batch-shell__header">
    <slot name="header" />
  </header>

  <div class="image-batch-shell__upload">
    <slot name="upload" />
  </div>

  <ImageEditScopeSwitch mode={mode} />

  <div class="image-batch-shell__workspace">
    <aside class="image-batch-shell__queue">
      <slot name="queue" />
    </aside>
    <main class="image-batch-shell__editor">
      <slot name="workspace" />
    </main>
  </div>

  <div class="image-batch-shell__output">
    <slot name="output" />
  </div>

  <ImageBatchProgress completed={completed} total={total} />

  <footer class="image-batch-shell__actions">
    <slot name="actions" />
  </footer>
</section>

<style>
  .image-batch-shell{display:grid;gap:16px}.image-batch-shell__workspace{display:grid;grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:16px;align-items:start}.image-batch-shell__queue,.image-batch-shell__editor,.image-batch-shell__output{min-width:0}.image-batch-shell__actions{position:sticky;bottom:0;z-index:5}@media(max-width:820px){.image-batch-shell__workspace{grid-template-columns:1fr}.image-batch-shell__actions{bottom:0}}
</style>
