---
import ImageEditScopeSwitch from './ImageEditScopeSwitch.astro';
import ImageBatchProgress from './ImageBatchProgress.astro';

interface Props {
  mode?: 'shared' | 'individual';
  completed?: number;
  total?: number;
  variant?: 'generic' | 'mask' | 'stacked';
}

const { mode = 'shared', completed = 0, total = 0, variant = 'generic' } = Astro.props;
---

<section class:list={[
  'image-batch-shell',
  variant === 'mask' && 'image-batch-shell--mask',
  variant === 'stacked' && 'image-batch-shell--stacked',
]} data-role="image-batch-shell" data-platform-shell="batch-v1">
  <header class="image-batch-shell__header"><slot name="header" /></header>
  <div class="image-batch-shell__upload"><slot name="upload" /></div>
  <div class="image-batch-shell__scope"><slot name="scope"><ImageEditScopeSwitch mode={mode} /></slot></div>
  <div class="image-batch-shell__workspace">
    <aside class="image-batch-shell__queue"><slot name="queue" /></aside>
    <main class="image-batch-shell__editor"><slot name="workspace" /></main>
  </div>
  <div class="image-batch-shell__output"><slot name="output" /></div>
  <div class="image-batch-shell__progress"><slot name="progress"><ImageBatchProgress completed={completed} total={total} /></slot></div>
  <footer class="image-batch-shell__actions"><slot name="actions" /></footer>
</section>

<style>
  .image-batch-shell{display:grid;gap:16px}
  .image-batch-shell__workspace{display:grid;grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:16px;align-items:start}
  .image-batch-shell__queue,.image-batch-shell__editor,.image-batch-shell__output{min-width:0}
  .image-batch-shell__actions{position:sticky;bottom:12px;z-index:20}

  .image-batch-shell--stacked .image-batch-shell__workspace{grid-template-columns:1fr;gap:12px}
  .image-batch-shell--stacked .image-batch-shell__queue{overflow:hidden}

  .image-batch-shell--mask,
  .image-batch-shell--mask>.image-batch-shell__header,
  .image-batch-shell--mask>.image-batch-shell__upload,
  .image-batch-shell--mask>.image-batch-shell__scope,
  .image-batch-shell--mask>.image-batch-shell__workspace,
  .image-batch-shell--mask>.image-batch-shell__workspace>.image-batch-shell__queue,
  .image-batch-shell--mask>.image-batch-shell__workspace>.image-batch-shell__editor,
  .image-batch-shell--mask>.image-batch-shell__output,
  .image-batch-shell--mask>.image-batch-shell__progress,
  .image-batch-shell--mask>.image-batch-shell__actions{display:contents}
  .image-batch-shell--mask>.image-batch-shell__actions{position:static}

  @media(max-width:820px){
    .image-batch-shell__workspace{grid-template-columns:1fr}
    .image-batch-shell__actions{bottom:8px}
  }
</style>
