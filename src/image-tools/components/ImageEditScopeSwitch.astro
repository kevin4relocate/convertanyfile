---
interface Props {
  mode?: 'shared' | 'individual';
  disabled?: boolean;
  variant?: 'generic' | 'standard' | 'mask';
  label?: string;
  title?: string;
  sharedLabel?: string;
  sharedHint?: string;
  individualLabel?: string;
  individualHint?: string;
}

const {
  mode = 'shared',
  disabled = false,
  variant = 'generic',
  label = variant === 'mask' ? 'Mask behavior' : 'Settings behavior',
  title = variant === 'mask' ? 'Recommended automatically, always adjustable' : 'Choose how settings apply',
  sharedLabel = variant === 'mask' ? 'One mask for all' : 'Apply to all',
  sharedHint = variant === 'mask' ? 'Fast batch' : 'One setup for the batch',
  individualLabel = 'Edit individually',
  individualHint = variant === 'mask' ? 'Per-image mask' : 'Per-image overrides',
} = Astro.props;
const guidance = variant === 'mask'
  ? 'The editor chooses a starting mode from the uploaded layouts.'
  : 'Start with one shared setup, then override individual images when needed.';
const rootClass = variant === 'mask'
  ? 'image-edit-scope gemini-edit-mode-bar'
  : variant === 'standard'
    ? 'image-edit-scope image-edit-scope--standard'
    : 'image-edit-scope';
const copyClass = variant === 'mask'
  ? 'gemini-edit-mode-copy'
  : variant === 'standard'
    ? 'image-edit-scope__copy image-edit-scope__copy--standard'
    : 'image-edit-scope__copy';
const optionsClass = variant === 'mask'
  ? 'image-edit-scope__options gemini-edit-mode-options'
  : variant === 'standard'
    ? 'image-edit-scope__options image-edit-scope__options--standard'
    : 'image-edit-scope__options';
---

<div class={rootClass} data-role="edit-scope-switch" data-mode={mode} aria-label={label}>
  <div class={copyClass}>
    <span class="image-edit-scope__label">{label}</span>
    <strong>{title}</strong>
    <small data-role="edit-mode-copy">{guidance}</small>
  </div>
  <div class={optionsClass} role="radiogroup" aria-label={label}>
    <button
      type="button"
      class:list={['image-edit-scope__option', variant === 'mask' && 'gemini-edit-mode', mode === 'shared' && 'is-active']}
      data-edit-scope="shared"
      data-edit-mode="shared"
      role="radio"
      aria-checked={mode === 'shared'}
      aria-pressed={variant === 'mask' ? undefined : mode === 'shared'}
      disabled={disabled}
    >
      <strong>{sharedLabel}</strong>
      <small>{sharedHint}</small>
    </button>
    <button
      type="button"
      class:list={['image-edit-scope__option', variant === 'mask' && 'gemini-edit-mode', mode === 'individual' && 'is-active']}
      data-edit-scope="individual"
      data-edit-mode="individual"
      role="radio"
      aria-checked={mode === 'individual'}
      aria-pressed={variant === 'mask' ? undefined : mode === 'individual'}
      disabled={disabled}
    >
      <strong>{individualLabel}</strong>
      <small>{individualHint}</small>
    </button>
  </div>
</div>

<style>
  .image-edit-scope{display:grid;gap:8px}
  .image-edit-scope__copy{display:grid;gap:2px;min-width:0}
  .image-edit-scope__label{font-size:.8rem;font-weight:700}
  .image-edit-scope__copy>strong{font-size:.9rem}
  .image-edit-scope__copy>small{opacity:.68}
  .image-edit-scope:not(.gemini-edit-mode-bar):not(.image-edit-scope--standard) .image-edit-scope__options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .image-edit-scope:not(.gemini-edit-mode-bar):not(.image-edit-scope--standard) .image-edit-scope__option{min-height:64px;display:grid;align-content:center;gap:3px;text-align:left;padding:10px 14px;border:1px solid var(--border-color,#303744);border-radius:10px;background:transparent;color:inherit;cursor:pointer;line-height:1.2}
  .image-edit-scope:not(.gemini-edit-mode-bar):not(.image-edit-scope--standard) .image-edit-scope__option[aria-checked="true"]{border-color:#8f8aff;background:rgba(124,115,255,.1);box-shadow:inset 0 0 0 1px rgba(124,115,255,.12)}
  .image-edit-scope__options small{opacity:.68}

  /* Standard image tools intentionally mirror the compact Watermark control. */
  .image-edit-scope--standard{grid-template-columns:minmax(220px,1fr) auto;align-items:center;gap:18px;padding:10px 11px;border:1px solid #2b3240;border-radius:13px;background:#10151e}
  .image-edit-scope__copy--standard{gap:2px}
  .image-edit-scope__copy--standard .image-edit-scope__label{color:#8e95a5;font-size:10px;font-weight:700;letter-spacing:.055em;text-transform:uppercase}
  .image-edit-scope__copy--standard>strong{font-size:13px;font-weight:720;line-height:1.25}
  .image-edit-scope__copy--standard>small{color:#939aa9;font-size:10px;line-height:1.4;opacity:1}
  .image-edit-scope__options--standard{width:368px;display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;border:1px solid #303746;border-radius:11px;background:#0d1219}
  .image-edit-scope__options--standard .image-edit-scope__option{min-width:0;min-height:42px;display:grid;align-content:center;gap:1px;padding:6px 12px;border:1px solid transparent;border-radius:8px;background:transparent;color:#9ca3b2;cursor:pointer;font:inherit;text-align:left;line-height:1.2}
  .image-edit-scope__options--standard .image-edit-scope__option strong{font-size:11px;font-weight:710}
  .image-edit-scope__options--standard .image-edit-scope__option small{color:#777f8f;font-size:9px;opacity:1}
  .image-edit-scope__options--standard .image-edit-scope__option:hover:not(:disabled){background:#171d28;color:#eceef4}
  .image-edit-scope__options--standard .image-edit-scope__option[aria-checked="true"]{border-color:#5751a8;background:#24233e;color:#f0efff;box-shadow:0 3px 10px rgba(0,0,0,.16)}
  .image-edit-scope__options--standard .image-edit-scope__option[aria-checked="true"] small{color:#aaa5dd}

  @media(max-width:820px){.image-edit-scope--standard{grid-template-columns:1fr}.image-edit-scope__options--standard{width:100%}}
  @media(max-width:640px){
    .image-edit-scope:not(.gemini-edit-mode-bar):not(.image-edit-scope--standard) .image-edit-scope__options{grid-template-columns:1fr}
    .image-edit-scope__options--standard{grid-template-columns:1fr 1fr}
  }
  @media(max-width:460px){.image-edit-scope__options--standard{grid-template-columns:1fr}}
</style>
