---
interface QueueItem {
  id: string;
  filename: string;
  width?: number;
  height?: number;
  previewUrl?: string;
  status?: 'ready' | 'processing' | 'done' | 'error';
  settingsOrigin?: 'shared' | 'custom';
}

interface Props {
  items?: QueueItem[];
  selectedId?: string;
}

const { items = [], selectedId } = Astro.props;
---

<div class="image-batch-queue" data-role="batch-queue">
  {items.map((item) => (
    <button
      type="button"
      class="image-batch-queue__item"
      data-image-id={item.id}
      aria-pressed={item.id === selectedId}
    >
      <span class="image-batch-queue__thumb" aria-hidden="true">
        {item.previewUrl ? <img src={item.previewUrl} alt="" loading="lazy" /> : <span>IMG</span>}
      </span>
      <span class="image-batch-queue__meta">
        <strong>{item.filename}</strong>
        {(item.width && item.height) ? <small>{item.width} × {item.height}</small> : null}
      </span>
      <span class="image-batch-queue__badges">
        <small data-origin={item.settingsOrigin ?? 'shared'}>{(item.settingsOrigin ?? 'shared').toUpperCase()}</small>
        <small data-status={item.status ?? 'ready'}>{(item.status ?? 'ready').toUpperCase()}</small>
      </span>
    </button>
  ))}
</div>

<style>
  .image-batch-queue{display:grid;gap:8px}.image-batch-queue__item{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:10px;align-items:center;width:100%;padding:8px;border:1px solid var(--border-color,#303744);border-radius:10px;background:transparent;color:inherit;text-align:left;cursor:pointer}.image-batch-queue__item[aria-pressed="true"]{border-color:currentColor}.image-batch-queue__thumb{width:48px;height:48px;border-radius:8px;overflow:hidden;display:grid;place-items:center;background:rgba(127,127,127,.12);font-size:.7rem}.image-batch-queue__thumb img{width:100%;height:100%;object-fit:cover}.image-batch-queue__meta{display:grid;gap:2px;min-width:0}.image-batch-queue__meta strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.image-batch-queue__meta small{opacity:.66}.image-batch-queue__badges{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end}.image-batch-queue__badges small{font-size:.6rem;padding:3px 5px;border:1px solid currentColor;border-radius:999px;opacity:.75}@media(max-width:640px){.image-batch-queue__item{grid-template-columns:42px minmax(0,1fr)}.image-batch-queue__badges{grid-column:2;justify-content:flex-start}}
</style>
