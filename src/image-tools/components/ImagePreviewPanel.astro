---
interface Props {
  beforeUrl?: string;
  afterUrl?: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  beforeUrl,
  afterUrl,
  beforeLabel = 'Original',
  afterLabel = 'Preview',
} = Astro.props;
---

<section class="image-preview-panel" data-role="preview-panel">
  <figure>
    <figcaption>{beforeLabel}</figcaption>
    <div class="image-preview-panel__frame">
      {beforeUrl ? <img src={beforeUrl} alt={beforeLabel} /> : <span>No image selected</span>}
    </div>
  </figure>
  <figure>
    <figcaption>{afterLabel}</figcaption>
    <div class="image-preview-panel__frame">
      {afterUrl ? <img src={afterUrl} alt={afterLabel} /> : <span>Preview will appear here</span>}
    </div>
  </figure>
</section>

<style>
  .image-preview-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.image-preview-panel figure{display:grid;gap:7px;margin:0}.image-preview-panel figcaption{font-size:.75rem;font-weight:700;opacity:.78}.image-preview-panel__frame{min-height:220px;border:1px solid var(--border-color,#303744);border-radius:12px;display:grid;place-items:center;overflow:hidden;background:rgba(127,127,127,.05)}.image-preview-panel__frame img{max-width:100%;max-height:520px;object-fit:contain}.image-preview-panel__frame span{padding:20px;opacity:.5;text-align:center}@media(max-width:720px){.image-preview-panel{grid-template-columns:1fr}}
</style>
