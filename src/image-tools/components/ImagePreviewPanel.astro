---
interface Props {
  beforeUrl?: string;
  afterUrl?: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  beforeUrl,
  afterUrl,
  beforeLabel = 'Original',
  afterLabel = 'Preview',
} = Astro.props;
---

<section class="image-tool-preview-grid image-preview-pair" data-role="preview-panel">
  <article class="image-tool-preview-panel">
    <header>
      <div><span>Before</span><strong>{beforeLabel}</strong></div>
      <small data-role="source-meta"></small>
    </header>
    <div class="image-preview-panel__frame">
      <img data-role="source-preview" src={beforeUrl ?? ''} alt={beforeLabel} hidden={!beforeUrl} />
      <span data-role="source-empty" hidden={Boolean(beforeUrl)}>No image selected</span>
    </div>
  </article>
  <article class="image-tool-preview-panel">
    <header>
      <div><span>After</span><strong>{afterLabel}</strong></div>
      <small data-role="preview-meta"></small>
    </header>
    <div class="image-preview-panel__frame image-preview-panel__frame--result">
      <img data-role="result-preview" src={afterUrl ?? ''} alt={afterLabel} hidden={!afterUrl} />
      <span data-role="result-empty" hidden={Boolean(afterUrl)}>Preview will appear here</span>
    </div>
  </article>
</section>

<style>
  .image-preview-pair{margin-top:0;align-items:stretch}
  .image-preview-pair .image-tool-preview-panel{display:grid;grid-template-rows:auto minmax(0,1fr)}
  .image-preview-panel__frame{position:relative;min-height:260px;display:grid;place-items:center;overflow:hidden;background:repeating-conic-gradient(#11161f 0 25%,#151b25 0 50%) 50%/18px 18px}
  .image-preview-panel__frame img{display:block;max-width:100%;max-height:520px;object-fit:contain}
  .image-preview-panel__frame--result{min-height:0}
  .image-preview-panel__frame--result img{position:absolute;inset:0;width:100%;height:100%;max-width:none;max-height:none;object-fit:contain;object-position:center}
  .image-preview-panel__frame>span{padding:20px;color:#858d9d;font-size:10px;text-align:center}
  @media(max-width:1050px){.image-preview-panel__frame{min-height:220px}}
  @media(max-width:760px){.image-preview-panel__frame{min-height:190px}}
</style>
