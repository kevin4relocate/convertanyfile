{
  "name": "convertanyfile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ConvertAnyFile.net — browser-first private file conversion platform.",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "runtime:archive": "node scripts/sync-libarchive-runtime.mjs",
    "fixtures:archive": "node scripts/sync-archive-test-fixtures.mjs",
    "dev": "npm run runtime:archive && astro dev",
    "check": "astro check",
    "build": "npm run runtime:archive && astro build",
    "preview": "astro preview",
    "test:e2e": "npm run fixtures:archive && playwright test",
    "test:production": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@imagemagick/magick-wasm": "0.0.42",
    "astro": "7.1.6",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3"
  }
}
